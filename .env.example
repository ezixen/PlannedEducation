# PlannedEducation - Environment Configuration Template
# Copy this file to .env and fill in your values
# ===========================================
# REQUIRED - Change these for production
# ===========================================

# Database
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:changeme@postgres:5432/plannededucation

# JWT Secret - Generate with: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production-min-64-chars
RECOVERY_CODE_HASH_SECRET=your-separate-recovery-code-hmac-secret
TOKEN_HASH_SECRET=your-separate-reset-and-session-hmac-secret

# Encryption key for AI API keys (Fernet) — MUST differ from JWT and DB encryption keys
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_KEY_MASTER_SECRET=your-fernet-key-change-in-production-44-chars

# Field-level database encryption (Fernet) for DM/lounge message bodies, TOTP secrets,
# recovery codes, WebAuthn material, OCR text, and notification payloads.
# Generate a SEPARATE key (do not reuse JWT or AI_KEY_MASTER_SECRET):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATABASE_ENCRYPTION=true
DB_ENCRYPTION_MASTER_KEY=your-separate-db-fernet-key-change-in-production

# ===========================================
# OPTIONAL - Customize for your school
# ===========================================

# Environment
PLANNED_EDUCATION_ENV=production
FRONTEND_URL=https://yourschool.edu

# CORS Origins (comma-separated, no trailing slashes)
CORS_ORIGINS=https://yourschool.edu,https://www.yourschool.edu

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=yourschool.edu,www.yourschool.edu

# SEB Configuration
WEBAUTHN_RP_ID=yourschool.edu
WEBAUTHN_ORIGIN=https://yourschool.edu

# Archive Storage
ARCHIVE_STORAGE_ROOT=/var/lib/plannededucation/archive
# AES-GCM master key for sealed exam archives (32+ bytes).
# Generate with: python -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# MUST differ from JWT_SECRET_KEY, AI_KEY_MASTER_SECRET, and DB_ENCRYPTION_MASTER_KEY.
ARCHIVE_MASTER_KEY=your-archive-master-key-change-in-production

# AES-GCM master key for database backup artifacts (.db.gz.enc / .sql.gz.enc).
# Generate with the same command as ARCHIVE_MASTER_KEY.
# MUST be distinct from ARCHIVE_MASTER_KEY, JWT_SECRET_KEY, and other secrets.
# Required in production/staging (fail closed). Dev/test may fall back to
# ARCHIVE_MASTER_KEY or an ephemeral key if unset.
BACKUP_MASTER_KEY=your-backup-master-key-change-in-production
# Optional: absolute root under which backup_location must resolve (default: cwd)
# BACKUP_APPROVED_ROOT=/var/lib/plannededucation

# AI Cost Limits (per teacher per day in USD) — enforced server-side (must match routes_ai default)
MAX_DAILY_COST_USD=5.0

# Redis (required for multi-worker chat when USE_REDIS_CHAT=true)
# REDIS_URL=redis://:changeme@redis:6379/0
# USE_REDIS_CHAT=true
# REDIS_PASSWORD=changeme

# Prometheus metrics (disabled by default; bind loopback when enabled)
# METRICS_ENABLED=false
# METRICS_BIND_ADDR=127.0.0.1
# METRICS_PORT=9090

# ===========================================
# OPTIONAL - Email Delivery (Password Reset & Notifications)
# Zero forced requirement: If omitted, the system defaults to Console/Mock
# logging for 100% offline local-first classroom operation.
# Admins can always reset any user's password directly from the Admin Panel.
# ===========================================
# Option 1: Brevo (Sendinblue) Transactional API (100% free tier: 300 emails/day)
# BREVO_API_KEY=xkeysib-your-brevo-api-key-here
# EMAIL_FROM="PlannedEducation <noreply@yourschool.edu>"

# Option 2: School / Campus SMTP Server (aiosmtplib / smtplib)
# SMTP_HOST=smtp.yourschool.edu
# SMTP_PORT=587
# SMTP_USER=noreply@yourschool.edu
# SMTP_PASSWORD=your-smtp-password
# SMTP_USE_TLS=true
# SMTP_USE_SSL=false
# EMAIL_FROM="PlannedEducation <noreply@yourschool.edu>"

# ===========================================
# OPTIONAL - Database / Monitoring
# ===========================================
POSTGRES_PASSWORD=changeme
# GRAFANA_PASSWORD=changeme
# PROMETHEUS_RETENTION=30d

# ===========================================
# OPTIONAL - SEB Configuration
# ===========================================
# ALLOW_DEV_SEB_BYPASS=true  # Only for development/testing
# ALLOW_DEV_AUTH=true        # Only for development/testing

# ===========================================
# OPTIONAL - Teacher LAN sync (F-048)
# ===========================================
# Comma-separated hostnames allowed for student→teacher-device sealed sync.
# Private/LAN IPs (10/8, 172.16/12, 192.168/16) and localhost are always allowed.
# Public internet hosts are rejected unless listed here.
# TEACHER_SYNC_URL_ALLOWLIST=teacher-sync.school.local,sync.classroom.example.edu
# Portal (Vite) mirror for client-side validation:
# VITE_TEACHER_SYNC_URL_ALLOWLIST=teacher-sync.school.local,sync.classroom.example.edu