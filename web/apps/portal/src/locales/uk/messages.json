  "proctoring.gdpr_desc": "This exam uses optional AI proctoring to ensure academic integrity. Please review and consent to the following data processing activities.",
  "proctoring.activities_title": "Data Processing Activities",
  "proctoring.camera_title": "Camera Access (Face Detection & Eye Tracking)",
  "proctoring.camera_desc": "Uses webcam to detect face presence, track eye movements, and identify if multiple people are in frame. Video is processed locally and only event metadata is sent to the server.",
  "proctoring.mic_title": "Microphone Access (Background Audio Monitoring)",
  "proctoring.mic_desc": "Monitors ambient audio levels to detect unusual sounds or conversations. Audio is analyzed in real-time locally; only anomaly events are recorded.",
  "proctoring.screen_title": "Screen Recording (Tab/Window Monitoring)",
  "proctoring.screen_desc": "Detects tab switches, window blur, and fullscreen exits. No actual screen content is recorded or transmitted.",
  "proctoring.storage_title": "Data Processing & Storage (Required)",
  "proctoring.storage_desc": "Consent to process and store proctoring event data (timestamps, event types, severity levels, face counts, gaze coordinates) for the duration of the exam and 30 days after for review purposes.",
