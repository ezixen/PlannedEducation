{
  "name": "portal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/generate-build-meta.mjs",
    "dev": "vite",
    "build:prepare": "node ./scripts/generate-build-meta.mjs",
    "build": "npm run build:prepare && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:server": "node ./scripts/preview-server.mjs",
    "test:visual": "playwright test",
    "test:visual:clean": "node -e \"import('../../../tests/e2e/playwright/tests/global-teardown.ts').then(m => m.default())\""
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.20.0",
    "idb": "^8.0.4",
    "lucide-react": "^1.60.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.2",
    "license-checker": "^25.0.1",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "description": "PlannedEducation Exam Portal - Free/Open-Source Only. NO PAID SERVICES.",
  "keywords": [
