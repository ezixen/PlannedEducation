{
  "name": "portal",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "predev": "node ./scripts/generate-build-meta.mjs",
    "dev": "vite",
    "build:prepare": "node ./scripts/generate-build-meta.mjs",
    "build": "npm run build:prepare && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:visual": "playwright test",
    "test:visual:clean": "node -e \"import('./tests/visual/global-teardown.ts').then(m => m.default())\""
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "axios": "^1.20.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "license-checker": "^25.0.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "description": "PlannedEducation Exam Portal - Free/Open-Source Only. NO PAID SERVICES.",
