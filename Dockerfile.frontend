# Frontend Dockerfile - Free/Open-Source Only
# Uses Node.js official image (free) and builds the React app

FROM node:24.21.0-alpine3.24@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS builder

# Set work directory
WORKDIR /app

# Replace the bundled npm version with a patched toolchain release.
RUN npm install --global npm@12.2.0

# Copy package files
COPY web/apps/portal/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY web/apps/portal/ .

# Build the application
RUN npm run build

# Production stage - use nginx (free, open-source)
FROM nginx:stable-alpine3.24-slim@sha256:32463212baf0e7d91aded2e9b843a4f2b9e017804b8c9d5bae7b51dcef64389c

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY web/apps/portal/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]