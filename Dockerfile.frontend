# Frontend Dockerfile - Free/Open-Source Only
# Uses Node.js official image (free) and builds the React app

FROM node:20-alpine AS builder

# Set work directory
WORKDIR /app

# Copy package files
COPY web/apps/portal/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY web/apps/portal/ .

# Build the application
RUN npm run build

# Production stage - use nginx (free, open-source)
FROM nginx:alpine

# Copy built assets
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY web/apps/portal/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

# Run nginx
CMD ["nginx", "-g", "daemon off;"]