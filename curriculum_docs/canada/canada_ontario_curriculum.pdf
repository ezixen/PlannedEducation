;Revision history&q;,&q;value&q;:[&q;ele___indigenous_languages___revision_history_1&q;,&q;ele___indigenous_languages___revision_history_2&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum: Native Languages, Grades 1–8, 2001.&l;/em&g;&l;/p&g;&q;}}},&q;ele___indigenous_lang___disclaimer&q;:{&q;system&q;:{&q;id&q;:&q;f2403b77-be77-439d-ae27-dc08e77fda30&q;,&q;name&q;:&q;Ele - Indigenous Lang - Disclaimer&q;,&q;codename&q;:&q;ele___indigenous_lang___disclaimer&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-06-25T15:27:05.3111381Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ce programme-cadre est destiné aux écoles de langue française. Tous les programmes de langues autochtones de la 1&l;sup&g;re&l;/sup&g;&a;nbsp;à la 8&l;sup&g;e&a;nbsp;&l;/sup&g;année se fondent sur les attentes et les contenus d’apprentissage énoncés dans cette édition du programme-cadre.&l;/p&g;\n&l;ul&g;\n  &l;li&g;Depuis 2021-2022, les conseils scolaires peuvent offrir l’inuktitut comme langue d’enseignement dans le cadre des programmes-cadres de langues autochtones de la 1&l;sup&g;re&l;/sup&g;&a;nbsp;à la 12&l;sup&g;e&l;/sup&g;&a;nbsp;année.&a;nbsp;&l;/li&g;\n  &l;li&g;À partir de l’année scolaire 2024-2025, les conseils scolaires peuvent offrir l’algonquin comme langue d’enseignement dans le cadre des programmes-cadres de langues autochtones de la 1&l;sup&g;re&l;/sup&g;&a;nbsp;à la 12&l;sup&g;e&l;/sup&g;&a;nbsp;année.&a;nbsp;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;ele___lang___fra&q;:{&q;system&q;:{&q;id&q;:&q;d9b5fbe0-05da-46d3-8ed5-e50ccf5f1c2f&q;,&q;name&q;:&q;Elementary - Lang - FRA (2023)&q;,&q;codename&q;:&q;ele___lang___fra&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;l1___curriculum&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-03-23T12:27:16.4032565Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;: