&q;name&q;:&q;Video for desktop&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum-V5.mp4&q;,&q;description&q;:null,&q;type&q;:&q;video/mp4&q;,&q;size&q;:1421442,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/67a7e999-d035-4cee-a09b-8f9bce77b5c5/Curriculum-V5.mp4&q;}]},&q;image_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Image description&q;,&q;value&q;:&q;&q;},&q;button_caption&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Primary button caption&q;,&q;value&q;:&q;&q;},&q;button_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Primary button type&q;,&q;value&q;:[]},&q;content_link&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Primary content link&q;,&q;value&q;:[]},&q;external_link_url&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Primary external link URL&q;,&q;value&q;:&q;&q;},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;secondary_button_caption&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Secondary button caption&q;,&q;value&q;:&q;&q;},&q;secondary_button_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Secondary button type&q;,&q;value&q;:[]},&q;secondary_content_link&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Secondary content link&q;,&q;value&q;:[]},&q;secondary_external_link_url&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Secondary external link URL&q;,&q;value&q;:&q;&q;}}},&q;curriculum_review___what_is_curriculum&q;:{&q;system&q;:{&q;id&q;:&q;0753c1f5-8507-4ad7-bb5e-f5c6c31b27a2&q;,&q;name&q;:&q;CRG - What is curriculum&q;,&q;codename&q;:&q;curriculum_review___what_is_curriculum&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-02-02T22:43:29.5616979Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What is curriculum?&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;what-is&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The Ontario curriculum outlines the knowledge and skills students need for success in any pathway they choose. Each grade or course builds on the learning in the previous one and progresses alongside students’ developmental growth.&l;/p&g;\n&l;p&g;The curriculum is developed by educators and informed by research and experts in pedagogy, industry, the labour market and academia, as well as by feedback from stakeholders and partners. This ensures that the curriculum remains current, relevant, developmentally appropriate, and supportive of the strengths, interests and needs of all learners.&l;/p&g;\n&l;p&g;Ontario’s curriculum is composed of four main elements, as follows:&l;/p&g;\n&l;ul&g;\n  &l;li&g;&l;strong&g;Mandatory learning expectations. &l;/strong&g;The&l;strong&g; &l;/strong&g;expectations outline the knowledge and skills students are expected to learn and apply by the end of a grade or course.&l;/li&g;\n  &l;li&g;&l;strong&g;Optional teacher supports.&l;/strong&g; The teacher supports accompany the learning expectations. They may include examples, teacher prompts, and/or other resources that clarify the requirements in the expectations.&l;/li&g;\n  &l;li&g;&l;strong&g;Curriculum context.&l;/strong&g; The curriculum context is specific to each curriculum and indicates policy that supports the teaching of the subjects and disciplines. This section often includes the vision and goals, as well as program planning and assessment and evaluation information for a particular curriculum.&l;/li&g;\n  &l;li&g;&l;strong&g;Program planning and assessment and evaluation information.&l;/strong&g; These general sections provide information on policy governing education in publicly funded schools that applies to the curriculum in all subjects and disciplines from Grades 1 to 12.&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;p&g;In addition to subject- and discipline-focused expectations, the Ontario curriculum includes learning related to &l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/program-planning/transferable-skills\&q;&g;transferable skills&l;/a&g;, &l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/program-planning/cross-curricular-and-integrated-learning/indigenous-education\&q;&g;Indigenous education&l;/a&g;, and the importance of &l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/program-planning/considerations-for-program-planning/human-rights-equity-and-inclusive-education\&q;&g;human rights, equity, and inclusive education.&l;/a&g;&a;nbsp;&l;/p&g;\n&l;p&g;The ministry is committed to fostering an education system where all students, parents, staff and members of the school community feel safe, welcome and respected. It is a system where all students see themselves reflected in what they are learning and are supported and inspired to succeed in a culture of high expectations for learning and in a school environment free of bias, racism and discrimination.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;curriculum_review___what_is_curriculum__copy_&q;:{&q;system&q;:{&q;id&q;:&q;8315bcef-3dfe-424f-b2eb-bbb1fa511511&q;,&q;name&q;:&q;CRG - More Information&q;,&q;codename&q;:&q;curriculum_review___what_is_curriculum__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-01-29T13:35:13.5706688Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;For more information&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;more&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;For more information about curriculum development or curriculum-related resources, please contact the ministry through the &l;a href=\&q;https://www.ontario.ca/feedback/contact-us?id=98698&a;amp;nid=97165\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;ministry’s contact page&l;/a&g;.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;cws___assessment__copy_&q;:{&q;system&q;:{&q;id&q;:&q;23701df5-1c49-4d16-af30-c4de5942bcb8&q;,&q;name&q;:&q;SSH - Assessment&q;,&q;codename&q;:&q;cws___assessment__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___navigation_item&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-05-12T17:43:09.8806688Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Assessment and Evaluation&q;},&q;content_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Content Item&q;,&q;value&q;:[]},&q;child_navigation_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Child Navigation Items&q;,&q;value&q;:[]},&q;include_menu_hierarchy&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Include menu hi