sercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/efa129c1-29b6-4fea-b68a-2ffc4d380cf0/Curriculum_icon_100px_CSIL.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Classical Studies and International Languages&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;csil&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;This curriculum was issued in 2016.&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___cws___&q;,&q;csil___program___overview__copy__c9397f9&q;,&q;res___course_description_and_prerequisite___cws____6892c18&q;,&q;res___course_description_and_prerequisite___append&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_prerequisite___english___&q;:{&q;system&q;:{&q;id&q;:&q;1d3e415e-d026-4878-848a-2af624a6bd45&q;,&q;name&q;:&q;RES - Course description Prerequisite - GCE&q;,&q;codename&q;:&q;res___course_description_prerequisite___english___&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-09-04T14:08:10.2218085Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;curriculum-career (1).svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1865,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/8510d0d4-30bc-4f7c-b549-6377bb939627/curriculum-career%20%281%29.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Guidance and Career Education&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;gce&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;Starting in the 2026–27 school year, students must meet a Financial Literacy Graduation Requirement to earn their high school diploma. More information can be found in section 6.1.4 of&a;nbsp;&l;a href=\&q;https://www.ontario.ca/document/ontario-schools-kindergarten-grade-12-policy-and-program-requirements/diploma-and-certificate-requirements-related-procedures#section-0\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;Ontario Schools, Kindergarten to Grade 12: Policy and Program Requirements&l;/em&g;&l;/a&g;&a;nbsp;and on the&a;nbsp;&l;a href=\&q;https://www.ontario.ca/page/financial-literacy-education-schools\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;financial literacy education in schools&l;/a&g;&a;nbsp;page on Ontario.ca.​&l;/li&g;\n  &l;li&g;As announced in May 2023, mandatory learning on mental health literacy for students has been added to the Grade 10 Career Studies course for implementation in Fall 2024. The course title (Career Studies, Grade 10), code (GLC2O), and description remain the same.&l;/li&g;\n  &l;li&g;Starting in the 2024–25 school year, the Grade&a;nbsp;10 Career Studies course (GLC2O) implemented in all Ontario secondary schools is based on the revised expectations. The revised course supersedes the course outlined in&a;nbsp;&l;em&g;The Ontario Curriculum, Grade 10: Career Studies, 2019&l;/em&g;. Educators should be aware that, with the exception of this course, the 2006 Guidance and Career Education documents for Grades&a;nbsp;9 and 10, and Grades 11 and 12 will remain in effect.&a;nbsp;&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___englis&q;,&q;res___course_description_and_prerequisite___englis_6d4e2f1&q;,&q;res___course_description_and_prerequisite___englis_2ac4a77&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},