ctional_activities_for_treaties_recognition_&q;]},&q;colour&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Colour&q;,&q;value&q;:[{&q;name&q;:&q;Canadian and World Studies&q;,&q;codename&q;:&q;canadian_and_world_studies&q;}]},&q;icon&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Icon&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum_CWS2.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:2294,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/520313ac-9b06-4bb1-83f4-cba1957b1ae2/Curriculum_CWS2.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;cgc1w___strands___oe_se_pdf&q;,&q;snc1w___course_curriculum_pdf__copy_&q;,&q;cws___g9_10_curriculum_pdf__copy__ebc7726&q;,&q;cws___g9_10_curriculum_pdf&q;,&q;cws___g9_10_curriculum_pdf__copy_&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2026&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ce programme-cadre est destiné aux écoles de langue française; il remplace les attentes et contenus d’apprentissage présentés dans &l;em&g;Le curriculum de l’Ontario,&a;nbsp;9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&a;nbsp;&l;em&g;année&a;nbsp;– Études canadiennes et mondiales&a;nbsp;&l;/em&g;(2018). Tous les programmes en études canadiennes et mondiales de 9&l;sup&g;e&l;/sup&g; et 10&l;sup&g;e&l;/sup&g; année seront fondés sur les attentes et les contenus d’apprentissage présentés dans le cours de géographie de 9&l;sup&g;e&l;/sup&g; année (2024) et les cours révisés de 10&l;sup&g;e&l;/sup&g; année de civisme et citoyenneté (2022) et d’histoire (à compter de l’année scolaire 2026-2027). Cependant, la mise en contexte de 2018 reste en vigueur. Les attentes et les contenus d’apprentissage de la 11&l;sup&g;e&l;/sup&g; et 12&l;sup&g;e&l;/sup&g; année continuent d’être fondés sur &l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année – Études canadiennes et mondiales&l;/em&g; (2015), mais les références aux cours de 9&l;sup&g;e&l;/sup&g; et 10&l;sup&g;e&l;/sup&g; année ont été mises à jour.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___cws___revision_history_1&q;,&q;sec___cws___revision_history_2&q;,&q;sec___cws___revision_history_1__copy_&q;,&q;sec___cws___revision_history_4__copy_&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum, Grade 9 to 12: Canadian and World Studies&l;/em&g;&l;/p&g;&q;}}},&q;sec___classical_studies_and_international_language&q;:{&q;system&q;:{&q;id&q;:&q;158ca896-832e-4e8d-be75-173f67105b8f&q;,&q;name&q;:&q;Sec - Classical Studies and International Languages&q;,&q;codename&q;:&q;sec___classical_studies_and_international_language&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;l1___curriculum&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;las