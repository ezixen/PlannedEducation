igation Items&q;,&q;value&q;:[]},&q;include_menu_hierarchy&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Include menu hierarchy&q;,&q;value&q;:[]},&q;internal_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Internal link&q;,&q;value&q;:&q;/grade-9-math-guide&q;},&q;external_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External link&q;,&q;value&q;:&q;&q;},&q;asset&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Asset&q;,&q;value&q;:[]},&q;fragment&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Fragment&q;,&q;value&q;:&q;&q;},&q;is_quick_links&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Is quick links&q;,&q;value&q;:[]},&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;digital-technology-and-innovations-in-the-changing-world-a-guide-for-parents&q;},&q;external_link_href&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External Link Href&q;,&q;value&q;:&q;&q;},&q;target&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Target&q;,&q;value&q;:[]},&q;redirect_to_url&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Redirect To URL&q;,&q;value&q;:[]},&q;mega_menu_flag&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Flag&q;,&q;value&q;:[]},&q;megamenu_pane_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Layout&q;,&q;value&q;:[]},&q;left_sub_menu_button&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Left Sub Menu Button&q;,&q;value&q;:[]},&q;curriculum_layout_linked_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum Layout Linked Item&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___about__copy_&q;:{&q;system&q;:{&q;id&q;:&q;f8e16399-3613-49e9-a94c-65a0468efc88&q;,&q;name&q;:&q;SNC1W - Parent Guide - What students will learn&q;,&q;codename&q;:&q;snc1w___parent_guide___about__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T15:40:09.0544379Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What students will learn&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The new Grade 9 science course builds on the learning in the elementary science and technology program. The Grade 9 course provides students with a foundation for learning the concepts and skills needed to prepare them for the future. Here are the areas of focus:&l;/p&g;\n&l;h4&g;&l;strong&g;STEM skills, careers, and connections&l;/strong&g;&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;engage in an experiential approach to learning science concepts&l;/li&g;\n  &l;li&g;enhance their learning and skills throughout the course in the areas of biology, chemistry, physics, and Earth and space science&l;/li&g;\n  &l;li&g;investigate practical applications and various careers, including those in the skilled trades, enabling students to make connections between science and everyday life&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Biology&l;/strong&g;&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;learn about the environment through the concept of sustainable ecosystems and the interconnectedness of various ecological factors and processes, such as biodiversity, air and water quality and soil health&l;/li&g;\n  &l;li&g;recognize how human activities, including those that contribute to climate change, impact the environment, and explore ways to restore the balance in ecosystems&l;/li&g;\n  &l;li&g;investigate natural processes, such as the flow of energy and the cycling of matter, and their importance in maintaining balanced ecosystems&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Chemistry&l;/strong&g;&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;learn about the importance of chemistry in their daily lives, including the use and safe disposal of elements and compounds found in familiar products such as smartphones&a;nbsp;&l;/li&g;\n  &l;li&g;examine the impacts of chemical processes and technologies on society and the environment&l;/li&g;\n  &l;li&g;increase their understanding of the nature of matter, the structure of atoms and properties of elements and compounds, by exploring the periodic table of elements and through hands-on investigations&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Physics&l;/strong&g;&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;understand the impacts of electrical energy production and consumption on society and the environment, and explore initiatives to achieve sustainable practices&l;/li&g;\n  &l;li&g;learn about the nature of electric charges, including their behaviour in static electricity and electric current, through investigations (for example, building a circuit)&l;/li&g;\n  &l;li&g;examine the relationships between various characteristics of electricity&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Earth and space science&l;/strong&g;&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;expand their knowledge of the impacts of space exploration on society and the environment&l;/li&g;\n  &l;li&g;learn about the importance and effect of technological innovations derived from space exploration&l;/li&g;\n  &l;li&g;continue learning about the components of the solar system and the universe&l;/li&g;\n  &l;li&g;develop a better understanding of the Sun and its relationship to processes on Earth&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___about__copy__0ec9188&q;:{&q;system&q;:{&q;id&q;:&q;0ec91880-6c4f-49e0-8d5c-27f0e24762f5&q;,&q;name&q;:&q;ENL1W - FRL1W - Parent Guide - About&q;,&q;codename&q;:&q;snc1w___parent_guide___about__copy__0ec9188&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-20T17:37:46.956313Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;About the new Grade 9 English course &q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;about&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The new &l;a href=\&q;/en/curriculum/secondary-english/courses/enl1w\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Grade 9 English course&l;/a&g; builds on the new elementary language curriculum for Grades 1 to 8 and aims to equip students with the knowledge and skills that are essential for them to become confident communicators. It is designed to help students further develop oral communication, reading, writing and digital media literacy skills to allow students to reach their full potential.&l;/p&g;\n&l;p&g;The Grade 9 English course includes the following areas of new learning:&l;/p&g;\n&l;p&g;&l;strong&g;Foundational knowledge and skills&l;/strong&g;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;The course emphasizes the importance of understanding the foundations of language for clear and coherent communication, and the use of critical thinking skills to allow students to experience a deep understanding of the texts they view and create.&l;/li&g;\n&l;/ul&g;\n&l;p&g;&l;strong&g;Transferable skills&l;/strong&g;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;Students apply the seven transferable skills throughout their language and literacy learning across all grades to help them become engaged and responsible learners. These skills are defined as: critical thinking and problem solving; innovation, creativity and entrepreneurship; self-directed learning; collaboration; communication; global citizenship and sustainability; and digital literacy.&l;/li&g;\n&l;/ul&g;\n&l;p&g;&l;strong&g;Digital media literacy&l;/strong&g;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;Students develop and apply digital media literacy knowledge and skills to support their learning, such as understanding how online media is used to communicate and influence audiences. They learn to navigate online environments, with appropriate permission, while managing their data, security and privacy.&l;/li&g;\n&l;/ul&g;\n&l;p&g;&l;strong&g;Applications, connections and contributions&a;nbsp;&l;/strong&g;&l;/p&g;\n&l;ul&g;\n  &l;li&g;Students apply language and literacy skills in various contexts, and make connections to the contributions of a diversity of voices, experiences and perspectives, including those of First Nations, Métis and Inuit individuals, communities and groups.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___about__copy__6cc8d85&q;:{&q;system&q;:{&q;id&q;:&q;6cc8d85f-92df-456b-add6-eb5c69bd1f1d&q;,&q;name&q;:&q;SSHG - Parent Guide - What is new - Nouveautés&q;,&q;codename&q;:&q;snc1w___parent_guide___about__copy__6cc8d85&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-18T16:07:19.9852659Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What is new in the curriculum&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;about&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The curriculum has been updated with new learning.&a;nbsp;&l;/p&g;\n&l;h4&g;Learning on Black history in Canada&l;/h4&g;\n&l;p&g;The updated Grades 7 and 8 history curriculum includes learning about the impact on and lasting contributions of Black individuals and communities in Canada between 1713 and 1914.&l;/p&g;\n&l;p&g;Starting in 2026, students will learn about the:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Black communities that contributed to the development of Canada, including pre- and post-Confederation&l;/li&g;\n  &l;li&g;achievements of various Black individuals and communities in Canada&l;/li&g;\n  &l;li&g;impacts of enslavement&l;/li&g;\n  &l;li&g;contributions of diverse Black individuals to Canada’s foundation as a young nation, and the obstacles they faced, in the pursuit of building an inclusive and prosperous country.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Indigenous learning&l;/h4&g;\n&l;p&g;In 2023, the Grades 1 to 3 social studies curriculum was revised to strengthen learning on residential schools and foster greater understanding of the contributions of First Nations, Métis and Inuit individuals, communities and nations to our province and country while learning about their histories and cultures. Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;learn about traditional Indigenous and treaty territories&l;/li&g;\n  &l;li&g;develop an understanding of the ways of life in First Nations, Métis and Inuit communities between 1780 and 1850 and the impact of colonial policies and treaties&l;/li&g;\n  &l;li&g;explore the interrelationship between contemporary First Nations, Métis and Inuit communities and the land, including land use, employment and the natural environment&l;/li&g;\n  &l;li&g;learn about the impact of colonization, including the residential school system, and the reclamation and revitalization of identity, language, culture and community connections.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Holocaust learning&l;/strong&g;&l;/h4&g;\n&l;p&g;In 2023, the Grade 6 social studies curriculum was updated to include learning about the Holocaust, to help younger students gain a deeper understanding of its significance and combat rising cases of antisemitism in schools. Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;develop a deeper understanding of the significance of the Holocaust starting in Grade 6&l;/li&g;\n  &l;li&g;learn about the experiences of Jewish individuals, families and communities within Canada and the ongoing impact of antisemitism&l;/li&g;\n  &l;li&g;learn about the responses of the Canadian government to the Holocaust and the development of Canada’s responses to acts of hate and human rights violations after World War II.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___about__copy__c078629&q;:{&q;system&q;:{&q;id&q;:&q;c0786293-8bec-4cb5-8e1e-6b6dea416ada&q;,&q;name&q;:&q;ICD2O - Parent Guide - About&q;,&q;codename&q;:&q;snc1w___parent_guide___about__copy__c078629&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-08-20T18:36:14.9162374Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;About the computer studies course&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;about&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The &l;a href=\&q;/en/curriculum/computer-studies/courses/icd2o\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Digital Technology and Innovations in the Changing World course (ICD2O),&l;/a&g; 2023, replaces the previous Introduction to Computer Studies (ICS2O) course from 2008. It is designed to provide students with opportunities to appreciate, explore and discover the power of digital technology and computer programming. Students live in a world where digital technologies inform us, connect us, entertain us and protect us. These technologies have become powerful aspects in our lives. As such, it is important for students to appreciate their potential benefits and also to think critically about their drawbacks, such as excessive or problematic use. &a;nbsp;&l;/p&g;\n&l;p&g;Students will examine important social, cultural, economic, environmental and ethical issues related to digital technology and computer programming.&l;/p&g;\n&l;p&g;This is an optional Grade 10 full-credit course. It counts towards the credits that students need to earn to graduate from high school, and will fulfil the compulsory&a;nbsp;STEM-related course group requirement for the Ontario Secondary School Diploma. This course will be taught in classrooms starting September 2023.&a;nbsp;&l;/p&g;\n&l;p&g;This course is organized into three broad areas of learning:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Computational thinking and making connections&l;/li&g;\n  &l;li&g;Hardware, software, and innovations&l;/li&g;\n  &l;li&g;Programming&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___benefits__copy_&q;:{&q;system&q;:{&q;id&q;:&q;4ed3b687-04b9-4d53-abe4-31dad30dae40&q;,&q;name&q;:&q;SNC1W - Parent Guide - About&q;,&q;codename&q;:&q;snc1w___parent_guide___benefits__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T15:41:14.5401528Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;About the new science course&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;about&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The new Grade 9 science course now includes&l;em&g;:&l;/em&g;&l;/p&g;\n&l;h4&g;&l;strong&g;STEM skills, careers, and connections&l;/strong&g;&l;/h4&g;\n&l;ul&g;\n  &l;li&g;Supports learning using scientific research and experimentation, engineering design processes and coding skills related to the concepts and skills in other areas of the course.&l;/li&g;\n  &l;li&g;Provides practical applications of science, including connections to STEM-related occupations and skilled trades.&l;/li&g;\n  &l;li&g;Promotes understanding of the contributions to science from diverse communities.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Coding and emerging technologies&l;/strong&g;&l;/h4&g;\n&l;ul&g;\n  &l;li&g;Builds on learning of coding skills from elementary science and technology.&l;/li&g;\n  &l;li&g;Incorporates coding skills to model scientific concepts and relationships, such as creating a virtual simulation to model interactions in an ecosystem.&l;/li&g;\n  &l;li&g;Increases learning about emerging technologies and their impacts on society and the environment.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Climate change&l;/strong&g;&l;/h4&g;\n&l;ul&g;\n  &l;li&g;Contains explicit connections to climate change and its impacts.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___how_we_developed_the_new_co&q;:{&q;system&q;:{&q;id&q;:&q;27e02022-4113-4dbc-b513-f7bbcb1af591&q;,&q;name&q;:&q;SNC1W - Parent Guide - Related/Resources&q;,&q;codename&q;:&q;snc1w___parent_guide___how_we_developed_the_new_co&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T18:06:40.8391279Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Related/Resources&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;related&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;&l;a href=\&q;/en/curriculum/secondary-science/courses/snc1w\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Grade 9 Science Course, 2022&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;/en/science-tech-overview\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Parent Guide to the Elementary Science and Technology Curriculum, 2022&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;/en/curriculum/science-technology\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Elementary Science and Technology Curriculum, 2022&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___moving_to_one_science_cours&q;:{&q;system&q;:{&q;id&q;:&q;d7c79a44-8831-415e-9008-fad08b140419&q;,&q;name&q;:&q;SNC1W - Parent Guide - Benefits&q;,&q;codename&q;:&q;snc1w___parent_guide___moving_to_one_science_cours&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T15:37:44.2975622Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Benefits for all students&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;benefits&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;There is strong evidence that points to the benefits of Grade 8 students not having to choose between applied and academic courses when they enter Grade 9.&l;/p&g;\n&l;p&g;The key benefits include:&l;/p&g;\n&l;ul&g;\n  &l;li&g;high academic standards are set for all students&l;/li&g;\n  &l;li&g;students with a range of skills and interests learn together&l;/li&g;\n  &l;li&g;more opportunities are created and fewer systemic barriers exist for Indigenous, Black and other racialized students, students who live in low-income households, and students with disabilities and special education needs&l;/li&g;\n  &l;li&g;students are equipped with the knowledge and skills they need to prepare for more advanced courses in secondary school&l;/li&g;\n  &l;li&g;future options are open for all students, for example, going to college, to university or to an apprenticeship&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___moving_to_one_science_cours_5b0e1c7&q;:{&q;system&q;:{&q;id&q;:&q;5b0e1c7e-5e1b-4a31-8df0-e556efe98c88&q;,&q;name&q;:&q;SSHG - Parent Guide - Introduction&q;,&q;codename&q;:&q;snc1w___parent_guide___moving_to_one_science_cours_5b0e1c7&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-18T21:38:57.8854601Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;introduction&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;We have updated the social studies, history and geography curriculum for Grades 1 to 8 to include new mandatory learning in Grades 7 and 8 history. Teachers will start teaching the revised curriculum starting in the 2026–2027 school year.&l;/p&g;\n&l;p&g;The curriculum connects to learning in the secondary Canadian and world studies curriculum for Grades 9 to 12. Throughout their learning in social studies, history and geography, students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;become responsible, active citizens within the diverse communities to which they belong&l;/li&g;\n  &l;li&g;become critically thoughtful and informed citizens who value an inclusive society&l;/li&g;\n  &l;li&g;develop the skills they need to solve problems and communicate ideas and decisions about significant developments, events and issues.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___related_resources__copy__1c81641&q;:{&q;system&q;:{&q;id&q;:&q;1c816414-7dca-4d65-8772-9b0eb1105148&q;,&q;name&q;:&q;SSHG - Parent Guide - More information&q;,&q;codename&q;:&q;snc1w___parent_guide___related_resources__copy__1c81641&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-07-05T12:15:19.9178599Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;More information&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;more-information&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;&l;a href=\&q;/en/curriculum/elementary-sshg/\&q;&g;Social Studies, History and Geography curriculum&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___related_resources__copy__6113fdb&q;:{&q;system&q;:{&q;id&q;:&q;6113fdbe-5afd-49dd-8d27-0cfccefe17f8&q;,&q;name&q;:&q;ICD2O - Parent Guide - Related/Resources&q;,&q;codename&q;:&q;snc1w___parent_guide___related_resources__copy__6113fdb&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-12T14:42:20.9728499Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Related resources&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;related&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;&l;a href=\&q;/en/curriculum/computer-studies/courses/icd2o\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Grade 10 Course: Digital Technology and Innovations in the Changing World 2023&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://www.ontario.ca/page/high-school-graduation-requirements?_ga=2.244748294.2098729747.1638799825-2041196396.1638799825\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;High school graduation requirements | Ontario.ca&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/program-planning/transferable-skills\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Transferable skills&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___support_your_child_s_learni&q;:{&q;system&q;:{&q;id&q;:&q;28258c5a-af65-40a3-9c9a-6e86d5039880&q;,&q;name&q;:&q;SNC1W - Parent Guide - How we developed the new course&q;,&q;codename&q;:&q;snc1w___parent_guide___support_your_child_s_learni&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T15:43:08.3472937Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;How we developed the new course&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;how-developed&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;To develop the new Grade 9 science course, Ontario reviewed current research and best practices from leading jurisdictions.&a;nbsp;&a;nbsp;&l;/p&g;\n&l;p&g;The course was also informed by feedback from education stakeholders and partners, including postsecondary institutions and industry partners.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___support_your_child_s_learni_7386faa&q;:{&q;system&q;:{&q;id&q;:&q;7386faa5-df76-4983-880f-7d4994f450e2&q;,&q;name&q;:&q;SSHG - Parent Guide - Support your child’s learning&q;,&q;codename&q;:&q;snc1w___parent_guide___support_your_child_s_learni_7386faa&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-18T16:09:27.8787296Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Support your child&s;s learning&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;support-child&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Here are some ideas for how to support your child’s learning:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Your family story, heritage and history are an important part of their identity. Discuss your family traditions and celebrations, and how these may differ from other families in your community.&l;/li&g;\n  &l;li&g;Explore the natural and developed features of your community (e.g., streams, farms, parks, homes, highways), and their value/impact on the community.&a;nbsp;&l;/li&g;\n  &l;li&g;If you are travelling as a family, discuss the natural and built features of the places you visit. Encourage curiosity about the communities you visit and what makes these places good travel destinations.&l;/li&g;\n  &l;li&g;Find practical uses for what your child is learning about, such as maps, globes, graphs and graphic organizers.&l;/li&g;\n  &l;li&g;Discuss historical and current events, such as issues and developments happening both in your community and globally. Encourage discussion of different opinions and perspectives.&l;/li&g;\n  &l;li&g;Together with your child, explore the perspectives of different groups and communities, including First Nations, Métis and Inuit communities, on some significant events, developments and issues in Canada.&a;nbsp;&l;/li&g;\n  &l;li&g;You are your child’s role model, so share your curiosity and learning with your child, and talk about what you are doing at home, at work and in the community and your intended impact on those around you.&l;/li&g;\n  &l;li&g;Stay informed about your child’s learning by staying in touch with their school and teachers. Ask your child’s teacher about what is being taught in class and skills and experiences that will support your child’s learning.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___support_your_child_s_learni_94a8124&q;:{&q;system&q;:{&q;id&q;:&q;94a8124c-88cf-4782-8427-c465ad2aff57&q;,&q;name&q;:&q;ICD2O - Parent Guide - Support your child’s learning&q;,&q;codename&q;:&q;snc1w___parent_guide___support_your_child_s_learni_94a8124&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-09T17:47:39.026062Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Supporting your child’s learning&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;support-child&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Parents and family can have a huge influence on a child’s educational success and future career choices. By showing an interest in what your child is learning and helping them make connections to everyday events at home, in the community and beyond, you can make an important contribution to their success. Here are some ideas for how to support your child’s learning in this course:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Encourage your child to share what they are learning in class, including the benefits and limitations of the technologies they are exploring.&l;/li&g;\n  &l;li&g;Challenge your child to use what they are learning in practical application. For example, they can apply their programming skills to develop a simple software application that will benefit their family or community.&l;/li&g;\n  &l;li&g;Encourage your child to review their own use of social media applications considering how they can apply safe and effective data privacy and cybersecurity practices. Ask for their help to review your applications as well.&l;/li&g;\n  &l;li&g;Discuss current events, issues and developments involving emerging technologies, such as cybersecurity and artificial intelligence.&l;/li&g;\n  &l;li&g;Explore industries that use digital technologies. Talk about how you use digital technologies in your industry and discuss the benefits and limitations from your perspective.&l;/li&g;\n  &l;li&g;Stay informed about your child’s learning. If you have questions, contact your child’s teacher or school.&l;/li&g;\n  &l;li&g;To learn more, connect with your child’s teacher, guidance counsellor or other school staff, who can provide information that will help support your child’s learning, future aspirations and course choices.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___what_students_will_learn__c&q;:{&q;system&q;:{&q;id&q;:&q;38d59864-47f8-4d29-abac-5a61eb3d93eb&q;,&q;name&q;:&q;SNC1W - Parent Guide - Support your child’s learning&q;,&q;codename&q;:&q;snc1w___parent_guide___what_students_will_learn__c&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T15:42:08.5142567Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Support your child’s learning&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;support-child&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;As parents and family, you can have a huge influence on your child’s educational success and future career choices. By showing an interest in what your child is learning, you can make an important contribution to their success in science.&l;/p&g;\n&l;p&g;Science helps children learn about how our world works and can be found all around us – from climate change to technology and space science. You can help your child make connections between what they learn in school and everyday experiences at home and in the community. Here are some ways to spark your child’s curiosity about the wonders of science and support their learning:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Discuss science news items and what is happening in your community.&l;/li&g;\n  &l;li&g;Discuss the importance of thinking critically about how science is presented in social media. &a;nbsp;&l;/li&g;\n  &l;li&g;Look for examples of the wonders of science, such as how science-based technology and tools make our lives easier and encourage us to become responsible global citizens.&l;/li&g;\n  &l;li&g;Talk with your child about their strengths and interests and help them look ahead and set education and career goals.&l;/li&g;\n  &l;li&g;Help your child make connections between what they learn in school, their interests or passions, and the courses they choose to take.&l;/li&g;\n  &l;li&g;Discuss how science makes a difference in your own work and in your everyday life.&l;/li&g;\n  &l;li&g;Talk with your child about career opportunities that rely on science skills and point to role models.&l;/li&g;\n  &l;li&g;Ask your child’s teacher, guidance counsellor or other school staff questions about skills and experiences required to support your child’s learning and course choices.&l;/li&g;\n  &l;li&g;Stay informed about your child’s learning and stay in touch with their school and teachers.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide___what_students_will_learn__c_02ac043&q;:{&q;system&q;:{&q;id&q;:&q;02ac043e-ac4c-4bae-a090-efa8d562968c&q;,&q;name&q;:&q;ICD2O - Parent Guide - What students will learn&q;,&q;codename&q;:&q;snc1w___parent_guide___what_students_will_learn__c_02ac043&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-12T20:11:59.3254988Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What students will learn&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;h4&g;Computational thinking and making connections&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;develop and apply the skills required to plan and design computer programs&l;/li&g;\n  &l;li&g;analyze important issues related to the design and use of digital technologies&l;/li&g;\n  &l;li&g;research contributions to innovations in digital technologies made by members of diverse local, Canadian and global communities&l;/li&g;\n  &l;li&g;identify connections between digital technologies and different industries and occupations&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Hardware, software, and innovations&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;describe the functions and features of hardware, software and connected devices&l;/li&g;\n  &l;li&g;use hardware and software in a variety of ways and make recommendations for devices and programs to others&l;/li&g;\n  &l;li&g;develop knowledge of safe and effective data and cybersecurity practices&l;/li&g;\n  &l;li&g;investigate the benefits and limitations of automation, artificial intelligence and other emerging technologies&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Programming&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;explain fundamental programming concepts and algorithms&l;/li&g;\n  &l;li&g;learn programming skills and apply them to build and create interactive programs based on their interests&l;/li&g;\n  &l;li&g;analyze existing programs to understand their design and purpose&l;/li&g;\n  &l;li&g;write and rewrite parts of a program to complete different tasks&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;snc1w___parent_guide__ui_view___copy_&q;:{&q;system&q;:{&q;id&q;:&q;96fe89ad-94a4-4c7a-a7a6-77b4fdd4fbb9&q;,&q;name&q;:&q;ICD2O - Parent Guide (UI-View)&q;,&q;codename&q;:&q;snc1w___parent_guide__ui_view___copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-04-09T12:12:16.0469876Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Digital Technology and Innovations in the Changing World: a guide for parents&q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;icd2o-guide&q;},&q;column_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Column layout&q;,&q;value&q;:[{&q;name&q;:&q;one-column&q;,&q;codename&q;:&q;one_column&q;}]},&q;subitems&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Main&q;,&q;value&q;:[&q;snc1w___parents_guides_banner__copy__741e8ce&q;,&q;snc1w___parent_guide___about__copy__c0