inks&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;With the exception of the &l;strong&g;Grade 10 Career Studies course,&a;nbsp;2024 (GLC2O)&l;/strong&g;, the 2006 Guidance and Career Education documents for Grades 9–10 and Grades 11–12 remain in effect. All other courses will continue to be based on the curriculum expectations outlined in those documents.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[{&q;name&q;:&q;Disclaimer&q;,&q;codename&q;:&q;disclaimer&q;}]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;glc2o___key_changes_ui_view&q;:{&q;system&q;:{&q;id&q;:&q;70ef997e-804f-4ca3-b471-39540d106a49&q;,&q;name&q;:&q;GLC2O - Key Changes UI-View&q;,&q;codename&q;:&q;glc2o___key_changes_ui_view&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-05-02T13:08:11.9553954Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Key Changes – Grade 10 Career Studies (GLC2O)&q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;key-changes-glc2o&q;},&q;column_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Column layout&q;,&q;value&q;:[{&q;name&q;:&q;one-column&q;,&q;codename&q;:&q;one_column&q;}]},&q;subitems&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Main&q;,&q;value&q;:[&q;sshg___grade_6___key_changes___banner__copy__45f471c&q;,&q;sshg___grade_6___key_changes___strand_a__copy__9e0207a&q;]},&q;subitems_left&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Subitems left&q;,&q;value&q;:[]},&q;subitems_right&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Subpages&q;,&q;value&q;:[]},&q;right_side_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Right side items&q;,&q;value&q;:[]},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;changes,career,guidance,mental health&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;changes,career,guidance,mental health&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;settings&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Features&q;,&q;value&q;:[{&q;name&q;:&q;Show Yes/No Rating&q;,&q;codename&q;:&q;show_yes_no_rating&q;}]},&q;revision_history_page&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision History Page&q;,&q;value&q;:[]},&q;content_download&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Content Download&q;,&q;value&q;:[]},&q;thumbnail&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Thumbnail&q;,&q;value&q;:[{&q;name&q;:&q;Careers and guidance Key Changes.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:11423,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/3b47a24e-d982-4539-9b7b-f3b3fec857dc/Careers%20and%20guidance%20Key%20Changes.svg&q;}]},&q;system___site___resource_category&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;System - Site – Resource Category&q;,&q;taxonomy_group&q;:&q;site___resource_category&q;,&q;value&q;:[]},&q;rp___resource___subject&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Subject&q;,&q;taxonomy_group&q;:&q;rp___resource___subject&q;,&q;value&q;:[{&q;name&q;:&q;Guidance and Career Education&q;,&q;codename&q;:&q;guidance_and_career_education&q;}]},&q;rp___resource___topic&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Topic&q;,&q;taxonomy_group&q;:&q;rp___resource___topic&q;,&q;value&q;:[]},&q;site___grade&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Grade&q;,&q;taxonomy_group&q;:&q;site___grade&q;,&q;value&q;:[]},&q;rp___developed_by&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Developed By&q;,&q;taxonomy_group&q;:&q;rp___developed_by&q;,&q;value&q;:[{&q;name&q;:&q;Ministry of Education&q;,&q;codename&q;:&q;ministry_of_education&q;}]},&q;rp___audience&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Audience&q;,&q;taxonomy_group&q;:&q;rp___audience&q;,&q;value&q;:[{&q;name&q;:&q;Teachers&q;,&q;codename&q;:&q;teachers&q;}]}}},&q;glc2o___parent_guide___introduction__copy_&q;:{&q;system&q;:{&q;id&q;:&q;ca62c5e8-ac99-4587-a0d0-4f997d7e8a3b&q;,&q;name&q;:&q;GLC2O - Parent Guide - What Students Will Learn&q;,&q;codename&q;:&q;glc2o___parent_guide___introduction__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-01-31T12:08:50.2653245Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What students will learn in Career Studies&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;untitled_content_item_14d02b1&q;],&q;value&q;:&q;&l;p&g;&l;strong&g;Developing the Skills, Strategies, and Habits Needed to Succeed –&l;/strong&g; students will learn about adapting to change; overcoming challenges; and navigating a healthy work-life balance. Recognizing signs that may indicate stress is becoming problematic, identifying mental health resources at school and in the community, and how to access support when there is a mental health concern is also addressed. Students will learn about how their decisions, including how to use social media, can influence future opportunities. They will also learn how to set short-term and long-term goals and revise these goals as needed.&l;/p&g;\n&l;p&g;&l;strong&g;Exploring and Preparing for the World of Work –&l;/strong&g; students will learn about employment opportunities of the future: investigate high-growth industries in their region and the province including opportunities related to science, technology, engineering and math (STEM) careers. They will also learn about making connections between the skills learned in school and those used in the real world, such as communication skills, collaboration and critical thinking in the workplace.&a;nbsp;&l;/p&g;\n&l;p&g;&l;strong&g;Planning and Financial Management to Help Meet Postsecondary Goals –&l;/strong&g; students will create different résumé types for the jobs and careers of the future, as well as learn the importance of financial management, including budgeting, paying bills on time, the value of using credit responsibly, and options to pay for postsecondary education.&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;untitled_content_item_14d02b1\&q;&g;&l;/object&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;glc2o___parent_guide___what_students_will_learn__c&q;:{&q;system&q;:{&q;id&q;:&q;a1734b24-63b1-4eec-b7b4-67154832bd5c&q;,&q;name&q;:&q;GLC2O - Parent Guide - Parent Support&q;,&q;codename&q;:&q;glc2o___parent_guide___what_students_will_learn__c&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-01-31T12:09:32.6503387Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;How can parents support their child?&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;parent-support&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;Encourage your child to develop life skills, such as time management and taking responsibility, as well as learning lessons from perceived setbacks, developing coping skills and having a good work ethic.&a;nbsp;&l;/li&g;\n  &l;li&g;Act as a role model and support routines for mental health such as getting adequate sleep, doing a “self-check” about feelings, connecting with others, contributing to community.&l;/li&g;\n  &l;li&g;Support your child in developing strong interpersonal skills such as communicating with different types of people, collaborating and teamwork.&a;nbsp;&l;/li&g;\n  &l;li&g;Ask your child to think about questions such as, “Who am I? What is my plan for achieving my goals? Who do I want to become? What are my opportunities?”&a;nbsp;&l;/li&g;\n  &l;li&g;Explore a variety of career options together by helping your child to:&a;nbsp;\n    &l;ul&g;\n      &l;li&g;network with people working in their field of choice so they can learn about that career&a;nbsp;&l;/li&g;\n      &l;li&g;enrol in cooperative education courses&a;nbsp;&l;/li&g;\n      &l;li&g;enrol in career-focused programs in their high school&a;nbsp;&l;/li&g;\n      &l;li&g;search out information about different careers and pathways and labour market trends.&a;nbsp;&l;/li&g;\n    &l;/ul&g;\n  &l;/li&g;\n  &l;li&g;Ask your child to share their Individual Pathways Plan (IPP) often and discuss their goals, interests and career exploration.&a;nbsp;&l;/li&g;\n  &l;li&g;Be supportive and keep an open mind about the value of all pathways, whether it’s apprenticeship and skilled trades, college, community living, university, or the workplace.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;glc2o___parent_guide_banner__copy_&q;:{&q;system&q;:{&q;id&q;:&q;87c6caf5-a3b5-4fd1-9fdd-34a920d966d6&q;,&q;name&q;:&q;TAS1O - TAS2O - Parent Guide Banner&q;,&q;codename&q;:&q;glc2o___parent_guide_banner__copy_&q;,&q;language&q;:&q;en-CA&q;,&q