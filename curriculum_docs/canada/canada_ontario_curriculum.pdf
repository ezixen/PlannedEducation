background:#222426}.mat-drawer-content,.mat-drawer-container{overflow:visible!important;overflow:initial!important}.mat-drawer-container-explicit-backdrop .mat-drawer-side{z-index:inherit!important}.mat-toolbar-multiple-rows{min-height:60px}</style><link rel="stylesheet" href="styles.6cee148f8ed37719.css" crossorigin="use-credentials" media="print" onload="this.media='all'"><noscript><link rel="stylesheet" href="styles.6cee148f8ed37719.css"></noscript><style ng-transition="serverApp">.mat-drawer.right-side__content-wrapper {
  z-index: 777;
}

@media only screen and (max-width: 1279px) {
  .mat-drawer.left-sidebar {
    width: 400px;
  }
}

@media only screen and (max-width: 448px) {
  .mat-drawer.left-sidebar {
    width: calc(100% - 48px);
  }
}

.mat-drawer.left-sidebar.large-view {
  visibility: visible !important;
  transform: none !important;
  display: block;
}

.mat-drawer.right-side__content-wrapper .mat-drawer-inner-container {
  overflow-x: hidden;
}

.header__bottom {
  position: fixed;
  top: 0px;
  left: 0px;
}

.nav__logo {
  width: 102px;
  padding: 16px 16px 11px;
}

.mat-content-area {
  width: 100%;
}

.large-view .left-sidebar.one-column {
  width: 0;
}

.large-view .left-sidebar.two-column.leftside-collapsed {
  width: 80px;
}

.large-view .left-sidebar.two-column.leftside-expand {
  width: 300px;
}

.large-view .mat-content-area.one-column {
  margin-left: 0 !important;
  width: 100%;
}

.large-view .mat-content-area.two-column.leftside-collapsed {
  margin-left: 80px !important;
  width: calc(100% - 80px);
}

.large-view .mat-content-area.two-column.leftside-expand {
  margin-left: 300px !important;
  width: calc(100% - 300px);
}

.right-side__button-panel-view {
  display: none;
}

.my-notes .right-side__button-panel-view {
  display: inline;
  display: initial;
}

.my-notes .right-side__button-panel-view.onboarding {
  display: none !important;
}

.right-side__content-wrapper:not(.my-notes) .right-side__button-panel-view {
  display: none !important;
}

.z-inherit {
  z-index: inherit !important;
}

.general-mat-menu button {
  color: #0473b4;
}

.mbs-document-editor {
  position: fixed;
  width: 100%;
  height: 100%;
  left: 0;
  top: 0;
}</style><style ng-transition="serverApp">.mat-drawer-container{position:relative;z-index:1;box-sizing:border-box;-webkit-overflow-scrolling:touch;display:block;overflow:hidden}.mat-drawer-container[fullscreen]{top:0;left:0;right:0;bottom:0;position:absolute}.mat-drawer-container[fullscreen].mat-drawer-container-has-open{overflow:hidden}.mat-drawer-container.mat-drawer-container-explicit-backdrop .mat-drawer-side{z-index:3}.mat-drawer-container.ng-animate-disabled .mat-drawer-backdrop,.mat-drawer-container.ng-animate-disabled .mat-drawer-content,.ng-animate-disabled .mat-drawer-container .mat-drawer-backdrop,.ng-animate-disabled .mat-drawer-container .mat-drawer-content{transition:none}.mat-drawer-backdrop{top:0;left:0;right:0;bottom:0;position:absolute;display:block;z-index:3;visibility:hidden}.mat-drawer-backdrop.mat-drawer-shown{visibility:visible}.mat-drawer-transition .mat-drawer-backdrop{transition-duration:400ms;transition-timing-function:cubic-bezier(0.25, 0.8, 0.25, 1);transition-property:background-color,visibility}.cdk-high-contrast-active .mat-drawer-backdrop{opacity:.5}.mat-drawer-content{position:relative;z-index:1;display:block;height:100%;overflow:auto}.mat-drawer-transition .mat-drawer-content{transition-duration:400ms;transition-timing-function:cubic-bezier(0.25, 0.8, 0.25, 1);transition-property:transform,margin-left,margin-right}.mat-drawer{position:relative;z-index:4;display:block;position:absolute;top:0;bottom:0;z-index:3;outline:0;box-sizing:border-box;overflow-y:auto;transform:translate3d(-100%, 0, 0)}.cdk-high-contrast-active .mat-drawer,.cdk-high-contrast-active [dir=rtl] .mat-drawer.mat-drawer-end{border-right:solid 1px currentColor}.cdk-high-contrast-active [dir=rtl] .mat-drawer,.cdk-high-contrast-active .mat-drawer.mat-drawer-end{border-left:solid 1px currentColor;border-right:none}.mat-drawer.mat-drawer-side{z-index:2}.mat-drawer.mat-drawer-end{right:0;transform:translate3d(100%, 0, 0)}[dir=rtl] .mat-drawer{transform:translate3d(100%, 0