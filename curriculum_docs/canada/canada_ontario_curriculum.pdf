 1&l;/em&g;&l;em&g;&l;sup&g;re&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;à la 8&l;/em&g;&l;em&g;&l;sup&g;e&a;nbsp;&l;/sup&g;&l;/em&g;&l;em&g;année&a;nbsp;– Sciences et technologie&l;/em&g;&a;nbsp;(2007). À partir de septembre 2022, tous les programmes de sciences et technologie de la 1&l;sup&g;re&l;/sup&g;&a;nbsp;à la 8&l;sup&g;e&a;nbsp;&l;/sup&g;année seront fondés sur les attentes et les contenus d’apprentissage présentés dans ce programme-cadre.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;elem___science_and_tech___revision_history_1&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum, Grades 1–8: Science and Technology, 2022&l;/em&g;&l;/p&g;&q;}}},&q;elementary___the_arts_4877b9e&q;:{&q;system&q;:{&q;id&q;:&q;4877b9ec-4b18-4b42-8dd2-9ef9d94db695&q;,&q;name&q;:&q;Elementary - The Arts&q;,&q;codename&q;:&q;elementary___the_arts_4877b9e&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;l1___curriculum&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-04-17T14:47:07.9718375Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___curriculum_select__elem__sec____curriculum&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Curriculum Select (Elem, Sec) + Curriculum&q;,&q;taxonomy_group&q;:&q;site___curriculum_select__elem__sec____curriculum&q;,&q;value&q;:[{&q;name&q;:&q;Elementary&q;,&q;codename&q;:&q;elementary&q;},{&q;name&q;:&q;Arts&q;,&q;codename&q;:&q;arts_elementary&q;}]},&q;context&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Context&q;,&q;value&q;:[&q;ele___arts___curriculum_context&q;]},