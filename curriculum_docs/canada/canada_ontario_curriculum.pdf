;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Colour&q;,&q;value&q;:[{&q;name&q;:&q;ASL and LSQ&q;,&q;codename&q;:&q;asl_and_lsq&q;}]},&q;icon&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Icon&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum-LSQ.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:6905,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/3d96ead7-6d65-42a8-8228-d73eeecf09e9/Curriculum-LSQ.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;elementary___alf___fr___curr_pdf__copy_&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Les définitions de ce glossaire sont spécifiques au contexte du programme-cadre &l;em&g;Langue des signes québécoise (LSQ) langue seconde&l;/em&g; (2021) dans lequel ces termes sont utilisés.&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2021&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Le programme-cadre de langue des signes québécoise langue seconde du curriculum de l’Ontario est destiné aux écoles secondaires de langue française. À compter de septembre 2021, le cours de langue des signes québécoise langue seconde offert dans les écoles secondaires sera fondé sur les attentes et les contenus d’apprentissage énoncés dans ce programme-cadre.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___asl_lsq___revision_history_1&q;,&q;sec___asl_lsq___revision_history_2&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum, Grades 9 to 12: American Sign Language as a Second Language, 2021&l;/em&g;&l;/p&g;&q;}}},&q;secondary___asl___lsq___overview_page&q;:{&q;system&q;:{&q;id&q;:&q;9c95e857-890c-4b89-96bf-839a6677e89e&q;,&q;name&q;:&q;Secondary - ASL / LSQ - Overview Page&q;,&q;codename&q;:&q;secondary___asl___lsq___overview_page&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2021-07-20T18:11:58.7490145Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Palier secondaire - Langue des signes québécoise langue seconde - Accueil&q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;secondaire-lsqls-accueil&q;},&q;column_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Column layout&q;,&q;value&q;:[{&q;name&q;:&q;one-column&q;,&q;codename&q;:&q;one_column&q;}]},&q;subitems&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Main&q;,&q;value&q;:[&q;elementary___language_carousel__copy_&q;,&q;elementary___language_horizontal_widget__copy_&q;]},&q;subitems_left&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Subitems left&q;,&q;value&q;:[]},&q;subitems_right&q;:{&q;type&q;:&q;modular_co