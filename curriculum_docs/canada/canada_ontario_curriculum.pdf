;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Primary content link&q;,&q;value&q;:[]},&q;external_link_url&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Primary external link URL&q;,&q;value&q;:&q;&q;},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;secondary_button_caption&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Secondary button caption&q;,&q;value&q;:&q;&q;},&q;secondary_button_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Secondary button type&q;,&q;value&q;:[]},&q;secondary_content_link&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Secondary content link&q;,&q;value&q;:[]},&q;secondary_external_link_url&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Secondary external link URL&q;,&q;value&q;:&q;&q;}}},&q;browsers___content&q;:{&q;system&q;:{&q;id&q;:&q;94d1703c-e45e-4b99-b9f1-829839ae9e9c&q;,&q;name&q;:&q;Browsers - Content&q;,&q;codename&q;:&q;browsers___content&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2019-11-22T13:48:05.2926078Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Browsers&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;browsers&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Your web browser is the software or app you use to access the internet. If it is out of date, websites will not look or function the same as they would in a newer browser.&l;br&g;\n&l;br&g;\nUpgrading to a newer browser will mean:&l;/p&g;\n&l;ul&g;\n  &l;li&g;it will be faster to browse the internet&l;/li&g;\n  &l;li&g;you’ll be able to use more features on many websites&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Browser Options&l;br&g;\n&l;/h4&g;\n&l;p&g;There are many browsers available, here are a few options for different types of computers.&l;br&g;\n&l;br&g;\nYou can choose from:&l;/p&g;\n&l;ul&g;\n  &l;li&g;&l;a href=\&q;https://www.google.com/chrome/\&q; data-new-window=\&q;true\&q; title=\&q;Chrome\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Chrome&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://www.mozilla.org/en-US/firefox/new/\&q; data-new-window=\&q;true\&q; title=\&q;Firefox\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Firefox&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://support.apple.com/en-ca/safari\&q; data-new-window=\&q;true\&q; title=\&q;Safari\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Safari&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://www.microsoft.com/en-ca/windows/microsoft-edge\&q; data-new-window=\&q;true\&q; title=\&q;Edge\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Edge&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&