q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ce programme-cadre est destiné aux écoles de langue française; il remplace&a;nbsp;&l;em&g;Le curriculum de l’Ontario&a;nbsp;– Études sociales, de la 1&l;/em&g;&l;em&g;&l;sup&g;re&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;à la 6&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année; histoire et géographie, 7&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;et 8&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année &l;/em&g;(2023). À partir l’année scolaire&a;nbsp;2026-2027, tous les programmes d’études sociales, d’histoire et de géographie de la 1&l;sup&g;re&l;/sup&g;&a;nbsp;à la 8&l;sup&g;e&l;/sup&g;&a;nbsp;année seront fondés sur les attentes et les contenus d’apprentissage présentés dans &l;em&g;Le curriculum de l’Ontario&a;nbsp;– Études sociales, de la 1&l;/em&g;&l;em&g;&l;sup&g;re&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;à la 6&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année; histoire et géographie, 7&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;et 8&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année &l;/em&g;(2026)&l;em&g;. &l;/em&g;Les révisions de 2026 se sont concentrées sur l’apprentissage en histoire, 7&l;sup&g;e&l;/sup&g; et 8&l;sup&g;e&a;nbsp;&l;/sup&g;année.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;ele___sshg___revision_history_1&q;,&q;ele___sshg___revision_history_2&q;,&q;ele___sshg___revision_history_2__copy_&q;,&q;ele___sshg___revision_history_3__copy_&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum: Social Studies, Grades 1 to&a;nbsp;6; History and Geography, Grades&a;nbsp;7 and&a;nbsp;8, 2026&l;/em&g;&l;/p&g;&q;}}},&q;elem___math___revision_history_page&q;:{&q;system&q;:{&q;id&q;:&q;612c8ae8-9276-4020-adf5-17053f13cf52&q;,&q;name&q;:&q;Elem - Math - Revision History Page&q;,&q;codename&q;:&q;elem___math___revision_history_page&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-27T17:58:53.0620969Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Historique des versions&q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;historique-des-versions&q;},&q;column_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Column layout&q;,&q;value&q;:[{&q;name&q;:&q;one-column&q;,&q;codename&q;:&q;one_column&q;}]},&q;subitems&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Main&q;,&q;value&q;:[&q;elem___math___revision_history&q;]},&q;subitems_left&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Subitems left&q;,&q;value&q;:[]},&q;subitems_right&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Subpages&q;,&q;value&q;:[]},&q;right_side_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Right side items&q;,&q;value&q;:[]},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;