;}]},&q;icon&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Icon&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum-ENG.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:5059,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/8dd4ccc0-6bc9-4a04-8a87-cca2f71afd65/Curriculum-ENG.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;enl1w___frl1w___expectations_pdf__copy_&q;,&q;eng___fra___g9_10___curr_pdf__copy__52f4ea8&q;,&q;ele___lang___fra___g1_8_strand_d_pdf__2023___copy_&q;,&q;lang___fra___appendix_b_pdf&q;,&q;eng___fra___g9_10___curr_pdf&q;,&q;eng___fra___g11_12___curr_pdf&q;,&q;eng___fra___g11_12___curr_pdf__copy_&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The definitions provided in this glossary are specific to the curriculum context in which the terms are used&l;/em&g;&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2023&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Educators should be aware that, with the exception of&a;nbsp;&l;strong&g;the Grade 9 English course, 2023 (ENL1W)&l;/strong&g;, the 2007 English curriculum for Grade 10 and the 2007 English curriculum for Grades 11–12 remain in effect. All secondary English courses for Grades 10–12 will continue to be based on those documents. All references to Grade 9 that appear in&a;nbsp;&l;em&g;The Ontario Curriculum, Grades 9 and 10: English, 2007&a;nbsp;&l;/em&g;and&a;nbsp;&l;em&g;The Ontario Curriculum, Grades 11 and 12: English, 2007&l;/em&g;&a;nbsp;have been superseded by&a;nbsp;&l;em&g;The Ontario Curriculum, Grade 9: English, 2023.&a;nbsp;&l;/em&g;As of September 2023, this course replaces English, Grade 9, Academic (ENG1D), which expired at the end of the 2022–23 school year. The Applied course (ENG1P – English, Grade 9, Applied) expired at the end of the 2021–22 school year.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___eng___fra___revision_history_1&q;,&q;sec___eng___fra___revision_history_1__copy_&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;Le curriculum de l’Ontario – Français, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année&l;/em&g; (2023); &l;em&g;Le curriculum de l’Ontario – Français, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année, édition révisée &l;/em&g;(2007) et &l;em&g;Le curriculum de l’Ontario – Français, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année, édition révisée &l;/em&g;(2007)&l;/p&g;&q;}}},&q;secondary___english___francais___overview_home__co&q;:{&q;system&q;:{&q;id&q;:&q;5c6c01a6-fc5c-4e9c-b0d5-34c4158edf62&q;,&q;name&q;:&q;Sec - English - Français - Overview Home (2023)&q;,&q;codename&q;:&q;secondary___english___francais___overview_home__co&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-08-28T15: