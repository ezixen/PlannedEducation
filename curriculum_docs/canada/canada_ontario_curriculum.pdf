,&q;bmx3e__copy_&q;,&q;btx4c__copy_&q;,&q;boh4m__copy_&q;]},&q;glossary&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Glossary&q;,&q;value&q;:[]},&q;resources&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Resources&q;,&q;value&q;:[&q;bem1o___bep2o___parent_guide__resource_card___copy_c158e80&q;,&q;tas1o___tas2o___parent_guide__resource_card___copy&q;]},&q;colour&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Colour&q;,&q;value&q;:[{&q;name&q;:&q;Business Studies (secondary)&q;,&q;codename&q;:&q;business_studies_secondary&q;}]},&q;icon&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Icon&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum_BusinessStudies.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1667,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/35b7a5ac-1d96-43ec-8210-3a12466d4bd3/Curriculum_BusinessStudies.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;tas1o___strands___oe_se_pdf__copy_&q;,&q;bem1o___strands___oe_se_pdf__copy_&q;,&q;business_studies___g9_10_curriculum_pdf__copy_&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2024&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ce programme-cadre remplace &l;em&g;Le curriculum de l’Ontario, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – Affaires et commerce, édition révisée &l;/em&g;(2006). À partir de l’année scolaire 2024-2025, tous les cours d’affaires et commerce de 9&l;sup&g;e&l;/sup&g; et 10&l;sup&g;e&l;/sup&g;&a;nbsp;année seront basés sur les attentes et les contenus d’apprentissage présentés dans ce programme-cadre. Les cours d’affaires et commerce de 11&l;sup&g;e&l;/sup&g; et 12&l;sup&g;e&l;/sup&g;&a;nbsp;année continuent d’être fondés sur &l;a href=\&q;https://www.edu.gov.on.ca/fre/curriculum/secondary/business1112currb.pdf\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – Affaires et commerce, édition révisée&l;/em&g; (2006)&l;/a&g;. Toutes les références aux cours de 9&l;sup&g;e&l;/sup&g; et 10&l;sup&g;e&l;/sup&g;&a;nbsp;année qui apparaissent dans &l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – Affaires et commerce, édition révisée&l;/em&g; (2006) ont été remplacées par &l;em&g;Le curriculum de l’Ontario – Affaires et commerce, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année&l;/em&g; (2024).&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___business_studies___revision_history_1&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The Ontario Curriculum, Grades 9 and 10: Business Studies, 2024; The Ontario Curriculum, Grades 11 and 12: Business Studies, 2006.&l;/p&g;&q;}}},&q;sec___business_studies___overview_home&q;:{&q;system&q;:{&q;id&q;:&q;5fb59948-56f7-4319-aa7e-431ea95f1d83&q;,&q;name&q;:&q;Sec - Business Studies - Overview Home&q;,&q;codename&q;:&q;sec___business_studies___overview_home&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-07-29T18:22:13.4609598Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Accueil&q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;accueil&q;},&q;column_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Column layout&q;,&q;value&q;:[{&q;name&q;:&q;one-column&q;,&q;codename&q;:&q;one_column&q;}]},&q;subitems&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Main&q;,&q;value&q;:[&q;secondary___arts___course_carousel__temp___copy_&q;,&q;sec___business_studies___horizontal_widget&q;]},&q;subitems_left&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Subitems left&q;,&q;value&q;:[]},&q;subitems_right&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Subpages&q;,&q;value&q;:[]},&q;right_side_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Right side items&q;,&q;value&q;:[]},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;typ