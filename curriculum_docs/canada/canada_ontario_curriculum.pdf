hed&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Curriculum PDF&q;},&q;content_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Content Item&q;,&q;value&q;:[]},&q;child_navigation_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Child Navigation Items&q;,&q;value&q;:[]},&q;include_menu_hierarchy&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Include menu hierarchy&q;,&q;value&q;:[]},&q;internal_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Internal link&q;,&q;value&q;:&q;&q;},&q;external_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External link&q;,&q;value&q;:&q;https://www.edu.gov.on.ca/eng/curriculum/secondary/health9to12.pdf&q;},&q;asset&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Asset&q;,&q;value&q;:[]},&q;fragment&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Fragment&q;,&q;value&q;:&q;&q;},&q;is_quick_links&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Is quick links&q;,&q;value&q;:[]},&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;curriculum-pdf&q;},&q;external_link_href&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External Link Href&q;,&q;value&q;:&q;&q;},&q;target&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Target&q;,&q;value&q;:[{&q;name&q;:&q;_blank&q;,&q;codename&q;:&q;_blank&q;}]},&q;redirect_to_url&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Redirect To URL&q;,&q;value&q;:[]},&q;mega_menu_flag&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Flag&q;,&q;value&q;:[]},&q;megamenu_pane_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Layout&q;,&q;value&q;:[]},&q;left_sub_menu_button&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Left Sub Menu Button&q;,&q;value&q;:[]},&q;curriculum_layout_linked_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum Layout Linked Item&q;,&q;value&q;:[]}}},&q;cws___disciplines_filter&q;:{&q;system&q;:{&q;id&q;:&q;cc2468a9-9e81-45c2-8d8c-b498dc185163&q;,&q;name&q;:&q;CWS - Disciplines Filter&q;,&q;codename&q;:&q;cws___disciplines_filter&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___available_filters___curriculum_disciplines&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2021-02-23T18:10:17.6688336Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;label&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Label&q;,&q;value&q;:&q;Disciplines&q;},&q;site___curriculum_disciplines&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Curriculum Disciplines&q;,&q;taxonomy_group&q;:&q;site___curriculum_disciplines&q;,&q;value&q;:[{&q;name&q;:&q;Economics&q;,&q;codename&q;:&q;economics&q;},{&q;name&q;:&q;Geography&q;,&q;codename&q;:&q;geography&q;},{&q;name&q;:&q;History&q;,&q;codename&q;:&q;history&q;},{&q;name&q;:&q;Law&q;,&q;codename&q;:&q;law&q;},{&q;name&q;:&q;Politics&q;,&q;codename&q;:&q;politics&q;}]},&q;primary_filter&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Primary Filter&q;,&q;value&q;:[{&q;name&q;:&q;Show filter upfront&q;,&q;codename&q;:&q;show_filter_upfront&q;}]}}},&q;cws___disclaimer&q;:{&q;system&q;:{&q;id&q;:&q;45cf24f7-3edd-4e20-b331-18853e0d5d4f&q;,&q;name&q;:&q;CWS - Disclaimer&q;,&q;codename&q;:&q;cws___disclaimer&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-19T13:23:32.0846344Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;This curriculum policy replaces the expectations outlined in&a;nbsp;&l;em&g;The Ontario Curriculum, Grades 9 and 10: Canadian and World Studies, 2018&l;/em&g;. All Canadian and world studies programs for Grades 9 and 10 will be based on the expectations in&a;nbsp;the Grade 9&a;nbsp;Exploring Canadian Geography&a;nbsp;(2024),&a;nbsp;Grade 10&a;nbsp;History (starting in the 2026–27 school year) and&a;nbsp;Civics&a;nbsp;and Citizenship&a;nbsp;(2022)&a;nbsp;courses.&a;nbsp;The expectations for Grades 11 and 12 will continue to be based on&a;nbsp;&l;em&g;The Ontario Curriculum, Grades 11 and 12: Canadian and World Studies, 2015&l;/em&g;, but all references to Grade 9 and 10 courses appearing in that document have been superseded.&a;nbsp;&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multipl