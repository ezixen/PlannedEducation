nelle et du jardin d’enfants&a;nbsp;&l;/em&g;(2016).&a;nbsp;À compter de l’année scolaire&a;nbsp;2026-2027, le programme de la maternelle et du jardin d’enfants sera fondé sur les attentes et les contenus d’apprentissage énoncés dans ce programme-cadre.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;ele___lang___fra___revision_history_1__copy_&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The Ontario Curriculum: Kindergarten, 2026.&l;/p&g;&q;}}},&q;elementary___hpe___config__copy_&q;:{&q;system&q;:{&q;id&q;:&q;1a8c5352-c62f-4a22-9609-c6e08cc18321&q;,&q;name&q;:&q;Elementary - SSHG - Config&q;,&q;codename&q;:&q;elementary___hpe___config__copy_&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui_configuration&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2021-10-26T15:58:48.1717759Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;backdrop_image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Backdrop Image&q;,&q;value&q;:[]},&q;narrow_image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Narrow Image&q;,&q;value&q;:[]},&q;mobile_backdrop_image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Mobile Backdrop Image&q;,&q;value&q;:[]},&q;layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Layout&q;,&q;value&q;:[]},&q;color_theme&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Color Theme&q;,&q;value&q;:[]},&q;features&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Features&q;,&q;value&q;:[{&q;name&q;:&q;Show header groupings in right navigation&q;,&q;codename&q;:&q;show_header_groupings_in_right_navigation&q;},{&q;name&q;:&q;Turn OFF