w-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Addenda&l;/a&g; have been issued to the Grade 10 MPM2D and MFM2P courses, to be implemented for the 2022–23 school year.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___math___revision_history_1&q;,&q;sec___math___revision_history_1_7a3d727&q;,&q;sec___math___revision_history_3&q;,&q;untitled_content_item_b6ba338&q;,&q;sec___math___revision_history_5&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;Le curriculum de l’Ontario, de la 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; à la 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année – Mathématiques&l;/em&g;&l;/p&g;&q;}}},&q;sec___science___disciplines&q;:{&q;system&q;:{&q;id&q;:&q;c3f84694-bfb4-4917-85e7-f7f470bb3b45&q;,&q;name&q;:&q;Sec - Science - Disciplines Filter&q;,&q;codename&q;:&q;sec___science___disciplines&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___available_filters___curriculum_disciplines&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2021-11-17T13:48:22.4716991Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;label&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Label&q;,&q;value&q;:&q;Disciplines&q;},&q;site___curriculum_disciplines&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Curriculum Disciplines&q;,&q;taxonomy_group&q;:&q;site___curriculum_disciplines&q;,&q;value&q;:[{&q;name&q;:&q;Biology&q;,&q;codename&q;:&q;biology&q;},{&q;name&q;:&q;Chemistry&q;,&q;codename&q;:&q;chemistry&q;},{&q;name&q;:&q;Earth and Space Science&q;,&q;codename&q;: