slug&q;:&q;&q;}},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;a data-item-id=\&q;5cde0df7-cf64-453d-85dd-69e3b44a8be5\&q; href=\&q;\&q;&g;Parents&l;/a&g;&a;nbsp;can make a big difference in their child’s learning by talking with them about what they are learning at school.&l;/p&g;\n&l;p&g;In addition to talking with their child about their learning, parents and families can support their child’s success by finding ways to make a connection between what is being learned at school and outside the classroom, so that their child can apply their learning at home, at school and beyond.&l;/p&g;\n&l;p&g;We invite you to visit this site regularly – as we add new digital versions of the Ontario curriculum in all subjects and grades, more parent guides will also be available here. &a;nbsp;&l;/p&g;\n&l;p&g;&l;br&g;&l;/p&g;\n&l;p&g;&a;nbsp;&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;