anges,key,science,technology,1-8,2022,2007&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;settings&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Features&q;,&q;value&q;:[{&q;name&q;:&q;Show Yes/No Rating&q;,&q;codename&q;:&q;show_yes_no_rating&q;}]},&q;revision_history_page&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision History Page&q;,&q;value&q;:[]},&q;content_download&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Content Download&q;,&q;value&q;:[]},&q;thumbnail&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Thumbnail&q;,&q;value&q;:[{&q;name&q;:&q;Canadian and World Studies Key Changes Button Ver 1.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:10001,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/816ebd5f-32ff-4261-bcf8-85af97728988/Canadian%20and%20World%20Studies%20Key%20Changes%20Button%20Ver%201.svg&q;}]},&q;system___site___resource_category&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;System - Site – Resource Category&q;,&q;taxonomy_group&q;:&q;site___resource_category&q;,&q;value&q;:[]},&q;rp___resource___subject&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Subject&q;,&q;taxonomy_group&q;:&q;rp___resource___subject&q;,&q;value&q;:[{&q;name&q;:&q;Canadian and World Studies&q;,&q;codename&q;:&q;sshg___cws&q;}]},&q;rp___resource___topic&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Topic&q;,&q;taxonomy_group&q;:&q;rp___resource___topic&q;,&q;value&q;:[]},&q;site___grade&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Grade&q;,&q;taxonomy_group&q;:&q;site___grade&q;,&q;value&q;:[]},&q;rp___developed_by&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Developed By&q;,&q;taxonomy_group&q;:&q;rp___developed_by&q;,&q;value&q;:[{&q;name&q;:&q;Ministry of Education&q;,&q;codename&q;:&q;ministry_of_education&q;}]},&q;rp___audience&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Audience&q;,&q;taxonomy_group&q;:&q;rp___audience&q;,&q;value&q;:[{&q;name&q;:&q;Teachers&q;,&q;codename&q;:&q;teachers&q;}]}}},&q;chv2o___parent_guide___about__copy_&q;:{&q;system&q;:{&q;id&q;:&q;0960d6ab-35cd-440c-a9c3-a9f624c25740&q;,&q;name&q;:&q;CHV2O - Parent Guide - What students will learn&q;,&q;codename&q;:&q;chv2o___parent_guide___about__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T18:16:18.9780762Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What students will learn&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;h4&g;Political inquiry and skill development&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;learn to analyse issues, events and developments of civic importance by asking focused questions, gathering information, evaluating the information, drawing conclusions and communicating their results&l;/li&g;\n  &l;li&g;practise using transferable skills, including using digital literacy and critical thinking to gather information and evaluate credibility and biases in both social media and traditional media.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Civic awareness&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;explore how people’s values and beliefs influence both their civic actions and their positions on local, national and/or global issues&l;/li&g;\n  &l;li&g;learn about how groups outside Canada can influence civic issues like elections and democratic values within the country&l;/li&g;\n  &l;li&g;learn about the different types of governments in Canada, such as municipal, provincial and federal governments, as well as how legislation becomes law and how governments develop budgets&l;/li&g;\n  &l;li&g;learn about Indigenous governing systems and structures, treaties and Crown-Indigenous relations&l;/li&g;\n  &l;li&g;explore the rights and responsibilities of active citizens in a democratic society, including learning about foundational historical documents.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Civic engagement, service, and action&l;/h4&g;\n&l;p&g;Students will:&l;/p&g;\n&l;ul&g;\n  &l;li&g;explore how people in different communities in Canada express their beliefs and values, share their thoughts on issues of civic importance and contribute to the common good&l;/li&g;\n  &l;li&g;analyse the importance of pride in country and commemorating important events and people in Canadian history&l;/li&g;\n  &l;li&g;research and suggest how to create positive change around a civic issue they are interested in&l;/li&g;\n  &l;li&g;identify opportunities to volunteer in their communities where they can develop a sense of service and leadership skills.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;chv2o___parent_guide___overview__copy_&q;:{&q;system&q;:{&q;id&q;:&q;2b002da2-c38d-4ef7-8ff7-5a41ca07059b&q;,&q;name&q;:&q;SNC1W - Parent Guide - Moving to one science course&q;,&q;codename&q;:&q;chv2o___parent_guide___overview__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-06T15:28:04.6130446Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Moving to one science course&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;one-course&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ontario is continuing its efforts to end streaming students as they enter high school. Starting in September 2022, there will be one Grade 9 science course being taught for all students. This means that there will no longer be applied or academic courses for Grade 9 science. This is called de-streaming. This change will provide all students with the same learning experience and help prepare students for a wide variety of career pathways. This course is compulsory for all students.&l;/p&g;\n&l;p&g;Additionally, this is part of Ontario’s plan to modernize curriculum to ensure that all students have the foundational and transferable skills they will need in a rapidly changing world with an ongoing focus on science, technology, engineering and mathematics (STEM).&l;/p&g;\n&l;p&g;The Grade 9 science curriculum was last updated in 2008.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;chv2o___parent_guide___related_resources&q;:{&q;system&q;:{&q;id&q;:&q;ddb05e76-23b3-48fe-82a2-c36a4a2e9f3a&q;,&q;name&q;:&q;CHV2O - Parent Guide - Related Resources&q;,&q;codename&q;:&q;chv2o___parent_guide___related_resources&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-04-07T13:10:04.0584375Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Related resources&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;a href=\&q;/en/curriculum/canadian-and-world-studies/courses/chv2o/home\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Grade 10 Civics and Citizenship Course, 2022&l;/a&g;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.ontario.ca/page/high-school-graduation-requirements?_ga=2.244748294.2098729747.1638799825-2041196396.1638799825\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;High school graduation requirements | ontario.ca&l;/a&g;&l;/p&g;\n&l;p&g;&l;a href=\&q;/en/program-planning/transferable-skills\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Transferable skills&l;/a&g;&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;chv2o___parent_guide___what_students_will_learn__c&q;:{&q;system&q;:{&q;id&q;:&q;18695539-70d9-4c1f-96f9-ddbedddaee17&q;,&q;name&q;:&q;CHV2O - Parent Guide - Supporting your child’s learning&q;,&q;codename&q;:&q;chv2o___parent_guide___what_students_will_learn__c&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-01T18:26:30.6436384Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Supporting your child’s learning&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Parents and family, you can have a huge influence on your child’s educational success and future career choices. By showing an interest in what your child is learning and helping them make a connection to everyday events at home, in the community and beyond, you can make an important contribution to their success. Here are some ideas for how to support your child’s learning and help them understand the role of civics and citizenship in everyday life and in their future:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Discuss current events, issues and developments happening both in your community and globally, supporting healthy, respectful discussion.&l;/li&g;\n  &l;li&g;Encourage your child to follow issues, events and developments of civic importance on various media platforms or explore platforms together and guide your child on how to assess credibility of sources. &a;nbsp;&l;/li&g;\n  &l;li&g;Show appreciation for the multiple communities to which your child and your family belong—for example, cultural, religious, linguistic or national communities.&l;/li&g;\n  &l;li&g;Encourage your child to volunteer at school or in the community to support their development as a responsible and engaged citizen.&l;/li&g;\n  &l;li&g;Help your child make connections between what they learn in school, their interests and the courses they choose to take.&l;/li&g;\n  &l;li&g;Discuss with your child the importance of recognizing important people and events in the past, and how they can inspire positive action today.&l;/li&g;\n  &l;li&g;Connect with your child’s teacher, guidance counsellor or other school staff, who can provide information about skills and experiences that will support your child’s learning, future aspirations and course choices.&l;/li&g;\n  &l;li&g;Stay informed about your child’s learning. If you have questions, contact your child’s teacher or school.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;chv2o___parent_guide__ui_view___copy_&q;:{&q;system&q;:{&q;id&q;:&q;fd57f2a4-49d1-4bd7-9e45-ffa0cf486d86&q;,&q;name&q;:&q;SNC1W - Parent Guide (UI-View)&q;,&q;codename&q;:&q;chv2o___parent_guide__ui_view___copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-03-12T17:11:54.1840013Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Grade 9 science: a guide for parents &q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;snc1w-parent-guide&q;},&q;column_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Column layout&q;,&q;value&q;:[{&q;name&q;:&q;one-column&q;,&q;codename&q;:&q;one_column&q;}]},&q;subitems&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Main&q;,&q;value&q;:[&q;chv2o___parents_guides_banner__copy_&q;,&q;chv2o___parent_guide___overview__copy_&q;,&q;snc1w___parent_guide___moving_to_one_science_cours&q;,&q;snc1w___parent_guide___benefits__copy_&q;,&q;snc1w___parent_guide___about__copy_&q;,&q;snc1w___parent_guide___what_students_will_learn__c&q;,&q;snc1w___parent_guide___support_your_child_s_learni&q;,&q;snc1w___pare