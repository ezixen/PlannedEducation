ions, Metis and Inuit Studies&q;,&q;codename&q;:&q;first_nations__metis_and_inuit_studies&q;}]},&q;context&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Context&q;,&q;value&q;:[&q;secondary___fnmi___curriculum_context&q;]},&q;specific_courses&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Specific courses&q;,&q;value&q;:[&q;nac1o&q;,&q;nac2o&q;,&q;nda3m&q;,&q;nbe3u___nbf3u&q;,&q;nbe3c___nbf3c&q;,&q;nbe3e___nbf3e&q;,&q;nbv3c&q;,&q;nbv3e&q;,&q;ndg4m&q;,&q;ndw4m&q;]},&q;glossary&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Glossary&q;,&q;value&q;:[]},&q;resources&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Resources&q;,&q;value&q;:[&q;secondary___fnmi___parents_guide&q;]},&q;colour&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Colour&q;,&q;value&q;:[{&q;name&q;:&q;fnmi&q;,&q;codename&q;:&q;fnmi&q;}]},&q;icon&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Icon&q;,&q;value&q;:[{&q;name&q;:&q;curriculum-fnmi (1).svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1375,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/34ed45ef-86fd-4a92-a88b-fe82fac5b04a/curriculum-fnmi%20%281%29.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;first_nations__metis__and_inuit_studies__2019_&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;&l;strong&g;Remarque. &l;/strong&g;&l;/em&g;– Les définitions utilisées dans ce glossaire sont adaptées au contexte du présent programme-cadre.&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2019&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ce programme-cadre est destiné aux écoles de langue française. Il remplace &l;em&g;Le curriculum de l’Ontario, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&a;nbsp;&l;/sup&g;&l;/em&g;&l;em&g;année – Études autochtones&l;/em&g; (1999) et &l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année – Études autochtones&l;/em&g; (2000). Tous les cours en études des Premières Nations, des Métis et des Inuits de la 9&l;sup&g;e&l;/sup&g; à la 12&l;sup&g;e&l;/sup&g; année se fondent maintenant sur les attentes et les contenus d’apprentissage énoncés dans cette édition révisée du programme-cadre.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;secondary___fnmi___revision_history_1&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum, Grade 9 to 12: First Nations, Métis, and Inuit studies, 2019&l;/em&g;&l;/p&g;&q;}}},&q;secondary___guidance_and_career_education___revisi&q;:{&q;system&q;:{&q;id&q;:&q;167b4f95-996c-4d3d-8f6b-226e2a70800c&q;,&q;name&q;:&q;Secondary - Guidance and Career Education - Revision History Page&q;,&q;codename&q;:&q;secondary___guidance_and_career_education___revisi&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q