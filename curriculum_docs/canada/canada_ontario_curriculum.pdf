a0c5-849ffb2de96e/8dd4ccc0-6bc9-4a04-8a87-cca2f71afd65/Curriculum-ENG.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;enl1w___frl1w___expectations_pdf__copy__24d17a2&q;,&q;sec___eng__fl____9_10_curriculum_pdf&q;,&q;sec___eng__fl____11_12_curriculum_pdf&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The following definitions and lists of examples are intended to help teachers and parents use this curriculum. It should be noted that the examples provided are suggestions and are not meant to be exhaustive.&l;/em&g;&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2024&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;À l’exception du cours English de 9&l;sup&g;e&l;/sup&g;&a;nbsp;année de 2024 (EAE1W), le programme-cadre English de 10&l;sup&g;e&l;/sup&g;&a;nbsp;année de 2007 et le programme-cadre English de 11&l;sup&g;e&l;/sup&g; et 12&l;sup&g;e&l;/sup&g;&a;nbsp;année de 2007 restent en vigueur. Tous les cours English de la 10&l;sup&g;e&l;/sup&g; à la 12&l;sup&g;e&l;/sup&g;&a;nbsp;année continuent d’être fondés sur ces documents. Toutes les références à la 9&l;sup&g;e&l;/sup&g;&a;nbsp;année qui apparaissent dans &l;em&g;Le curriculum de l’Ontario, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – English &l;/em&g;(2007) et &l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – English &l;/em&g;(2007) ont été remplacées par &l;em&g;Le curriculum de l’Ontario, ­9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – English, &l;/em&g;(2024). À partir de l’année scolaire 2024-2025, le nouveau cours décloisonné remplacera le cours English, 9&l;sup&g;e&l;/sup&g;&a;nbsp;année, cours théorique (EAE1D). Ce cours a expiré à la fin de l’année scolaire 2023–2024.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;eng__fr____revision_history_1&q;,&q;sec___fsl___eng__fr____revision_history_1__copy_&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;}}},&q;sec___eng__fl____disclaimer&q;:{&q;system&q;:{&q;id&q;:&q;75ee6c86-3228-46be-935a-507a3f360542&q;,&q;name&q;:&q;Sec - ENG (FL) - Disclaimer&q;,&q;codename&q;:&q;sec___eng__fl____disclaimer&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-08-09T11:48:02.0564921Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;À l’exception du cours English de 9&l;sup&g;e&l;/sup&g;&a;nbsp;année de 2024 (EAE1W), le programme-cadre English de 10&l;sup&g;e&l;/sup&g;&a;nbsp;année de 2007 et le programme-cadre English de 11&l;sup&g;e&l;/sup&g; et 12&l;sup&g;e&l;/sup&g;&a;nbsp;année de 2007 restent en vigueur. Tous les cours English de la 10&l;sup&g;e&l;/sup&g; à la 12&l;sup&g;e&l;/sup&g;&a;nbsp;année continuent d’être fondés sur ces documents. Toutes les références à la 9&l;sup&g;e&l;/sup&g;&a;nbsp;année qui apparaissent dans &l;em&g;Le curriculum de l’Ontario, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année&a;nbsp;– English &l;/em&g;(2007) et &l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année&a;nbsp;– English &l;/em&g;(2007) ont été remplacées par &l;em&g;Le curriculum de l’Ontario, ­9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année&a;nbsp;– English, &l;/em&g;(2024). À partir de l’année scolaire 2024-2025, le nouveau cours décloisonné remplacera le cours English, 9&l;sup&g;e&l;/sup&g;&a;nbsp;année, cours théorique (EAE1D). Ce cours a expiré à la fin de l’année scolaire 2023–2024.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&