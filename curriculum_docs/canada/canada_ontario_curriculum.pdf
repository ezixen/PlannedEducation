my_group&q;:&q;rp___audience&q;,&q;value&q;:[]}}},&q;kinder___parent_guide___fdk___introduction__copy__1305c00&q;:{&q;system&q;:{&q;id&q;:&q;1305c000-1e5b-415a-9f4a-f6cd4bef9eb7&q;,&q;name&q;:&q;Kinder 2026 - Parent Overview/Guide - Introduction&q;,&q;codename&q;:&q;kinder___parent_guide___fdk___introduction__copy__1305c00&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-12-09T13:42:23.623465Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;introduction&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The revised Kindergarten curriculum will be implemented starting in September 2026. It’s part of Ontario’s plan to update curriculum, giving our youngest learners a strong start in all areas of learning, with an emphasis on:&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;reading&a;nbsp;&l;/li&g;\n  &l;li&g;writing&a;nbsp;&l;/li&g;\n  &l;li&g;math&a;nbsp;&l;/li&g;\n  &l;li&g;science and technology&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;p&g;The curriculum aims to give your child the knowledge and skills they will need to succeed in Grade 1 by using proven teaching methods geared to your child’s age and development. Kindergarten teachers and Early Childhood Educators will work together to support each child in developing foundational skills through evidence-based explicit instruction in play- and inquiry-based learning environments.&a;nbsp;&a;nbsp;&l;/p&g;\n&l;p&g;The &l;a href=\&q;https://www.ontario.ca/document/kindergarten-program-2016\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;current Kindergarten Program&l;/a&g; was last updated in 2016 and remains in effect for the 2025–2026 school year.&a;nbsp;&l;/p&g;\n&l;p&g;Updates to the curriculum were informed in part by the recommendations in the Ontario Human Rights Commission’s &l;a href=\&q;https://www3.ohrc.on.ca/en/right-read-inquiry-report-0\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Right to Read public inquiry report&l;/a&g;.&a;nbsp;&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;kinder___parent_guide__2025_&q;:{&q;system&q;:{&q;id&q;:&q;f2edb739-f8bc-4c74-83c9-5b527f2d366b&q;,&q;name&q;:&q;Kinder - Parent Overview/Guide (2026)&q;,&q;codename&q;:&q;kinder___parent_guide__2025_&q;,&q;language&