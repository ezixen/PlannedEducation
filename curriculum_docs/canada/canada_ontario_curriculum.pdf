q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-05-01T17:25:25.8980912Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;This curriculum policy supersedes &l;em&g;The Ontario Curriculum, Grades 9 and 10: Technological Education, 2009.&l;/em&g;&l;em&g;&l;strong&g; &l;/strong&g;&l;/em&g;Beginning in the 2024–25 school year, all technological education courses for Grades 9 and 10 will be based on the expectations outlined in this curriculum. Technological education courses for Grades 11 and 12 will continue to be based on &l;a href=\&q;https://www.edu.gov.on.ca/eng/curriculum/secondary/2009teched1112curr.pdf\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;The Ontario Curriculum, Grades 11 and 12: Technological Education, 2009&l;/em&g;&l;/a&g;. All references to Grades 9 and 10 that appear in that document have been superseded.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;tech_ed___disclaimer__copy_&q;:{&q;system&q;:{&q;id&q;:&q;e89bbfd4-f29c-4beb-b5cb-1bdc70f52aa3&q;,&q;name&q;:&q;Sec - Indigenous Lang - Disclaimer&q;,&q;codename&q;:&q;tech_ed___disclaimer__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-06-25T15:13:28.0481297Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;All courses in native languages for Grades 9 to 12 are based on the expectations outlined in this curriculum policy.&l;/p&g;\n&l;ul&g;\n  &l;li&g;Since 2021–22, boards are able to offer Inuktitut as a language of instruction within Ontario’s Indigenous languages curricula (Grades 1–12). Five new secondary course codes (LNIAO, LNIBO, LNICO, LNIDO, and LNIEO) have been added in OnSIS.&l;/li&g;\n  &l;li&g;Beginning in the 2024–25 school year, boards are able to offer Algonquin as a language of instruction within Ontario’s Indigenous languages curricula (Grades 1–12). Five new secondary course codes (LNGAO, LNGBO, LNGCO, LNGDO, and LNGEO) have been added in OnSIS.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;temp___science___revision_history_page_temp&q;:{&q;system&q;:{&q;id&q;:&q;02cbbbc9-6aee-4114-a926-dd8c95bb1295&q;,&q;name&q;:&q;Sec - Science - Revision History Page&q;,&q;codename&q;:&q;temp___science___revision_history_page_temp&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-05-02T13:45:14.5848473Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;: