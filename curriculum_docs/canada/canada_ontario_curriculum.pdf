;type&q;:&q;taxonomy&q;,&q;name&q;:&q;System - Site – Resource Category&q;,&q;taxonomy_group&q;:&q;site___resource_category&q;,&q;value&q;:[]},&q;rp___resource___subject&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Subject&q;,&q;taxonomy_group&q;:&q;rp___resource___subject&q;,&q;value&q;:[]},&q;rp___resource___topic&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Topic&q;,&q;taxonomy_group&q;:&q;rp___resource___topic&q;,&q;value&q;:[]},&q;site___grade&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Grade&q;,&q;taxonomy_group&q;:&q;site___grade&q;,&q;value&q;:[]},&q;rp___developed_by&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Developed By&q;,&q;taxonomy_group&q;:&q;rp___developed_by&q;,&q;value&q;:[]},&q;rp___audience&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Audience&q;,&q;taxonomy_group&q;:&q;rp___audience&q;,&q;value&q;:[]}}},&q;cpp___roles_and_responsibilities&q;:{&q;system&q;:{&q;id&q;:&q;bc3cfa84-9b75-49d5-9b9b-5e6e522bc9ab&q;,&q;name&q;:&q;Program Planning - Roles and Responsibilities&q;,&q;codename&q;:&q;cpp___roles_and_responsibilities&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-02-26T20:15:10.3021879Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Roles and Responsibilities&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;roles-responsibilities&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;cpp___roles___students&q;,&q;cpp___roles___students__copy_&q;,&q;cpp___roles___parents__copy_&q;,&q;cpp___roles___teachers__copy_&q;,&q;cpp___roles___principals__copy_&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;crg___appendix_a__curriculum_review_assessment_for_f222255&q;:{&q;system&q;:{&q;id&q;:&q;f2222550-bcbc-4a0a-ba59-2a06f943878d&q;,&q;name&q;:&q;CRG - Appendix: Textbooks and Supplementary Learning Resources&q;,&q;codename&q;:&q;crg___appendix_a__curriculum_review_assessment_for_f222255&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-04-24T18:39:38.5849099Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Appendix: Textbooks and supplementary learning resources&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;appendix&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{&q;691e8e0d-f103-461c-8cec-de8b994f8bcf&q;:{&q;image_id&q;:&q;691e8e0d-f103-461c-8cec-de8b994f8bcf&q;,&q;description&q;:&q;Each textbook goes through a submission stage, evaluation and approval for at least five years, review and eventual discontinuation.&q;,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/97372968-e619-412e-8c89-874f22973de0/Trillium-list-lifecycle-EN.svg&q;}},&q;links&q;:{},&q;modular_content&q;:[&q;untitled_content_item_c15915d&q;,&q;crg___appendix_b__textbooks___stage_1__copy_&q;,&q;crg___appendix_b__textbooks___stage_2__copy_&q;,&q;crg___appendix_b__textbooks___stage_3__copy_&q;,&q;untitled_content_item_c637be9&q;,&q;crg___appendix___textbook_table1__copy_&q;,&q;crg___appendix___textbook_table2__copy_&q;,&q;crg___appendix___textbook_table3__copy_&q;],&q;value&q;:&q;&l;p&g;School boards are required to select Minister-approved textbooks from the provincial Trillium List for use in their schools. They are also responsible for the selection and approval of supplementary learning resources.&l;/p&g;\n&l;h4&g;Textbooks on the Trillium List&l;/h4&g;\n&l;p&g;The Trillium List contains the titles of current textbooks approved by the Minister of Education that educators can use to teach students in Kindergarten to Grade&a;nbsp;12 in Ontario’s publicly funded schools. The ministry posts the up-to-date list on its &l;a href=\&q;https://www.ontario.ca/page/trillium-list\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;website.&l;/a&g;&l;/p&g;\n&l;p&g;The Minister’s authority to select and approve textbooks and to publish the Trillium List is established under the &l;a href=\&q;https://www.ontario.ca/laws/statute/90e02\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;Education Act.&l;/em&g;&l;/a&g;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.ontario.ca/laws/regulation/900298\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Regulation 298, “Operation of Schools – General”,&l;/a&g; made under the &l;em&g;Education Act&l;/em&g;, requires that school principals select textbooks from the Trillium List in consultation with teaching staff, and requires that their selections be subject to the approval of their school board.&a;nbsp;&l;/p&g;\n&l;p&g;In instances where no textbook for a subject or course is included in the Trillium List, principals must consult with teaching staff and decide whether a textbook is required, and if so, select a suitable textbook for approval by their school board.&l;/p&g;\n&l;p&g;A textbook on the Trillium List is a comprehensive learning resource. It may consist of a single resource or a package of resources, and may be in print or digital format, or a combination of both. It is intended for use by an entire class or group of students and must support a substantial portion (at least 85%) of:&l;/p&g;\n&l;ul&g;\n  &l;li&g;the Ontario curriculum expectations for a specific grade and subject in elementary school or for a course in secondary school, or&l;/li&g;\n  &l;li&g;the expectations in one or more of the four strands of &l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/curriculum/kindergarten\&q;&g;The Kindergarten Curriculum&l;/a&g;&l;/li&g;\n&l;/ul&g;\n&l;p&g;In addition, a textbook on the Trillium List must:&l;/p&g;\n&l;ul&g;\n  &l;li&g;use an appropriate reading level and writing style for the subject, and be intended primarily for students’ use&l;/li&g;\n  &l;li&g;demonstrate sound scholarship and have contemporary relevance&l;/li&g;\n  &l;li&g;support a broad range of instructional strategies and learning styles&l;/li&g;\n  &l;li&g;be free of bias and promote diversity and inclusion&l;/li&g;\n  &l;li&g;reflect healthy, safe practices and environmental responsibility&l;/li&g;\n  &l;li&g;have Canadian-orientated content, be manufactured in Canada, and, wherever possible, be written by Canadians or permanent residents of Canada&l;/li&g;\n  &l;li&g;reflect current and appropriate uses of technology&l;/li&g;\n  &l;li&g;demonstrate sound technical design&l;/li&g;\n  &l;li&g;be accompanied by a teacher’s guide and follow the ministry’s requirements regarding safe web links&l;/li&g;\n&l;/ul&g;\n&l;p&g;More details about the Trillium List appear below.&l;/p&g;\n&l;h4&g;Supplementary learning resources&l;/h4&g;\n&l;p&g;A supplementary resource is any learning resource that is not a textbook. Examples are storybooks, novels, dictionaries, instructional guides and online learning tools. A supplementary resource is not comprehensive. It supports:&l;/p&g;\n&l;ul&g;\n  &l;li&g;only a limited number of curriculum expectations, or the curriculum expectations in a single strand, as outlined in the curriculum policy document for a subject or course, or&l;/li&g;\n  &l;li&g;a limited number of expectations in one or more of the four strands of &l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/curriculum/kindergarten\&q;&g;The Kindergarten Curriculum&l;/a&g;&l;/li&g;\n&l;/ul&g;\n&l;p&g;School boards have the responsibility for the selection of supplementary resources for use in their schools. Boards are expected to ensure that an effective process is in place for evaluation and approval and that the resources selected are age-appropriate, free from bias and discrimination and enable the promotion of inclusion.&l;/p&g;\n&l;h4&g;The Trillium List textbook “life cycle”&l;/h4&g;\n&l;p&g;The Trillium List textbook “life cycle” begins once the Ministry of Education issues new or revised curriculum and decides to phase out outdated textbooks. It has four stages, as follows:&l;/p&g;\n&l;figure data-asset-id=\&q;691e8e0d-f103-461c-8cec-de8b994f8bcf\&q; data-image-id=\&q;691e8e0d-f103-461c-8cec-de8b994f8bcf\&q;&g;&l;img src=\&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/97372968-e619-412e-8c89-874f22973de0/Trillium-list-lifecycle-EN.svg\&q; data-asset-id=\&q;691e8e0d-f103-461c-8cec-de8b994f8bcf\&q; data-image-id=\&q;691e8e0d-f103-461c-8cec-de8b994f8bcf\&q; alt=\&q;Each textbook goes through a submission stage, evaluation and approval for at least five years, review and eventual discontinuation.\&q;&g;&l;/figure&g;\n&l;p&g;Each stage is explained in more detail below.&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;untitled_content_item_c15915d\&q;&g;&l;/object&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;crg___appendix_b__textbooks___stage_1__copy_\&q;&g;&l;/object&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;crg___appendix_b__textbooks___stage_2__copy_\&q;&g;&l;/object&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;crg___appendix_b__textbooks___stage_3__copy_\&q;&g;&l;/object&g;\n&l;h4&g;Textbook legislation and regulations&l;/h4&g;\n&l;p&g;The rules regarding textbooks, their use and school boards’ responsibilities are set out in&l;em&g; &l;/em&g;the&l;em&g; Education Act&l;/em&g; and in Regulation 298, “Operation of Schools – General”, made under the &l;em&g;Education Act&l;/em&g;.&l;/p&g;\n&l;p&g;The &l;em&g;Education Act&l;/em&g; provides the Minister of Education the legal authority to approve textbooks, establish criteria and publish the Trillium List. Paragraphs 4, 5, 6, and 7 of subsection 8(1) state that the Minister may:&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;untitled_content_item_c637be9\&q;&g;&l;/object&g;\n&l;p&g;The roles of school boards, principals and teachers in the use of textbooks are also set out in the &l;em&g;Education Act&l;/em&g;. Clause (k) of subsection 264(1) of the &l;em&g;Education Act&l;/em&g; states that, it is the duty of a teacher and a temporary teacher:&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;crg___appendix___textbook_table1__copy_\&q;&g;&l;/object&g;\n&l;p&g;Clause (h) of subsection 265(1) of the &l;em&g;Education Act&l;/em&g; states that, it is the duty of a principal of a school, in addition to the principal’s duties as a teacher:&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;crg___appendix___textbook_table2__copy_\&q;&g;&l;/object&g;\n&l;p&g;The roles of school boards, principals and teachers in the selection of textbooks are set out in subsections 7(1) to 7(3) of &l;a href=\&q;https://www.ontario.ca/laws/regulation/900298\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Regulation 298&l;/a&g; made under the &l;em&g;Education Act&l;/em&g;:&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;crg___appendix___textbook_table3__copy_\&q;&g;&l;/object&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;crg___curriculum_review___phase_1___process__copy_&q;:{&q;system&q;:{&q;id&q;:&q;d81d180d-27dc-456f-986b-bdf704c358db&q;,&q;name&q;:&q;CRG - Phase 2 - Revision Process&q;,&q;codename&q;:&q;crg___curriculum_review___phase_1___process__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-01-30T14:18:20.5686274Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Phase 2: The curriculum revision process&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;revision-process&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The curriculum revision process ensures the validity, accuracy and integrity of each curriculum. The time required to complete a revision may vary based on the scope of revisions.&l;/p&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;crg___curriculum_revision___indigenous_focus__copy&q;,&q;crg___curriculum_review___review_cycle__copy_&q;,&q;c