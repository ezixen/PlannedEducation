a&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Kindergarten Webinars Registration&q;},&q;content_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Content Item&q;,&q;value&q;:[]},&q;child_navigation_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Child Navigation Items&q;,&q;value&q;:[]},&q;include_menu_hierarchy&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Include menu hierarchy&q;,&q;value&q;:[]},&q;internal_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Internal link&q;,&q;value&q;:&q;&q;},&q;external_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External link&q;,&q;value&q;:&q;https://www.dcp.edu.gov.on.ca/en/kindergarten-webinars&q;},&q;asset&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Asset&q;,&q;value&q;:[]},&q;fragment&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Fragment&q;,&q;value&q;:&q;&q;},&q;is_quick_links&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Is quick links&q;,&q;value&q;:[]},&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;kindergarten-webinars-registration&q;},&q;external_link_href&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External Link Href&q;,&q;value&q;:&q;&q;},&q;target&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Target&q;,&q;value&q;:[]},&q;redirect_to_url&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Redirect To URL&q;,&q;value&q;:[]},&q;mega_menu_flag&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Flag&q;,&q;value&q;:[]},&q;megamenu_pane_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Layout&q;,&q;value&q;:[]},&q;left_sub_menu_button&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Left Sub Menu Button&q;,&q;value&q;:[]},&q;curriculum_layout_linked_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum Layout Linked Item&q;,&q;value&q;:[]}}},&q;kinder_2025___parent_guide___introduction__copy_&q;:{&q;system&q;:{&q;id&q;:&q;1bd525dc-9cd4-4e03-a22e-3be3ca420468&q;,&q;name&q;:&q;Kinder 2026 - Parent Guide - About&q;,&q;codename&q;:&q;kinder_2025___parent_guide___introduction__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-12-15T16:21:15.0116625Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;About the revised Kindergarten curriculum &q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;about&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The revised Kindergarten curriculum has new mandatory learning in reading, writing, math, and science and technology. This will help students:&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;gain key skills and knowledge for their future&a;nbsp;&l;/li&g;\n  &l;li&g;be prepared to thrive in the world of today and tomorrow&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;p&g;The Kindergarten curriculum will support students to:&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;communicate effectively&a;nbsp;&l;/li&g;\n  &l;li&g;understand and analyze information&a;nbsp;&l;/li&g;\n  &l;li&g;explore and investigate the world around them&a;nbsp;&l;/li&g;\n  &l;li&g;think creatively and critically&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;make informed decisions&a;nbsp;&l;/li&g;\n  &l;li&g;solve problems&a;nbsp;&l;/li&g;\n  &l;li&g;self-regulate&a;nbsp;&l;/li&g;\n  &l;li&g;develop awareness of physical and mental wellness&a;nbsp;&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;p&g;Here are the key skills your child will learn in the updated curriculum. They will help your child get ready for elementary school and beyond.&a;nbsp;&a;nbsp;&l;/p&g;\n&l;h3&g;&l;strong&g;Language&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;Students will develop foundational knowledge and skills in:&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;speaking, listening, and using facial expressions, gestures and body language to communicate&a;nbsp;&l;/li&g;\n  &l;li&g;word reading and spelling&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;vocabulary&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;reading fluency and comprehension&a;nbsp;&l;/li&g;\n  &l;li&g;applying knowledge of letters, words and sentences to create simple texts&a;nbsp;&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Math&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;Students will develop foundational knowledge and skills in:&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;understanding numbers, including counting and exploring number relationships to 20&a;nbsp;&l;/li&g;\n  &l;li&g;adding numbers to 10 and related subtraction&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;sharing equally&l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Science and technology&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;Students will develop foundational knowledge and skills in:&a;nbsp;&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;performing scientific investigations to gain knowledge about the world around them&a;nbsp;&l;/li&g;\n  &l;li&g;using engineering design to create something new or different&a;nbsp;&l;/li&g;\n  &l;li&g;using innovative thinking to solve problems&a;nbsp;&l;/li&g;\n  &l;li&g;using coding to help them think in different ways, solve problems and create&a;nbsp;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;kinder_2026___parent_guide___about__copy_&q;:{&q;system&q;:{&q;id&q;:&q;61328c90-97d2-434d-8897-06ffa539c1b1&q;,&q;name&q;:&q;Kinder 2026 - Parent Guide - Summary of learning&q;,&q;codename&q;:&q;kinder_2026___parent_guide___about__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-12-17T15:10:27.8122628Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Summary of major knowledge and skills &q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;summary-learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;All children enter school capable, competent and ready to learn. Your child has already learned a lot through their experiences at home and in the community before starting Kindergarten.&a;nbsp;&l;/p&g;\n&l;p&g;Kindergarten gives your child a stronger start to reach their full potential in school and life. It helps your child grow – physically, socially, emotionally and intellectually.&a;nbsp;The revised curriculum is organized into 4 areas of learning.&a;nbsp;&a;nbsp;&l;/p&g;\n&l;h3&g;&l;strong&g;Foundations of language and mathematics&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;A strong foundation in reading, writing and math sets your child up for success. Language and math skills help your child to:&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;process information for various reasons, including decision-making&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;understand ideas and information to make sense of the world&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;reason and think critically&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;communicate their ideas and thoughts&a;nbsp;&l;/li&g;\n  &l;li&g;solve problems&a;nbsp;&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;p&g;Your child will learn:&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;listening and speaking skills and how to use facial expressions, gestures and body language&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;about the relationship between sounds and letters&a;nbsp;&l;/li&g;\n  &l;li&g;to read, understand and create simple texts by learning to use what they know about:&a;nbsp;\n    &l;ul&g;\n      &l;li&g;words&a;nbsp;&l;/li&g;\n      &l;li&g;sentence structure&a;nbsp;&l;/li&g;\n      &l;li&g;grammar&a;nbsp;&l;/li&g;\n      &l;li&g;punctuation&a;nbsp;&l;/li&g;\n    &l;/ul&g;\n  &l;/li&g;\n  &l;li&g;how to count, estimate, add, subtract and share equally using numbers&a;nbsp;&l;/li&g;\n  &l;li&g;how to identify shapes, objects and patterns&a;nbsp;&l;/li&g;\n  &l;li&g;how to answer questions by collecting data and organizing it into graphs&a;nbsp;&l;/li&g;\n  &l;li&g;how to use a variety of tools and strategies to solve math problems&a;nbsp;&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Problem solving and innovating&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;Learning to think creatively and critically is important in all aspects of life. Your child learns about the world around them and thinks in new ways to solve problems.&a;nbsp; &a;nbsp;&l;br&g;\n&a;nbsp;&l;br&g;\nYour child will learn to:&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;explore the world through natural curiosity, in ways that engage their mind, senses and body&a;nbsp;&l;/li&g;\n  &l;li&g;ask questions&a;nbsp;&l;/li&g;\n  &l;li&g;try things out&a;nbsp;&l;/li&g;\n  &l;li&g;design or make something new or different&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Self-regulation and well-being&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;Your child will learn about emotions and feelings, and how to adapt to new situations. This gives them a strong foundation for life. The goal is for your child to:&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;develop an understanding of how they focus and learn best&a;nbsp;&l;/li&g;\n  &l;li&g;respect themselves and others&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;start to learn about physical and mental health and well-being in themselves and others&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;p&g;Your child will develop the ability to:&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;manage their own feelings and emotions&a;nbsp;&l;/li&g;\n  &l;li&g;realize that others may have different thoughts and feelings, and to respect those differences&a;nbsp;&l;/li&g;\n  &l;li&g;deal with distractions&a;nbsp;&l;/li&g;\n  &l;li&g;advocate for themselves&a;nbsp;&l;/li&g;\n  &l;li&g;understand consequences of actions&a;nbsp;&l;/li&g;\n  &l;li&g;be aware of their physical and mental health and wellness&a;nbsp;&l;/li&g;\n  &l;li&g;participate actively and regularly in physical activities and develop movement skills&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Belonging and contributing&a;nbsp;&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;Your child will develop a sense of self. Educators will encourage and support them to reach their full potential. They will develop social skills, self-confidence and a love for learning that they will take with them through school and life.&a;nbsp;&l;/p&g;\n&l;p&g;Your child will develop:&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;a positive understanding of themselves as a person and their unique strengths&a;nbsp;&l;/li&g;\n  &l;li&g;a sense of connectedness to others, to their community and to the natural world&a;nbsp;&l;/li&g;\n  &l;li&g;ways to consider different perspectives and life experiences as well as areas of connection&a;nbsp;&l;/li&g;\n  &l;li&g;understanding of relationships and community and how people contribute to the world around them&a;nbsp;&l;/li&g;\n  &l;li&g;problem-solving skills in social situations&a;nbsp;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;kinder_2026___parent_guide___summary_of_learning__&q;:{&q;system&q;:{&q;id&q;:&q;d16decad-6215-4c7e-909c-91e7ebfa05e9&q;,&q;name&q;:&q;Kinder 2026 - Parent Guide - Support learning&q;,&q;codename&q;:&q;kinder_2026___parent_guide___summary_of_learning__&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-12-16T16:15:51.8468023Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Support your child’s learning &q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;support-child&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;You are your child’s first teacher. You can encourage your child’s natural curiosity and love for learning by helping them connect what they learn in school to what they learn at home.&a;nbsp;&a;nbsp;&l;/p&g;\n&l;h3&g;&l;strong&g;Talk about it!&a;nbsp;&l;/strong&g;&a;nbsp;&l;/h3&g;\n&l;p&g;Be curious and show an interest in what your child is learning – your positivity and excitement can make your child feel positive and excited too.&a;nbsp;&l;/p&g;\n&l;p&g;Talk to your child about:&a;nbsp;&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;day-to-day situations and ask questions that encourage them to share their thoughts and ideas (e.g., “What if?”, “How did you know?”)&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;different ways to solve problems when you or your child experience challenges&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;new words they are learning at school and home and how to use them to describe their experiences and observations&a;nbsp;&l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Be a role model&l;/strong&g;&a;nbsp;&l;/h3&g;\n&l;p&g;You are your child’s most important role model. When your child sees you reading, writing, doing math and thinking through challenges, they will follow your example.&a;nbsp;&l;/p&g;\n&l;h3&g;&l;strong&g;Use your child’s first language&l;/strong&g;&a;nbsp;&l;/h3&g;\n&l;p&g;Your child’s first language is the language they learned first and is often the language(s) spoken at home. For many children in Ontario, this is not English or French. Continuing to use your child’s first language(s) at home, even when they attend an English- or French-speaking school, supports their overall development because skills learned in one language transfer to others.&l;/p&g;\n&l;h3&g;&l;strong&g;Tell stories and read together&l;/strong&g;&a;nbsp;&l;/h3&g;\n&l;p&g;Sharing stories and reading together encourages a love of reading. Set aside regular times for reading with your child. Family and other close community members can share stories with your child. Choose what you’re going to read together and choose from all kinds of books and reading materials. To support your child’s reading in Kindergarten, &l;a href=\&q;https://www.ontario.ca/page/kindergarten#section-2\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;see our storybook options.&l;/a&g;&a;nbsp;&a;nbsp;&a;nbsp;&l;/p&g;\n&l;h3&g;&l;strong&g;Make learning fun&l;/strong&g;&a;nbsp;&l;/h3&g;\n&l;p&g;Get to know your child’s interests and hobbies. This is important because your child is more likely to enjoy learning about what they are interested in. Activities that can be fun and help your child develop key skills like math and science include:&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;puzzles&l;/li&g;\n  &l;li&g;games with dice, playing cards or dot cards&l;/li&g;\n  &l;li&g;dominoes&l;/li&g;\n  &l;li&g;sorting games&l;/li&g;\n  &l;li&g;board games, including board games with numbered squares&l;/li&g;\n  &l;li&g;crafts&l;/li&g;\n  &l;li&g;building&l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Apply learning through everyday family activities&l;/strong&g;&a;nbsp;&l;/h3&g;\n&l;p&g;There are many ways to help your child apply what they are learning in school at home and in the community. Here are activities that you may want to share with your child.&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;Read and talk about signs in the community, such as traffic and store signs.&a;nbsp;&l;/li&g;\n  &l;li&g;Explore and talk about food labels, schedules, maps, instructions, flyers and brochures.&a;nbsp;&l;/li&g;\n  &l;li&g;Find fun and meaningful ways to write together, for example:&a;nbsp;\n    &l;ul&g;\n      &l;li&g;creating greeting cards&a;nbsp;&a;nbsp;&l;/li&g;\n      &l;li&g;making shopping lists&a;nbsp;&l;/li&g;\n      &l;li&g;writing party invitations and gratitude notes&a;nbsp;&l;/li&g;\n      &l;li&g;adding appointments and activities on your family calendar&a;nbsp;&l;/li&g;\n    &l;/ul&g;\n  &l;/li&g;\n  &l;li&g;Have your child count and sort objects such as toys, kitchen utensils, clothing and collections (e.g., stickers, buttons or rocks).&a;nbsp;&l;/li&g;\n  &l;li&g;Play familiar math games, for example:&a;nbsp;&a;nbsp;\n    &l;ul&g;\n      &l;li&g;a number or shape version of I Spy: “I spy something that has the number 5 on it” or “I spy something that is round”&a;nbsp;&a;nbsp;&l;/li&g;\n      &l;li&g;origami&a;nbsp;&l;/li&g;\n      &l;li&g;hopscotch&a;nbsp;&l;/li&g;\n    &l;/ul&g;\n  &l;/li&g;\n&l;/ul&g;\n&l;h3&g;&l;strong&g;Stay informed about your child’s learning&a;nbsp;&l;/strong&g;&a;nbsp;&l;/h3&g;\n&l;p&g;Stay in touch with your child’s school and educators. If you are unsure of your child’s progress or how you can support your child’s learning at home, ask your child’s educator for ideas.&a;nbsp;&l;/p&g;\n&l;p&g;You can also explore some of the learning activities, games and resources that your child’s educators may be using in the classroom, including resources from:&l;/p&g;\n&l;ul&g;\n  &l;li&g;&l;a href=\&q;https://tvolearn.com/pages/kindergarten\&q;&g;TVO Learn&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://onlit.org/kindergarten/\&q;&g;ONlit.org&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://www.ontariosciencecentre.ca/teachers-plus-students/teacher-resources/curriculum-resources\&q;&g;Ontario Science Centre&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://schools.sciencenorth.ca/new-kindergarten-curriculum\&q;&g;Science North&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;kinder_2026___parent_guide___support_learning__cop&q;:{&q;system&q;:{&q;id&q;:&q;95862650-89c8-4dd7-b3e1-7f9f1babd3f4&q;,&q;name&q;:&q;Kinder 2026 - Parent Guide - Related links&q;,&q;codename&q;:&q;kinder_2026___parent_guide___support_learning__cop&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-12-15T14:18:34.8485974Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Related links&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;related-links&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;a href=\&q;https://www.ontario.ca/page/kindergarten\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Kindergarten&l;/a&g;&a;nbsp;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.ontario.ca/page/kindergarten-communication-learning\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Kindergarten communication of learning&l;/a&g;&a;nbsp;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/curriculum/kindergarten\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Kindergarten curriculum&l;/a&g;&a;nbsp;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/transferable-skills/introduction\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Transferable skills&l;/a&g;&a;nbsp;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.ontario.ca/page/your-childs-education-parent-guide-our-school-system\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Parent guide to our school system&a;nbsp;&l;/a&g;&a;nbsp;&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;lang___fra___appendix_a___world_level_reading_and_&q;:{&q;system&q;:{&q;id&q;:&q;f67b244d-824a-4558-ba5e-5f7e7d263c93&q;,&q;name&q;:&q;Kinder - G1 - Continuum - Vocabulary&q;,&q;codename&q;:&q;lang___fra___appendix_a___world_level_reading_and_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-12-08T15:11:22.4340307Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Vocabulary&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;vocabulary&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;lang___fra___appendix_a___vocabulary___definition__bb0311d&q;,&q;lang___fra___appendix_a___word_level___orthographi&q;,&q;lang___fra___appendix_a___vocabulary___networks_an&q;,&q;kinder___g1___continuum___word_level___words_with_&q;,&q;lang___fra___appendix_a___vocabulary___independent&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;lang___fra___appendix_a___vocabulary___definition__bb0311d\&q;&g;&l;/object&g;\n&l;h3&g;&l;strong&g;Networks and features of words&l;/strong&g;&l;/h3&g;\n&l;p&g;&l;strong&g;Knowledge and skills in Kindergarten to Grade 1&l;/strong&g;&l;/p&g;\n&l;p&g;Linking the meanings and features of new words, such as linking semantic features to their existing word schemas&l;/p&g;\n&l;p&g;&l;em&g;In Kindergarten, see&l;/em&g;&l;strong&g; &l;/strong&g;&l;em&g;&l;strong&g;Expectation A1.3&l;/strong&g;&l;/em&g;&l;em&g;; in Grade 1, see&l;/em&g;&l;em&g;&l;strong&g; B2.7.&l;/strong&g;&l;/em&g;&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;lang___fra___appendix_a___word_level___orthographi\&q;&g;&l;/object&g;\n&l;h3&g;&l;strong&g;Independent word-learning strategies&l;/strong&g;&l;/h3&g;\n&l;p&g;&l;strong&g;Knowledge and skills in Kindergarten to Grade 1&l;/strong&g;&l;/p&g;\n&l;p&g;Developing strategies to determine the meaning of words in oral language and text&l;/p&g;\n&l;p&g;&l;em&g;In Kindergarten, see&l;/em&g;&l;strong&g; &l;/strong&g;&l;em&g;&l;strong&g;Expectation A1.3&l;/strong&g;&l;/em&g;&l;em&g;; in Grade 1, see&l;/em&g;&l;em&g;&l;strong&g; B2.7.&l;/strong&g;&l;/em&g;&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;lang___fra___appendix_a___vocabulary___networks_an\&q;&g;&l;/object&g;\n&l;h3&g;&l;strong&g;Tier 2 words&l;/strong&g;&l;/h3&g;\n&l;p&g;&l;em&g;In Kindergarten, see&l;/em&g;&l;strong&g; &l;/strong&g;&l;em&g;&l;strong&g;Expectation A1.3&l;/strong&g;&l;/em&g;&l;em&g;; in Grade 1, see&l;/em&g;&l;em&g;&l;strong&g; B2.7.&l;/strong&g;&l;/em&g;&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;kinder___g1___continuum___word_level___words_with_\&q;&g;&l;/object&g;\n&l;h3&g;&l;strong&g;Applying morphological knowledge&a;nbsp;&l;/strong&g;&l;/h3&g;\n&l;p&g;&l;strong&g;Knowledge and skills in Kindergarten to Grade 1&l;/strong&g;&l;/p&g;\n&l;p&g;Applying an understanding that words are composed of morphemes, which are units of meaning within a word, and using knowledge of morphemes to support learning of the meaning of words&l;/p&g;\n&l;p&g;&l;em&g;In Kindergarten, see&l;/em&g;&l;strong&g; &l;/strong&g;&l;em&g;&l;strong&g;Expectation A1.3&l;/strong&g;&l;/em&g;&l;em&g;; in Grade 1, see&l;/em&g;&l;em&g;&l;strong&g; B2.7.&l;/strong&g;&l;/em&g;&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;lang___fra___appendix_a___vocabulary___independent\&q;&g;&l;/object&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;S