q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What is curriculum?&q;},&q;content_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Content Item&q;,&q;value&q;:[]},&q;child_navigation_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Child Navigation Items&q;,&q;value&q;:[]},&q;include_menu_hierarchy&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Include menu hierarchy&q;,&q;value&q;:[]},&q;internal_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Internal link&q;,&q;value&q;:&q;/en/curriculum-review/what-is&q;},&q;external_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External link&q;,&q;value&q;:&q;&q;},&q;asset&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Asset&q;,&q;value&q;:[]},&q;fragment&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Fragment&q;,&q;value&q;:&q;&q;},&q;is_quick_links&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Is quick links&q;,&q;value&q;:[]},&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;what-is-curriculum&q;},&q;external_link_href&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External Link Href&q;,&q;value&q;:&q;&q;},&q;target&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Target&q;,&q;value&q;:[{&q;name&q;:&q;Self&q;,&q;codename&q;:&q;self&q;}]},&q;redirect_to_url&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Redirect To URL&q;,&q;value&q;:[]},&q;mega_menu_flag&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Flag&q;,&q;value&q;:[]},&q;megamenu_pane_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Layout&q;,&q;value&q;:[]},&q;left_sub_menu_button&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Left Sub Menu Button&q;,&q;value&q;:[]},&q;curriculum_layout_linked_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum Layout Linked Item&q;,&q;value&q;:[]}}}],&q;modular_content&q;:{&q;a___e___assessment_for_learning_and_as_learning&q;:{&q;system&q;:{&q;id&q;:&q;bc5e22db-0484-40ff-96a5-4d5a712dcd48&q;,&q;name&q;:&q;A &a; E - Assessment for Learning and as Learning&q;,&q;codename&q;:&q;a___e___assessment_for_learning_and_as_learning&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-07-17T19:53:53.8544686Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Assessment “for Learning” and “as Learning”&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;assessment-for-learning-and-as-learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___assessment_learning___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___assessment_learning___video_shell\&q;&g;&l;/object&g;\n&l;p&g;Assessment is the process of gathering information that accurately reflects how well a student is achieving the curriculum expectations in a grade or course. The primary purpose of assessment is to improve student learning. Assessment for the purpose of improving student learning is seen as both “assessment &l;em&g;for &l;/em&g;learning” and “assessment &l;em&g;as &l;/em&g;learning”. As part of assessment &l;em&g;for &l;/em&g;learning, teachers provide students with descriptive feedback and coaching for improvement. Teachers engage in assessment &l;em&g;as &l;/em&g;learning by helping all students develop their capacity to be independent, autonomous learners who are able to set individual goals, monitor their own progress, determine next steps, and reflect on their thinking and learning.&l;/p&g;\n&l;p&g;As essential steps in assessment &l;em&g;for &l;/em&g;learning and &l;em&g;as &l;/em&g;learning, teachers need to:&l;/p&g;\n&l;ul&g;\n  &l;li&g;plan assessment concurrently and integrate it seamlessly with instruction;&l;/li&g;\n  &l;li&g;share learning goals and success criteria with students at the outset of learning to ensure that students and teachers have a common and shared understanding of these goals and criteria as learning progresses;&l;/li&g;\n  &l;li&g;gather information about student learning before, during, and at or near the end of a period of instruction, using a variety of assessment strategies and tools;&l;/li&g;\n  &l;li&g;use assessment to inform instruction, guide next steps, and help students monitor their progress towards achieving their learning goals;&l;/li&g;\n  &l;li&g;analyse and interpret evidence of learning;&l;/li&g;\n  &l;li&g;give and receive specific and timely descriptive feedback about student learning;&l;/li&g;\n  &l;li&g;help students to develop skills of peer assessment and self-assessment.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___categories_of_knowledge_and_skills&q;:{&q;system&q;:{&q;id&q;:&q;1f6771c0-20c1-45a3-84e1-7c1730eb94e4&q;,&q;name&q;:&q;A &a; E - Categories of Knowledge and Skills&q;,&q;codename&q;:&q;a___e___categories_of_knowledge_and_skills&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-01-21T15:01:15.7053535Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Categories of Knowledge and Skills&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;categories-of-knowledge-and-skills&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___categories_knowledge_skills___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___categories_knowledge_skills___video_shell\&q;&g;&l;/object&g;\n&l;p&g;The categories represent four broad areas of knowledge and skills within which the expectations for any given subject or course can be organized. The four categories should be considered as interrelated, reflecting the wholeness and interconnectedness of learning.&l;/p&g;\n&l;p&g;The categories help teachers focus not only on students’ acquisition of knowledge but also on their development of the skills of thinking, communication, and application.&l;/p&g;\n&l;p&g;The categories of knowledge and skills are as follows:&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Knowledge and Understanding. &l;/strong&g;&l;/em&g;Subject-specific content acquired in each grade or course (knowledge), and the comprehension of its meaning and significance (understanding).&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Thinking. &l;/strong&g;&l;/em&g;The use of critical and creative thinking skills and/or processes.&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Communication. &l;/strong&g;&l;/em&g;The conveying of meaning and expression through various forms.&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Application. &l;/strong&g;&l;/em&g;The use of knowledge and skills to make connections within and between various contexts.&l;/p&g;\n&l;p&g;In all subjects and courses, students should be given numerous and varied opportunities to demonstrate the full extent of their achievement of the curriculum expectations across all four categories of knowledge and skills.&l;/p&g;\n&l;p&g;Teachers will ensure that student learning is assessed and evaluated in a balanced manner with respect to the four categories, and that achievement of particular expectations is considered within the appropriate categories. The emphasis on “balance” reflects the fact that all categories of the achievement chart are important and need to be a part of the process of instruction, learning, assessment, and evaluation. However, it also indicates that for different courses, the &l;em&g;relative &l;/em&g;importance of each of the categories may vary. The importance accorded to each of the four categories in assessment and evaluation should reflect the emphasis accorded to them in the curriculum expectations for the subject or course and in instructional practice.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___content_standards_and_performance_standard&q;:{&q;system&q;:{&q;id&q;:&q;550741e5-bad5-42b7-81fe-daadb0c1b611&q;,&q;name&q;:&q;A &a; E - Content Standards and Performance Standard&q;,&q;codename&q;:&q;a___e___content_standards_and_performance_standard&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-07-18T17:22:44.6698057Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Content Standards and Performance Standards&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;content-standards-and-performance-standards&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___content_standards___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___content_standards___video_shell\&q;&g;&l;/object&g;\n&l;p&g;The Ontario curriculum for Grades 1 to 12 comprises &l;em&g;content standards &l;/em&g;and &l;em&g;performance standards&l;/em&g;. Assessment and evaluation will be based on both the content standards and the performance standards.&l;/p&g;\n&l;p&g;The content standards are the overall and specific curriculum expectations given in the curriculum for every subject and discipline.&l;/p&g;\n&l;p&g;The performance standards are outlined in the achievement chart, also provided in the curriculum for every subject and discipline (each achievement chart is specific to the subject/discipline; see the &l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/assessment-evaluation/sample-achievement-charts\&q;&g;sample charts provided&l;/a&g;). The achievement chart is a standard province-wide guide and is to be used by all teachers as a framework for assessing and evaluating student achievement of the expectations in the particular subject or discipline. It enables teachers to make consistent judgements about the quality of student learning, based on clear performance standards and on a body of evidence collected over time. It also provides teachers with a foundation for developing clear and specific feedback for students and parents.&l;/p&g;\n&l;p&g;The purposes of the achievement chart are to:&l;/p&g;\n&l;ul&g;\n  &l;li&g;provide a common framework that encompasses all curriculum expectations for all subjects/courses across the grades;&l;/li&g;\n  &l;li&g;guide the development of high-quality assessment tasks and tools (including rubrics);&l;/li&g;\n  &l;li&g;help teachers plan instruction for learning;&l;/li&g;\n  &l;li&g;provide a basis for consistent and meaningful feedback to students in relation to provincial content and performance standards;&l;/li&g;\n  &l;li&g;establish categories and criteria for assessing and evaluating students’ learning.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___criteria_and_descriptors&q;:{&q;system&q;:{&q;id&q;:&q;34c6a523-a636-4e13-ab06-378c3c4737d1&q;,&q;name&q;:&q;A &a; E - Criteria and Descriptors&q;,&q;codename&q;:&q;a___e___criteria_and_descriptors&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-01-21T15:08:41.4423394Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Criteria and Descriptors&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;criteria-and-descriptors&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___criterias_descriptors___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___criterias_descriptors___video_shell\&q;&g;&l;/object&g;\n&l;p&g;To further guide teachers in their assessment and evaluation of student learning, the achievement chart provides “criteria” and “descriptors”.&l;/p&g;\n&l;p&g;A set of criteria is identified for each category in the achievement chart. The criteria are subsets of the knowledge and skills that define the category. The criteria identify the aspects of student performance that are assessed and/or evaluated, and they serve as a guide to what teachers look for. Each curriculum has subject- or discipline-specific criteria and descriptors. For example, in the English curriculum, in the Knowledge and Understanding category, the criteria are “knowledge of content” and “understanding of content”. The former includes examples such as forms of text and elements of style, and the latter includes examples such as relationships among facts. “Descriptors” indicate the characteristics of the student’s performance, with respect to a particular criterion, on which assessment or evaluation is focused. &l;em&g;Effectiveness&l;/em&g; is the descriptor used for each of the criteria in the Thinking, Communication, and Application categories. What constitutes effectiveness in any given performance task will vary with the particular criterion being considered. Assessment of effectiveness may therefore focus on a quality such as appropriateness, clarity, accuracy, precision, logic, relevance, significance, fluency, flexibility, depth, or breadth, as appropriate for the particular criterion.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___evaluation&q;:{&q;system&q;:{&q;id&q;:&q;119ff59b-25d7-4617-9483-4c201af5926f&q;,&q;name&q;:&q;A &a; E - Evaluation&q;,&q;codename&q;:&q;a___e___evaluation&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-06-30T15:55:16.504115Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Evaluation&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;evaluation&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{&q;04c00e1b-aa61-4239-9ce0-45abe84cbf7f&q;:{&q;codename&q;:&q;math___hpe___sel_assessment___fn1&q;,&q;type&q;:&q;footnotes&q;,&q;url_slug&q;:&q;&q;}},&q;modular_content&q;:[&q;a_e___evaluation___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___evaluation___video_shell\&q;&g;&l;/object&g;\n&l;p&g;Evaluation refers to the process of judging the quality of student learning on the basis of established performance standards, and assigning a value to represent that quality. Evaluation accurately summarizes and communicates to parents, other teachers, employers, institutions of further education, and students themselves what students know and can do with respect to the overall curriculum expectations. Evaluation is based on assessment &l;em&g;of &l;/em&g;learning that provides evidence of student achievement at strategic times throughout the course, often at the end of a period of learning.&l;/p&g;\n&l;p&g;All curriculum expectations must be accounted for in instruction and assessment, but &l;em&g;evaluation focuses on students’ achievement of the &l;/em&g;&l;a data-item-id=\&q;04c00e1b-aa61-4239-9ce0-45abe84cbf7f\&q; href=\&q;\&q;&g;&l;em&g;overall expectations&l;/em&g;&l;/a&g;. Each student’s achievement of the overall expectations is evaluated on the basis of the student’s achievement of related specific expectations. The overall expectations are broad in nature, and the specific expectations define the particular content or scope of the knowledge and skills referred to in the overall expectations. Teachers will use their professional judgement to determine which specific expectations should be used to evaluate achievement of the overall expectations, and which ones will be accounted for in instruction and assessment but not necessarily evaluated.&l;/p&g;\n&l;p&g;Determining a report card grade involves the interpretation of evidence collected through observations, conversations, and student products (tests/exams, assignments for evaluation), combined with the teacher’s professional judgement and consideration of factors such as the number of tests/exams or assignments for evaluation that were not completed or submitted and the fact that some evidence may carry greater weight than other evidence.&l;/p&g;\n&l;h4&g;&l;strong&g;Secondary&l;/strong&g;&l;/h4&g;\n&l;p&g;Ontario’s mandatory assessment and evaluation requirements for secondary students are intended to provide a more consistent approach to assessment and evaluation for students in Grades&a;nbsp;9&a;nbsp;to&a;nbsp;12, while continuing to support all students to reach their full potential, prepare students for their pathways after high school, and support student well-being.&l;/p&g;\n&l;p&g;Beginning in the 2026-2027&a;nbsp;school&a;nbsp;year, most secondary courses will require written exams as a percentage of the final course mark. All written final exams from Grades&a;nbsp;9&a;nbsp;to&a;nbsp;12 will take place during the designated exam period, with the exception of the&a;nbsp;&l;a href=\&q;https://www.ontario.ca/page/growing-success-assessment-evaluation-and-reporting-ontario-schools-kindergarten-grade-12#September2026\&q; data-new-window=\&q;true\&q; title=\&q;https://www.ontario.ca/page/growing-success-assessment-evaluation-and-reporting-ontario-schools-kindergarten-grade-12#September2026\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;EQAO&a;nbsp;Grade 9 mathematics assessment&l;/a&g;.&l;/p&g;\n&l;p&g;For more information on the mandatory assessment and evaluation requirements for students in Grades 9 to 12, please visit&a;nbsp;&l;a href=\&q;https://www.ontario.ca/page/growing-success-assessment-evaluation-and-reporting-ontario-schools-kindergarten-grade-12#assessment2026\&q; data-new-window=\&q;true\&q; title=\&q;https://www.ontario.ca/page/growing-success-assessment-evaluation-and-reporting-ontario-schools-kindergarten-grade-12#assessment2026\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Ontario.ca&l;/a&g;.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[&q;assessment___evaluation_page&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___fundamental_principles&q;:{&q;system&q;:{&q;id&q;:&q;a4f9881e-dcb1-4156-a708-9e5bf60d80f9&q;,&q;name&q;:&q;A &a; E - Fundamental Principles&q;,&q;codename&q;:&q;a___e___fundamental_principles&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-07-12T17:50:02.9775042Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Fundamental Principles&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;fundamental-principles&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___fundamental_principles___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___fundamental_principles___video_shell\&q;&g;&l;/object&g;\n&l;p&g;&l;em&g;The primary purpose of assessment and evaluation is to improve student learning.&l;/em&g;&l;/p&g;\n&l;p&g;The seven fundamental principles given below (excerpted from &l;em&g;Growing Success, &l;/em&g;page 6) lay the foundation for rich and challenging practice. When these principles are fully understood and observed by all teachers, they will guide the collection of meaningful information that will help inform instructional decisions, promote student engagement, and improve student learning.&l;/p&g;\n&l;p&g;To ensure that assessment, evaluation, and reporting are valid and reliable, and that they lead to the improvement of learning for all students, teachers use practices and procedures that:&l;/p&g;\n&l;ul&g;\n  &l;li&g;are fair, transparent, and equitable;&l;/li&g;\n  &l;li&g;support all students, including those with special education needs, those who are learning the language of instruction (English or French), and those who are First Nation, Métis, or Inuit;&l;/li&g;\n  &l;li&g;are carefully planned to relate to the curriculum expectations and learning goals and, as much as possible, to the interests, learning styles and preferences, needs, and experiences of all students;&l;/li&g;\n  &l;li&g;are communicated clearly to students and parents at the beginning of the school year or course and at other appropriate points throughout the school year or course;&l;/li&g;\n  &l;li&g;are ongoing, varied in nature, and administered over a period of time to provide multiple opportunities for students to demonstrate the full range of their learning;&l;/li&g;\n  &l;li&g;provide ongoing descriptive feedback that is clear, specific, meaningful, and timely to support improved learning and achievement;&l;/li&g;\n  &l;li&g;develop students’ self-assessment skills to enable them to assess their own learning, set specific goals, and plan next steps for their learning.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___fundamental_principles__copy_&q;:{&q;system&q;:{&q;id&q;:&q;0fca21f3-2123-456e-89c6-adb566b2c9d5&q;,&q;name&q;:&q;A &a; E - CRRP&q;,&q;codename&q;:&q;a___e___fundamental_principles__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-12T20:17:09.3120464Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Culturally Responsive and Relevant Assessment and Evaluation&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;crrp-ae&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/program-planning/considerations-for-program-planning/human-rights-equity-and-inclusive-education\&q;&g;Culturally responsive and relevant pedagogy (CRRP)&l;/a&g; reflects and affirms students’ cultural and social identities, languages, and family structures. It involves careful acknowledgement, respect, and understanding of the similarities and differences among students, and between students and teachers, in order to respond effectively to student thinking and promote student learning.&l;/p&g;\n&l;p&g;Engaging in assessment from a CRRP stance requires that teachers gain awareness of and reflect on their own beliefs about who a learner is and what they can achieve (see the questions for consideration provided below). In this process, teachers engage in continual self-reflection – and the critical analysis of various data – to understand and address the ways in which teacher identity and bias affect the assessment and evaluation of student learning. Assessment from a CRRP stance starts with having a deep knowledge of every student and an understanding of how they learn best.&l;/p&g;\n&l;p&g;The primary purpose of assessment is to improve student learning. Assessment &l;em&g;for&l;/em&g; learning creates opportunities for teachers to intentionally learn about each student and their sociocultural and linguistic background in order to gather a variety of evidence about their learning in a way that is reflective of and responsive to each student’s strengths, experiences, interests, and cultural ways of knowing. Ongoing descriptive feedback and responsive coaching are essential for improving student learning.&l;/p&g;\n&l;p&g;Teachers engage in assessment &l;em&g;as&l;/em&g; learning by creating ongoing opportunities for all students to develop their capacity to be confident, independent, autonomous learners who set individual goals, monitor their own progress, determine next steps, and reflect on their thinking and learning in relation to learning goals and curriculum expectations. One way in which teachers differentiate assessment is by providing tasks that allow multiple entry points for all students and that enable all students to design and create personally meaningful assignments, projects, performances, and other demonstrations of their learning.&l;/p&g;\n&l;p&g;Assessment &l;em&g;of&l;/em&g; learning is used by the teacher to summarize student learning at a given point in time. This summary is used to make judgements about the quality of student learning on the basis of established criteria, to assign a value to represent that quality, and to support the communication of information about achievement to each student and to parents, teachers, and others.&l;/p&g;\n&l;p&g;The evidence that is collected about student learning, including through observations and conversations as well as student products, should reflect and affirm the student’s lived experiences within their school, home, and community, their learning strengths, and their knowledge of concepts and skills. This process of triangulating evidence of student learning allows teachers to improve their understanding of how each student is progressing in their learning.&l;/p&g;\n&l;p&g;When teachers engage in the process of examining their own biases regarding classroom assessment and evaluation practices, they might consider some of the following questions:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Are the tasks accessible to, and inclusive of, all learners? Do the tasks include appropriate and varied entry points for all students?&l;/li&g;\n  &l;li&g;Do the tasks connect to students&s; prior learning and give them opportunities to be sense makers and to integrate their new learning? Do the selected tasks reflect students’ identities and lived experiences?&l;/li&g;\n  &l;li&g;Do all students have equitable access to the tools they need to complete the tasks being set?&l;/li&g;\n  &l;li&g;What opportunities can teachers build into their practice to offer students descriptive feedback to enhance learning? Are graded assessment tasks used in a way that complements the use of descriptive feedback for growth?&l;/li&g;\n  &l;li&g;How can information be conveyed about students’ learning progress to students and parents in an ongoing and meaningful way?&l;/li&g;\n  &l;li&g;What is the purpose of assigning and grading a specific task or activity? Are student choice and agency considered?&l;/li&g;\n  &l;li&g;How do teacher biases influence decisions about what tasks or activities are chosen for assessment?&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___introduction&q;:{&q;system&q;:{&q;id&q;:&q;50892b83-8a58-4972-87a2-4d22d94d75fc&q;,&q;name&q;:&q;A &a; E - Introduction&q;,&q;codename&q;:&q;a___e___introduction&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-07-18T17:19:53.500082Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;introduction&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{&q;5cde0df7-cf64-453d-85dd-69e3b44a8be5&q;:{&q;codename&q;:&q;parents___fn1&q;,&q;type&q;:&q;footnotes&q;,&q;url_slug&q;:&q;&q;},&q;20e8c0e7-96e1-44e1-b2cd-861639b2c1b9&q;:{&q;codename&q;:&q;assessment___fn1&q;,&q;type&q;:&q;footnotes&q;,&q;url_slug&q;:&q;&q;}},&q;modular_content&q;:[&q;a_e___intro___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___intro___video_shell\&q;&g;&l;/object&g;\n&l;p&g;&l;a href=\&q;https://www.ontario.ca/page/growing-success-assessment-evaluation-and-reporting-ontario-schools-kindergarten-grade-12\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;Growing Success: Assessment, Evaluation, and Reporting in Ontario Schools, First Edition, Covering Grades 1 to 12, 2010&l;/em&g;&l;/a&g;&l;em&g; &l;/em&g;sets out the Ministry of Education’s assessment, evaluation, and reporting policy. The policy aims to maintain high standards, improve student learning, and benefit students, &l;a data-item-id=\&q;5cde0df7-cf64-453d-85dd-69e3b44a8be5\&q; href=\&q;\&q;&g;parents&l;/a&g;, and teachers in elementary and secondary schools across the&a;nbsp;province. Successful implementation of this policy depends on the &l;a data-item-id=\&q;20e8c0e7-96e1-44e1-b2cd-861639b2c1b9\&q; href=\&q;\&q;&g;professional judgement&l;/a&g;&a;nbsp;of&a;nbsp;educators at all levels as well as on their ability to work together and to build trust and confidence among parents and students.&l;/p&g;\n&l;p&g;A brief summary of some major aspects of the current assessment, evaluation, and reporting policy is given below. Teachers should refer to &l;em&g;Growing Success &l;/em&g;for more detailed information.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___learning_skills_and_work&q;:{&q;system&q;:{&q;id&q;:&q;bdbe2f48-4281-4b11-b96d-bf8aece838b0&q;,&q;name&q;:&q;A &a; E - Learning Skills and Work&q;,&q;codename&q;:&q;a___e___learning_skills_and_work&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-01-20T16:52:01.7742617Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Learning Skills and Work Habits&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;learning-skills-and-work-habits&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___learning_skills_and_work___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___learning_skills_and_work___video_shell\&q;&g;&l;/object&g;\n&l;p&g;The development of learning skills and work habits is an integral part of a student’s learning. To the extent possible, however, the evaluation of learning skills and work habits, apart from any that may be included as part of a curriculum expectation in a course, should &l;em&g;not &l;/em&g;be considered in the determination of a student’s grades. Assessing, evaluating, and reporting on the achievement of curriculum expectations and on the demonstration of learning skills and work habits &l;em&g;separately &l;/em&g;allows teachers to provide information to the parents and student that is specific to each of these two areas.&l;/p&g;\n&l;p&g;The six learning skills and work habits are responsibility, organization, independent work, collaboration, initiative, and self-regulation.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___levels_of_achievement&q;:{&q;system&q;:{&q;id&q;:&q;cbe17d7e-c4c3-40ff-ac92-1af5438afd8b&q;,&q;name&q;:&q;A &a; E - Levels of Achievement&q;,&q;codename&q;:&q;a___e___levels_of_achievement&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-01-21T15:18:54.1078569Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Levels of Achievement&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;levels-of-achievement&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___levels_of_achievement___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___levels_of_achievement___video_shell\&q;&g;&l;/object&g;\n&l;p&g;The achievement chart also identifies four levels of achievement, defined as follows:&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Level 1 &l;/strong&g;&l;/em&g;represents achievement that falls much below the provincial standard. The student demonstrates the specified knowledge and skills with limited effectiveness. Students must work at significantly improving in specific areas, as necessary, if they are to be successful in a subject or course in the next grade.&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Level 2 &l;/strong&g;&l;/em&g;represents achievement that approaches the standard. The student demonstrates the specified knowledge and skills with some effectiveness. Students performing at this level need to work on identified learning gaps to ensure future success.&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Level 3 &l;/strong&g;&l;/em&g;represents the provincial standard for achievement. The student demonstrates the specified knowledge and skills with considerable effectiveness. Parents of students achieving at level 3 can be confident that their children will be prepared for work in subsequent grades or courses.&l;/p&g;\n&l;p&g;&l;em&g;&l;strong&g;Level 4 &l;/strong&g;&l;/em&g;identifies achievement that surpasses the provincial standard. The student demonstrates the specified knowledge and skills with a high degree of effectiveness. &l;em&g;However, achievement at level 4 does not mean that the student has achieved expectations beyond those specified for the grade or course.&l;/em&g;&l;/p&g;\n&l;p&g;Specific “qualifiers” are used with the descriptors in the achievement chart to describe student performance at each of the four levels of achievement – the qualifier &l;em&g;limited &l;/em&g;is used for level 1; &l;em&g;some &l;/em&g;for level 2; &l;em&g;considerable &l;/em&g;for level 3; and &l;em&g;a high degree of &l;/em&g;or &l;em&g;thorough &l;/em&g;for level 4. Hence, achievement at level 3 in the Thinking category for the criterion “use of planning skills” would be described in the achievement chart as “[The student] uses planning skills with &l;em&g;considerable &l;/em&g;effectiveness”.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___reporting_student_achievement&q;:{&q;system&q;:{&q;id&q;:&q;2af0c613-d1cb-4958-8a95-00ceb410771a&q;,&q;name&q;:&q;A &a; E - Reporting Student Achievement&q;,&q;codename&q;:&q;a___e___reporting_student_achievement&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-07-21T17:53:28.6418627Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Reporting Student Achievement &q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;reporting-student-achievement&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___reporting___video_shell&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___reporting___video_shell\&q;&g;&l;/object&g;\n&l;h4&g;&l;strong&g;Elementary&l;/strong&g;&l;/h4&g;\n&l;p&g;Three formal report cards are issued in Ontario’s publicly funded elementary schools, as described below.&l;/p&g;\n&l;p&g;The Elementary Progress Report Card shows a student’s development of learning skills and work habits during the fall of the school year, as well as the student’s general progress in working towards achievement of the curriculum expectations in each subject (reported as “progressing very well”, “progressing well”, or “progressing with difficulty”).&l;/p&g;\n&l;p&g;The Elementary Provincial Report Card shows a student’s achievement at specific points in the school year. The first Provincial Report Card reflects student achievement of the overall curriculum expectations introduced and developed from September to January/February of the school year, as well as the student’s development of learning skills and work habits during that period. The second reflects achievement of curriculum expectations introduced or further developed from January/February to June, as well as further development of learning skills and work habits during that period. The Provincial Report Card for Grades 1–6 uses letter grades; the report card for Grades 7 and 8 uses percentage grades.&l;/p&g;\n&l;h4&g;&l;strong&g;Secondary&l;/strong&g;&l;/h4&g;\n&l;p&g;The Provincial Report Card, Grades 9–12, shows a student’s achievement at specific points in the school year or semester. There are two formal reporting periods for a semestered course and three formal reporting periods for a non-semestered course. The reports reflect student achievement of the overall curriculum expectations, as well as development of learning skills and work habits.&l;/p&g;\n&l;h4&g;&l;strong&g;Communication with parents and students&l;/strong&g;&l;/h4&g;\n&l;p&g;Although there are formal reporting periods, communication with parents and students about student achievement should be continuous throughout the year or course, by a variety of means, such as parent-teacher or parent-student-teacher conferences, portfolios of student work, student-led conferences, interviews, phone calls, checklists, and informal reports. Communication about student achievement should be designed to provide detailed information that will encourage students to set goals for learning, help teachers to establish plans for teaching, and assist parents in supporting learning at home.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;a___e___sample_achievement_charts&q;:{&q;system&q;:{&q;id&q;:&q;5153d1b4-6d93-4f12-9c42-9dd0519180de&q;,&q;name&q;:&q;A &a; E - Sample Achievement Charts&q;,&q;codename&q;:&q;a___e___sample_achievement_charts&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-07-18T17:24:27.8219553Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Sample Achievement Charts&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;sample-achievement-charts&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;a_e___sample_achievement_charts___video_shell&q;,&q;elementary___hpe___achievement_chart__copy__3993729&q;,&q;elementary___arts___achievement_chart__copy_&q;,&q;glc2o___achievement_chart__copy_&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;a_e___sample_achievement_charts___video_shell\&q;&g;&l;/object&g;\n&l;p&g;Three samples of the achievement chart are provided, from the following subjects/disciplines:&l;/p&g;\n&l;ul&g;\n  &l;li&g;The Arts, Grades 1–8&l;/li&g;\n  &l;li&g;Science and Technology, Grades 1–8&l;/li&g;\n  &l;li&g;English, Grades 11 and 12&l;/li&g;\n&l;/ul&g;\n&l;p&g;These three samples illustrate the consistent characteristics of the performance standards across all subjects and disciplines and across all grades. The samples also illustrate how the achievement chart varies – particularly with respect to the examples provided for the criteria in each category – to reflect the nature of the particular subject or discipline. For instance, the examples for the criterion “Application of knowledge and skills” in the Application category of the achievement chart for the arts include performance skills, composition, and choreography, whereas those for science and technology include investigation skills and safe use of equipment and technology.&l;/p&g;\n&l;p&g;As discussed in the preceding sections, the achievement chart identifies four categories of knowledge and skills and four levels of achievement in the particular subject/discipline.&l;/p&g;\n&l;p&g;&l;br&g;&l;/p&g;\n&l;h4&g;The Achievement Chart for The Arts, Grades 1–8&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;elementary___hpe___achievement_chart__copy__3993729\&q;&g;&l;/object&g;\n&l;h4&g;The Achievement Chart for Science and Technology, Grades 1–8&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;elementary___arts___achievement_chart__copy_\&q;&g;&l;/object&g;\n&l;h4&g;The Achievement Chart for English, Grades 11 and 12&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;glc2o___achievement_chart__copy_\&q;&g;&l;/object&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;about_ontario&q;:{&q;system&q;:{&q;id&q;:&q;50a3b526-071d-4b9d-af89-7af38fe6e625&q;,&q;name&q;:&q;About Ontario&q;,&q;codename&q;:&q;about_ontario&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___navigation_item&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2020-09-02T14:37:54.5088141Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;