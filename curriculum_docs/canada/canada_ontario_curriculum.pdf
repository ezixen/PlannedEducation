blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;The Ontario Curriculum, Grades 11 and 12: Technological Education, 2009&l;/em&g;&l;/a&g;. All references to Grades 9 and 10 that appear in that document have been superseded.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___tech_ed___revision_history_1&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Le curriculum de l’Ontario, 9ᵉ et 10ᵉ année – Éducation technologique, 2024 et Le curriculum de l’Ontario, 11ᵉ et 12ᵉ année – Éducation technologique, 2009.&l;/p&g;&q;}}},&q;ssh___discipline_filters&q;:{&q;system&q;:{&q;id&q;:&q;9a9230ad-ce8b-4971-8d9d-93438401cd25&q;,&q;name&q;:&q;SSH - Discipline Filters&q;,&q;codename&q;:&q;ssh___discipline_filters&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___available_filters___curriculum_disciplines&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2021-05-31T18:58:01.9136493Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;label&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Label&q;,&q;value&q;:&q;Disciplines&q;},&q;site___curriculum_disciplines&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Curriculum Disciplines&q;,&q;taxonomy_group&q;:&q;site___curriculum_disciplines&q;,&q;value&q;:[{&q;name&q;:&q;Equity Studies&q;,&q;codename&q;:&q;equity_studies&q;},{&q;name&q;:&q;Family Studies&q;,&q;codename&q;:&q;family_studies&q;},{&q;name&q;:&q;General Social Sciences&q;,&q;codename&q;:&q;general_social_sciences&q;},{&q;name&q;:&q;Philosophy&q;,&q;codename&q;:&q;philosophy&q;},{&q;name&q;:&q;World Religions&q;,&q;codename&q;:&q;world_re