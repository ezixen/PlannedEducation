  transition: none !important;
  transform: none !important;
  position: inherit !important;
}

.no-overlay .header__bottom {
  z-index: 777;
}

.header__top {
  background: #000;
  color: #fff;
  height: 48px;
}

.header__bottom {
  background: #fff;
  height: 60px;
}

.header__logo-link {
  display: inline-block;
  padding: 12px 0;
  height: 24px;
}

.header__logo-link, .header__logo-link:hover, .header__logo-link:focus, .header__logo-link:active, .header__logo-link:visited {
  background: none;
}

.header__logo-link img {
  width: auto;
  height: 100%;
}

.header__navigation {
  box-shadow: 0 5px 15px 0 rgba(0, 0, 0, 0.09);
  background-color: #ffffff;
}

.header__navigation-beta[mat-stroked-button].mat-stroked-button {
  margin: 0 0 0 calc(36px / 4);
  padding: 4px 5px;
  font-size: 12px;
  line-height: 1;
  color: #50565e;
  border-radius: calc(8px / 2);
  border: solid 1px #8C95A6;
  height: auto;
  min-width: 20px;
}

.header__navigation-beta[mat-stroked-button].mat-stroked-button:focus, .header__navigation-beta[mat-stroked-button].mat-stroked-button:hover, .header__navigation-beta[mat-stroked-button].mat-stroked-button:active {
  background: #f4f5f7;
}

.header__search-bar {
  width: 90%;
  margin-right: 16px;
}

.header__top .mat-badge-small.mat-badge-overlap.mat-badge-after .mat-badge-content.mat-badge-active {
  top: 4px;
  right: 4px;
  width: 12px;
  height: 12px;
  line-height: 12px;
}

.small-margin-right {
  margin-right: calc(8px / 2);
}

a.header__navigation__link {
  text-decoration: none;
  color: black;
}

a.header__navigation__link .mat-title {
  font-size: 1.65rem;
  margin-bottom: 0 !important;
}

.skip-nav__link {
  position: absolute;
  margin: 0;
  padding: 0 36px;
  z-index: 7777777;
  left: 0;
  transition: top 0.3s cubic-bezier(0.35, 0, 0.25, 1);
}

.skip-nav__link span {
  display: inline-block;
  line-height: 49px !important;
}

.skip-nav__link.hide {
  top: -10000px;
}

.skip-nav__link.show {
  top: 0;
  right: 0;
}

.skip-nav__link, .skip-nav__link:visited, .skip-nav__link:focus, .skip-nav__link:hover {
  background: #0473b4;
  color: white;
  text-decoration: none;
}

.login-avatar {
  height: 32px;
  width: 32px;
  background-color: #0473b4;
  border-radius: 16px;
  line-height: 32px;
}

.login-avatar > span {
  font-size: 15px !important;
  font-weight: 800 !important;
}

.mat-mini-fab.login-mobile-avatar {
  height: 32px;
  width: 32px;
  line-height: 32px;
}

