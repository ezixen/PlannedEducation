ubject&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Subject&q;,&q;taxonomy_group&q;:&q;rp___resource___subject&q;,&q;value&q;:[{&q;name&q;:&q;Technological Education&q;,&q;codename&q;:&q;technological_education&q;}]},&q;rp___resource___topic&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Topic&q;,&q;taxonomy_group&q;:&q;rp___resource___topic&q;,&q;value&q;:[]},&q;site___grade&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Grade&q;,&q;taxonomy_group&q;:&q;site___grade&q;,&q;value&q;:[]},&q;rp___developed_by&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Developed By&q;,&q;taxonomy_group&q;:&q;rp___developed_by&q;,&q;value&q;:[{&q;name&q;:&q;Ministry of Education&q;,&q;codename&q;:&q;ministry_of_education&q;}]},&q;rp___audience&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Audience&q;,&q;taxonomy_group&q;:&q;rp___audience&q;,&q;value&q;:[{&q;name&q;:&q;Teachers&q;,&q;codename&q;:&q;teachers&q;}]}}},&q;tech_ed___context___program___g9_10_tables&q;:{&q;system&q;:{&q;id&q;:&q;dbe9866d-dcb0-4bc0-a9da-16bef2e4ab4e&q;,&q;name&q;:&q;Tech Ed - BBT tables&q;,&q;codename&q;:&q;tech_ed___context___program___g9_10_tables&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-05-23T11:57:41.0648754Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;untitled_content_item_afb8592&q;],&q;value&q;:&q;&l;p&g;The technological education courses in Grades 9 and 10 are hands-on, project-based courses. They focus on the exploration of industry-specific concepts and topics, foundational technological skills and applications, and career paths.&l;/p&g;\n&l;p&g;The technological education curriculum in Grades 9–12 encompasses ten subject areas, referred to as broad-based technology subjects. They are:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Communications Technology&l;/li&g;\n  &l;li&g;Computer Technology&l;/li&g;\n  &l;li&g;Construction Technology&l;/li&g;\n  &l;li&g;Green Industries&l;/li&g;\n  &l;li&g;Hairstyling and Aesthetics&l;/li&g;\n  &l;li&g;Health Care&l;/li&g;\n  &l;li&g;Hospitality and Tourism&l;/li&g;\n  &l;li&g;Manufacturing Technology&l;/li&g;\n  &l;li&g;Technological Design&l;/li&g;\n  &l;li&g;Transportation Technology&l;/li&g;\n&l;/ul&g;\n&l;p&g;The Grade 9 and 10 courses titled Technology and the Skilled Trades (&l;a href=\&q;/en/curriculum/technological-education/courses/tas1o/strands\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;TAS1O&l;/a&g; and &l;a href=\&q;/en/curriculum/technological-education/courses/tas2o/strands\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;TAS2O&l;/a&g;) are intended to provide students with exposure to a variety of industries. This delivery model enables students to work on projects that encompass several different technological areas, using a range of equipment and resources suited to the various areas.&l;/p&g;\n&l;p&g;Schools may choose to offer courses in Grade 9 or 10 that are focused on a single broad-based technology area, known as focus courses. These courses can be made available in both Grade 9 and 10 and across all 10 broad-based technology areas.&l;/p&g;\n&l;p&g;To support educators in planning for learning in the context of the various broad-based technology areas using either delivery model, the table below provides a sampling of industry-specific concepts, skills, and careers. The examples provided are not a complete list, nor are they intended to be mandatory learning for students.&l;/p&g;\n&l;p&g;&l;strong&g;Examples by Broad-based Technology Area&l;/strong&g;&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;untitled_content_item_afb8592\&q;&g;&l;/object&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;tech_ed___disciplines_filter&q;:{&q;system&q;:{&q;id&q;:&q;dccf131c-807c-411a-8c4b-81053dc6ad58&q;,&q;name&q;:&q;Tech Ed - Disciplines filter&q;,&q;codename&q;:&q;tech_ed___disciplines_filter&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___available_filters___curriculum_disciplines&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-01T10:54:30.6556132Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},