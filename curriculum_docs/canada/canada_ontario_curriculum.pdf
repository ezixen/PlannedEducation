:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;À l’exception du cours Exploration de carrière, 10ᵉ année (GLC2O) révisé en 2024, le programme-cadre d’orientation et de formation au cheminement de carrière de 9ᵉ et 10ᵉ année, ainsi que celui de 11ᵉ et 12ᵉ année de 2006 restent en vigueur. Tous les autres cours continueront d’être fondés sur les attentes et les contenus d’apprentissage décrits dans ces documents.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;secondary___guidance_and_career_ed___revision_hist&q;,&q;secondary___guidance_and_career_ed___revision_hist_7d2cfd3&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum, Grades 9 to 12: Guidance and Career Education&l;/em&g;&l;/p&g;&q;}}},&q;secondary___ind_lang___overview_home__copy_&q;:{&q;system&q;:{&q;id&q;:&q;41cc45a0-850d-453f-8004-dc8e0e4a0d94&q;,&q;name&q;:&q;Tech Ed - Overview Home (TEMP)&q;,&q;codename&q;:&q;secondary___ind_lang___overview_home__copy_&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-01-25T20:34:48.5645873Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Accueil&q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&