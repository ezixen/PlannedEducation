_copy_&q;,&q;ele___lang___fra___g1_8_strand_a_pdf__2023___copy_&q;,&q;ele___lang___fra___g1_8_strand_b_pdf__2023___copy_&q;,&q;ele___lang___fra___g1_8_strand_c_pdf__2023___copy_&q;,&q;ele___lang___fra___g1_8_strand_d_pdf__2023___copy_&q;,&q;kinder___lang___fra___k_4_language_continuum&q;,&q;lang___fra___appendix_b_pdf&q;,&q;lang___fra___appendix_b_pdf__1_3fr___copy_&q;,&q;fra___appendix_b_pdf__4_6___copy_&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;Les définitions fournies dans ce glossaire sont propres au contexte du programme-cadre&a;nbsp;dans lequel les termes sont utilisés.&l;/em&g;&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2023&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ce programme-cadre est destiné aux écoles de langue française; il remplace &l;em&g;Le curriculum de l’Ontario de la 1&l;/em&g;&l;em&g;&l;sup&g;re&l;/sup&g;&l;/em&g;&l;em&g; à la 8&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année&a;nbsp;– Français&l;/em&g; (2006). À partir de septembre&a;nbsp;2023, tous les programmes de français de la 1&l;sup&g;re&l;/sup&g; à la 8&l;sup&g;e&l;/sup&g; année seront fondés sur les attentes et les contenus d’apprentissage présentés dans ce programme-cadre.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;ele___lang___fra___revision_history_1&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The Ontario Curriculum, Grades 1–8: Language, 2023&l;/em&g;&l;/p&g;&q;}}},&q;ele___lang___fra___disclaimer__copy__7c9b6bc&q;:{&q;system&q;:{&q;id&q;:&q;7c9b6bc8-8ce4-46b0-988a-658e95ac5a4b&q;,&q;name&q;:&q;Sec - ENG - FRA - Disclaimer&q;,&q;codename&q;:&q;ele___lang___fra___disclaimer__copy__7c9b6bc&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-15T17:27:58.5408599Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Le personnel enseignant doit savoir qu’à l’exception du cours de français de 9&l;sup&g;e&l;/sup&g; année de 2023 (FRL1W), le programme-cadre de français de 10&l;sup&g;e&l;/sup&g; année de 2007 et le programme-cadre de français de 11&l;sup&g;e &l;/sup&g;et 12&l;sup&g;e&l;/sup&g; année de 2007 restent en vigueur. Tous les cours de français de la 10&l;sup&g;e&l;/sup&g; à la 12&l;sup&g;e&l;/sup&g; année continuent d’être fondés sur ces documents. Toutes les références à la 9&l;sup&g;e&l;/sup&g; année qui apparaissent dans &l;em&g;Le curriculum de l’Ontario – Français, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année, édition révisée&l;/em&g;, 2007 et &l;em&g;Le curriculum de l’Ontario – Français, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année, édition révisée, 2007&l;/em&g; ont été remplacées par &l;em&g;Le curriculum de l’Ontario – Français, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année&l;/em&g; (2023). À partir de septembre 2023, le nouveau cours décloisonné remplacera le cours Français, 9&l;sup&g;e&l;/sup&g; année, cours théorique (FRA1D). Ce cours a expiré à la fin de l’année scolaire 2022–2023.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[{&q;name&q;:&q;Disclaimer&q;,&q;codename&q;:&q;disclaimer&q;}]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;ele___lang___fra___revision_history__copy_&q;:{&q;system&q;:{&q;id&q;:&q;ae9d2a7a-0f88-4