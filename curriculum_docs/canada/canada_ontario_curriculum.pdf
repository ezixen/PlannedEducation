sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-06-05T12:19:03.7176991Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ce programme-cadre remplace &l;em&g;Le curriculum de l’Ontario, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – Affaires et commerce, édition révisée &l;/em&g;(2006). À partir de l’année scolaire 2024-2025, tous les cours d’affaires et commerce de 9&l;sup&g;e&l;/sup&g; et 10&l;sup&g;e&l;/sup&g;&a;nbsp;année seront basés sur les attentes et les contenus d’apprentissage présentés dans ce programme-cadre. Les cours d’affaires et commerce de 11&l;sup&g;e&l;/sup&g; et 12&l;sup&g;e&l;/sup&g;&a;nbsp;année continuent d’être fondés sur &l;a href=\&q;https://www.edu.gov.on.ca/fre/curriculum/secondary/business1112currb.pdf\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – Affaires et commerce, édition révisée&l;/em&g; (2006)&l;/a&g;. Toutes les références aux cours de 9&l;sup&g;e&l;/sup&g; et 10&l;sup&g;e&l;/sup&g;&a;nbsp;année qui apparaissent dans &l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année – Affaires et commerce, édition révisée&l;/em&g; (2006) ont été remplacées par &l;em&g;Le curriculum de l’Ontario – Affaires et commerce, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année&l;/em&g; (2024).&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;career_studies___available_grades&q;:{&q;system&q;:{&q;id&q;:&q;439f2002-3f68-4b7f-9219-13f75fa18047&q;,&q;name&q;:&q;Career Studies - Available Grades&q;,&q;codename&q;:&q;career_studies___available_grades&q;,&q;language&q;:&q;fr-CA&q;,&q;type&q;:&q;ui___available_filters___grades&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2021-02-23T13:47:42.8094238Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;label&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Label&q;,&q;value&q;:&q;Année