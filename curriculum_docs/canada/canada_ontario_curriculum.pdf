lue&q;:&q;&l;ul&g;\n  &l;li&g;This curriculum was issued in 2010.&l;/li&g;\n  &l;li&g;In Grade 9, students have the opportunity to explore various First Nations, Métis, and Inuit art forms in a course &l;a href=\&q;/en/course-descriptions-and-prerequisites/fnmi-studies#course\&q;&g;(NAC1O)&l;/a&g; that may be used to fulfil the compulsory credit requirement in the arts.&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___intro_&q;,&q;sec___arts___program___prerequisite_charts__organi&q;,&q;res___course_description_and_prerequisite___the_ar_1ba1827&q;,&q;res___course_description_and_prerequisite___intro__eedb19c&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_and_prereq___the_arts_201_0b1c6b9&q;:{&q;system&q;:{&q;id&q;:&q;0b1c6b91-7b04-4aa9-b267-694227db5416&q;,&q;name&q;:&q;RES - Course description and Prereq - FNMI&q;,&q;codename&q;:&q;res___course_description_and_prereq___the_arts_201_0b1c6b9&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-04T15:37:41.2066524Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;curriculum-fnmi (1).svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1375,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/34ed45ef-86fd-4a92-a88b-fe82fac5b04a/curriculum-fnmi%20%281%29.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;First Nations, Métis, and Inuit Studies&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;fnmi-studies&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;As of September&a;nbsp;2019, all courses in First Nations, Métis, and Inuit Studies (formerly \&q;Native Studies\&q;) are based on the expectations outlined in&a;nbsp;&l;em&g;The Ontario Curriculum, Grades&a;nbsp;9&a;nbsp;to&a;nbsp;12: First Nations, Métis, and Inuit Studies,&a;nbsp;2019&l;/em&g;.&l;/li&g;\n  &l;li&g;This curriculum policy replaces The Ontario Curriculum, Grades&a;nbsp;9&a;nbsp;and&a;nbsp;10: Native Studies,&a;nbsp;1999 and The Ontario Curriculum, Grades&a;nbsp;11&a;nbsp;and&a;nbsp;12: Native Studies,&a;nbsp;2000.&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___the_ar_c1b92bf&q;,&q;res___arts___program___prerequisite_charts__copy_&q;,&q;res___course_description_and_prerequisite___the_ar_ae8a690&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;na