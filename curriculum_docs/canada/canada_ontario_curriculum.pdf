urce&q;,&q;icd2o___parent_guide__resource_card_&q;]},&q;colour&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Colour&q;,&q;value&q;:[{&q;name&q;:&q;Computer Studies&q;,&q;codename&q;:&q;computer_studies&q;}]},&q;icon&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Icon&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum_ComputerStudies.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1680,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/a2464c80-a48b-4337-b4ef-9f5995266b60/Curriculum_ComputerStudies.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;icd2o_strands_pdf__copy_&q;,&q;sec___computer_studies_curriculum_pdf__copy__94b4ae0&q;,&q;sec___computer_studies_curriculum_pdf&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2023&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Educators should be aware that, with the exception of &l;strong&g;the Grade 10 course Digital Technology and Innovations in the Changing World, 2023 (ICD2O)&l;/strong&g;, the 2008 computer studies curriculum remains in effect. All secondary computer studies courses for Grades 11–12 will continue to be based on that document. All references to Grade 10 that appear in &l;em&g;The Ontario Curriculum, Grades 10 to 12: Computer Studies, 2008&l;/em&g; have been superseded by Digital Technology and Innovations in the Changing World, 2023. As of September 2023, this course replaces Introduction to Computer Studies, Grade 10 (ICS2O), which expired at the end of the 2022–23 school year.&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___computer_studies___revision_history_1&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;Le curriculum de l’Ontario – Études informatiques, de la 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;à la 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g;&a;nbsp;année&l;/em&g;&l;/p&g;&q;}}},&q;computer_studies___curriculum_l1__copy_&q;:{&q;system&q;:{&q;id&q;:&q;340e746e-c7dc-4090-a831-88b4fd3a1be5&q;,&q;name&q;:&q;Sec - Indigenous Languages - Curriculum L1&q;,&q;codename&q;:&q;computer_studies___curriculum_l1__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;l1___curriculum&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-07-30T17:23:53.5248848Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___curriculum_select__elem__sec____curriculum&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Curriculum Select (Elem, Sec) + Curriculum&q;,&q;taxonomy_group&q;:&q;site___curriculum_select__elem__sec____curriculum&q;,&q;value&q;:[{&q;name&q;:&q;Secondary&q;,&q;codename&q;:&q;secondary&q;},{&q;name&q;:&q;Native Languages&q;,&q;codename&q;:&q;native_languages_secondary&q;}]},&q;context&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Context&q;,&q;value&q;:[&q;sec___indigenous_languages___curriculum_context__t&q;]},&q;s