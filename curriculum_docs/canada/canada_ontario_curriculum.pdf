nges Button Ver 1.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:10001,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/816ebd5f-32ff-4261-bcf8-85af97728988/Canadian%20and%20World%20Studies%20Key%20Changes%20Button%20Ver%201.svg&q;}]},&q;system___site___resource_category&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;System - Site – Resource Category&q;,&q;taxonomy_group&q;:&q;site___resource_category&q;,&q;value&q;:[]},&q;rp___resource___subject&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Subject&q;,&q;taxonomy_group&q;:&q;rp___resource___subject&q;,&q;value&q;:[{&q;name&q;:&q;Canadian and World Studies&q;,&q;codename&q;:&q;sshg___cws&q;}]},&q;rp___resource___topic&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Resource - Topic&q;,&q;taxonomy_group&q;:&q;rp___resource___topic&q;,&q;value&q;:[]},&q;site___grade&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Grade&q;,&q;taxonomy_group&q;:&q;site___grade&q;,&q;value&q;:[{&q;name&q;:&q;10&q;,&q;codename&q;:&q;n10&q;}]},&q;rp___developed_by&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Developed By&q;,&q;taxonomy_group&q;:&q;rp___developed_by&q;,&q;value&q;:[{&q;name&q;:&q;Ministry of Education&q;,&q;codename&q;:&q;ministry_of_education&q;}]},&q;rp___audience&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;RP - Audience&q;,&q;taxonomy_group&q;:&q;rp___audience&q;,&q;value&q;:[{&q;name&q;:&q;Teachers&q;,&q;codename&q;:&q;teachers&q;}]}}},&q;cgc1w___parent_guide___intro__copy_&q;:{&q;system&q;:{&q;id&q;:&q;2594fe65-1aab-48ea-9b2d-4fc5bd0b3654&q;,&q;name&q;:&q;CWS - G10 History - Parent Guide - Intro&q;,&q;codename&q;:&q;cgc1w___parent_guide___intro__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-18T16:10:33.7682314Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;introduction&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Your child must complete a Grade 10 Canadian History course to graduate from high school. They can choose between the Academic or Applied versions of the course, based on:&l;/p&g;\n&l;ul&g;\n  &l;li&g;the courses they want to take later in school&l;/li&g;\n  &l;li&g;what they want to do after they graduate&l;/li&g;\n&l;/ul&g;\n&l;p&g;Similar historical information is taught in both courses, but the way it is taught is different.&l;/p&g;\n&l;p&g;Your child will learn:&l;/p&g;\n&l;ul&g;\n  &l;li&g;about social, economic and political developments and events in Canada since 1914 that had a lasting impact on the lives of people in Canada&l;/li&g;\n  &l;li&g;Canada’s evolving role within the global community&l;/li&g;\n  &l;li&g;about the impact of events and issues on individuals and communities in Canada&l;/li&g;\n  &l;li&g;about how various individuals, groups and social changes contributed to the development of Canada&l;/li&g;\n  &l;li&g;to interpret and analyze key issues and events in Canadian history since 1914 and how they have helped shape present-day Canada&l;/li&g;\n&l;/ul&g;\n&l;p&g;The courses have 5 areas of learning:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Historical inquiry and skill development&l;/li&g;\n  &l;li&g;Canada, 1914–1929&l;/li&g;\n  &l;li&g;Canada, 1929–1945&l;/li&g;\n  &l;li&g;Canada, 1945–1982&l;/li&g;\n  &l;li&g;Canada, 1982 to the present&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;cgc1w___parent_guide___related_resources__copy_&q;:{&q;system&q;:{&q;id&q;:&q;8a493ef9-8589-4f63-81de-315679a1f2f8&q;,&q;name&q;:&q;CWS - G10 History - Parent Guide - Related Resources&q;,&q;codename&q;:&q;cgc1w___parent_guide___related_resources__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-20T18:48:17.8879652Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Resources&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;resources&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;a href=\&q;/en/curriculum/canadian-and-world-studies/courses/chc2d\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Grade 10 Canadian History since World War I (CHC2D)&l;/a&g;&l;/p&g;\n&l;p&g;&l;a href=\&q;/en/curriculum/canadian-and-world-studies/courses/chc2p\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Grade 10 Canadian History since World War I (CHC2P)&l;/a&g;&l;/p&g;\n&l;p&g;&l;a href=\&q;/en/curriculum/elementary-sshg/grades-list?curriculum_discipline=history\&q;&g;Grades 7–8 History&l;/a&g;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.ontario.ca/page/high-school-graduation-requirements\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;High school graduation requirements&l;/a&g;&l;/p&g;\n&l;p&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/program-planning/transferable-skills\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Transferable skills&l;/a&g;&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;cgc1w___parent_guide___supporting_your_child_s_lea&q;:{&q;system&q;:{&q;id&q;:&q;f47dc0d9-433a-4219-b64f-d0dda11d3d74&q;,&q;name&q;:&q;CWS - G10 History - Parent Guide - Support your child’s learning&q;,&q;codename&q;:&q;cgc1w___parent_guide___supporting_your_child_s_lea&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-18T16:12:33.5111973Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Support your child’s learning&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;support&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;You and your family can play an important role in your child’s success by:&l;/p&g;\n&l;ul&g;\n  &l;li&g;showing an interest in what they are learning&l;/li&g;\n  &l;li&g;helping them make connections to everyday events at home, in the community and beyond&l;/li&g;\n&l;/ul&g;\n&l;p&g;Here are some ideas to support your child’s learning.&l;/p&g;\n&l;ul&g;\n  &l;li&g;Talk together about what’s happening in the news, and about how problems and changes are related to Canadian history. Encourage sharing different opinions and views on these topics.&l;/li&g;\n  &l;li&g;Encourage your child to keep up with important events and issues on a variety of media platforms. Explore these platforms together and help your child learn how to check if the content is trustworthy.&l;/li&g;\n  &l;li&g;Talk about why it&s;s important to recognize key people and events from the past. Discuss how these individuals helped shape identities and heritage in Canada.&l;/li&g;\n  &l;li&g;Help your child make connections between what they learn in school, their interests and the courses they choose to take.&l;/li&g;\n  &l;li&g;Connect with their teacher, guidance counsellor or other school staff. They can provide information about skills and experiences that will support your child’s learning, future aspirations and course choices.&l;/li&g;\n  &l;li&g;Stay informed about your child’s learning. If you have questions, contact your child’s teacher or school.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;cgc1w___parent_guide___what_students_will_learn__c&q;:{&q;system&q;:{&q;id&q;:&q;8551e5b6-e804-4e33-a5d0-b51bb42ddb0b&q;,&q;name&q;:&q;CWS - G10 History - Parent Guide - What students will learn&q;,&q;codename&q;:&q;cgc1w___parent_guide___what_students_will_learn__c&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-02-18T21:04:49.0392083Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Summary of major knowledge and skills&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;knowledge-and-skills&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;h4&g;Historical inquiry and skill development&l;/h4&g;\n&l;p&g;In Grade 10 Canadian History, your child learns to analyze issues, events and developments in Canadian history since 1914 by:&l;/p&g;\n&l;ul&g;\n  &l;li&g;asking focused questions&l;/li&g;\n  &l;li&g;gathering and evaluating information&l;/li&g;\n  &l;li&g;drawing conclusions&l;/li&g;\n  &l;li&g;communicating their results&l;/li&g;\n&l;/ul&g;\n&l;p&g;Your child practises using transferable skills, including digital literacy and critical thinking, to:&l;/p&g;\n&l;ul&g;\n  &l;li&g;gather information&l;/li&g;\n  &l;li&g;analyze current social, economic and political issues&l;/li&g;\n  &l;li&g;evaluate credibility and biases in resources&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Canada, 1914–1929&l;/h4&g;\n&l;p&g;Your child learns about:&l;/p&g;\n&l;ul&g;\n  &l;li&g;key social, economic and political events, trends and developments between 1914 and 1929, including the impact of World War I on people in Canada&l;/li&g;\n  &l;li&g;how various individuals, organizations and specific social changes contributed to the development of identities, citizenship and heritage in Canada&l;/li&g;\n&l;/ul&g;\n&l;p&g;Your child analyzes key interactions:&l;/p&g;\n&l;ul&g;\n  &l;li&g;within and between various communities in Canada and the lasting impact of the residential school system&l;/li&g;\n  &l;li&g;between Canada and the international community, including the causes for and Canada’s participation in World War I&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Canada, 1929–1945&l;/h4&g;\n&l;p&g;Your child learns about:&l;/p&g;\n&l;ul&g;\n  &l;li&g;key social, economic and political events, trends and developments between 1929 and 1945, including the Great Depression and World War II&l;/li&g;\n  &l;li&g;how various individuals, organizations and specific social changes contributed to the development of identities, citizenship and heritage in Canada&l;/li&g;\n  &l;li&g;some of the extreme political and social ideologies that had an impact on democracy and on various individuals, groups and communities in Canada and around the world&l;/li&g;\n  &l;li&g;the impact of the Holocaust and the Holodomor famine on communities and individuals in Europe and their lasting impact on the Jewish and Ukrainian communities in Canada&l;/li&g;\n&l;/ul&g;\n&l;p&g;Your child analyzes key interactions:&l;/p&g;\n&l;ul&g;\n  &l;li&g;within and between various communities in Canada&l;/li&g;\n  &l;li&g;between Canada and the international community, including Canada’s involvement in World War II&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Canada, 1945–1982&l;/h4&g;\n&l;p&g;Your child learns:&l;/p&g;\n&l;ul&g;\n  &l;li&g;about key social, economic and political events, trends and developments between 1945 and 1982, including various social movements and the expansion of social welfare programs&l;/li&g;\n  &l;li&g;how Black individuals, communities and organizations actively resisted and advocated against anti-Black racism in Canada&l;/li&g;\n  &l;li&g;how various individuals, organizations and specific social changes contributed to the development of identities, citizenship and heritage in Canada&l;/li&g;\n&l;/ul&g;\n&l;p&g;Your child analyzes some key interactions:&l;/p&g;\n&l;ul&g;\n  &l;li&g;within and between various communities in Canada&l;/li&g;\n  &l;li&g;between Canada and the international community, including the Cold War and the Quiet Revolution in Quebec&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Canada, 1982 to the present&l;/h4&g;\n&l;p&g;Your child learns:&l;/p&g;\n&l;ul&g;\n  &l;li&g;about key social, economic and political events, trends and developments between 1982 to present&l;/li&g;\n  &l;li&g;about the impact of events, developments and issues on identities, citizenship and heritage in Canada&l;/li&g;\n  &l;li&g;how various individuals, groups and social changes contributed to the development of identities, citizenship and heritage in Canada&l;/li&g;\n&l;/ul&g;\n&l;p&g;Your child analyzes key interactions:&l;/p&g;\n&l;ul&g;\n  &l;li&g;within and between various communities in Canada&l;/li&g;\n  &l;li&g;between Canada and the international community, including Canada’s ongoing role internationally&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_te