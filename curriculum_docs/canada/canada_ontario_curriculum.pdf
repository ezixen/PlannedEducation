:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;g9_math___sample_course_plans___reflective_questio&q;:{&q;system&q;:{&q;id&q;:&q;2d3b059b-1a42-4730-97b9-1b18921c0e7d&q;,&q;name&q;:&q;SNC1W - Sample course plans - Reflective Questions&q;,&q;codename&q;:&q;g9_math___sample_course_plans___reflective_questio&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-12-01T21:12:58.5169159Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Reflective questions for consideration&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;questions&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Consider the following questions when developing, implementing, and reflecting on course plans.&l;/p&g;\n&l;p&g;How can my plans:&l;/p&g;\n&l;ul&g;\n  &l;li&g;incorporate student voice, choice, and lived experiences to support engagement and understanding?&l;/li&g;\n  &l;li&g;honour and value varied realities of students and communities through the use of diverse resources, examples, and pedagogical approaches?&l;/li&g;\n  &l;li&g;incorporate tasks that are respectful and reflective of high expectations for all students?&l;/li&g;\n  &l;li&g;support the multiple ways assessment information should be collected (e.g., conversations, observations, products)?&l;/li&g;\n  &l;li&g;support students in making connections between the curriculum expectations and real-life experiences including developments, research, and innovation in STEM fields?&l;/li&g;\n  &l;li&g;support students in exploring pathways and connections associated with various STEM-related careers?&l;/li&g;\n  &l;li&g;provide hands-on learning experiences enabling students to deepen their understanding of the science they are learning and improve their STEM skills?&l;/li&g;\n  &l;li&g;support academic success by providing students with a range of opportunities to demonstrate their understanding of science concepts and apply STEM skills as evidence of learning?&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;g9_math___sample_course_plans___what_is_a_course_p_4f7e7eb&q;:{&q;system&q;:{&q;id&q;:&q;4f7e7eb7-e47a-4d5b-8b8d-60acd4203994&q;,&q;name&q;:&q;Sci &a; tech - LRP - Intro&q;,&q;codename&q;:&q;g9_math___sample_course_plans___what_is_a_course_p_4f7e7eb&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-12-01T21:19:31.23171Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;intro&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;untitled_content_item_cc26a20&q;],&q;value&q;:&q;&l;h4&g;&l;strong&g;What is a long-range plan and why is it important?&l;/strong&g;&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;untitled_content_item_cc26a20\&q;&g;&l;/object&g;\n&l;p&g;A long-range plan outlines and organizes curriculum expectations. It is a living document that is revised as educators become increasingly aware of the abilities, strengths, needs, and interests of students.&l;/p&g;\n&l;p&g;A thoughtfully developed long-range plan:&l;/p&g;\n&l;ul&g;\n  &l;li&g;ensures that instruction is sequenced in a manner that aligns with research about learning science and technology;&l;/li&g;\n  &l;li&g;allocates the appropriate time for concepts and skills so that students have multiple opportunities to focus on the overall expectations within the grades;&l;/li&g;\n  &l;li&g;connects concepts and skills to other strands within the curriculum, to other subject areas, and to the lives of students;&l;/li&g;\n  &l;li&g;ensures that all specific expectations are addressed at least once within the school year; and&l;/li&g;\n  &l;li&g;recognizes that some expectations need to be revisited several times throughout the year.&l;/li&g;\n&l;/ul&g;\n&l;p&g;Note:&l;/p&g;\n&l;ul&g;\n  &l;li&g;These sample long-range plans outline possible sequences of instruction for the school year. There are many ways to structure an effective plan for learning.&l;/li&g;\n  &l;li&g;These sample plans include clusters of learning that have areas of focus from science and technology, as well as examples of cross-curricular connections that can be made to some expectations in other subject areas.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Reflective questions for consideration&l;/strong&g;&l;/h4&g;\n&l;p&g;Consider the following questions when developing, implementing, and reflecting on long-range plans.&l;/p&g;\n&l;p&g;How can my plans:&l;/p&g;\n&l;ul&g;\n  &l;li&g;incorporate student voice, choice, and lived experiences to support engagement and understanding?&l;/li&g;\n  &l;li&g;honour and value varied realities of students and communities through using diverse resources, examples, and pedagogical approaches?&l;/li&g;\n  &l;li&g;incorporate tasks that are respectful and reflective of high expectations for all students?&l;/li&g;\n  &l;li&g;support the multiple ways assessment information should be collected (e.g., conversations, observations, and products)?&l;/li&g;\n  &l;li&g;support students in making connections between the curriculum expectations and real-life experiences including developments, research, and innovation in STEM fields?&l;/li&g;\n  &l;li&g;support students in exploring pathways and connections associated with various STEM-related careers?&l;/li&g;\n  &l;li&g;provide hands-on learning experiences enabling students to deepen their understanding of the science and technology they are learning and improve their STEM skills?&l;/li&g;\n  &l;li&g;support academic success by providing students with a range of opportunities to demonstrate their understanding of science and technology concepts and apply STEM skills as evidence of learning?&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;g9_math___sample_course_plans___what_is_a_course_p_ad52e89&q;:{&q;system&q;:{&q;id&q;:&q;ad52e891-3288-4040-a7f5-60a74c206c33&q;,&q;name&q;:&q;SNC1W - Sample course plans - What is a course plan&q;,&q;codename&q;:&q;g9_math___sample_course_plans___what_is_a_course_p_ad52e89&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-11-14T18:13:30.5643584Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What is a course plan and why is it important?&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;what-is&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;sci___tech___lrp___intro___vision_extract__copy_&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;sci___tech___lrp___intro___vision_extract__copy_\&q;&g;&l;/object&g;\n&l;p&g;A course plan outlines and organizes curriculum expectations. It is a living document that is revised as educators become increasingly aware of the abilities, strengths, needs and interests of their students.&l;/p&g;\n&l;p&g;A thoughtfully developed course plan:&l;/p&g;\n&l;ul&g;\n  &l;li&g;ensures that instruction is sequenced in a manner that aligns with research about learning science;&l;/li&g;\n  &l;li&g;allocates the appropriate time for concepts and skills so that students have multiple opportunities to focus on the overall expectations in the course;&l;/li&g;\n  &l;li&g;connects concepts and skills to other strands within the curriculum, to other subject areas, and to the lives of students;&l;/li&g;\n  &l;li&g;ensures that all specific expectations are addressed at least once within the course; and&l;/li&g;\n  &l;li&g;recognizes that some expectations need to be revisited several times throughout the course.&l;/li&g;\n&l;/ul&g;\n&l;p&g;Note:&a;nbsp;&l;/p&g;\n&l;p&g;These sample course plans outline a possible sequence of instruction for the course. There are many ways to structure an effective plan for learning.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;g9_math_sample_course_plans__copy_&q;:{&q;system&q;:{&q;id&q;:&q;51ed4284-6982-4e73-93f4-9d8e8e87f1c7&q;,&q;name&q;:&q;Sci &a; Tech - Long Range Plans&q;,&q;codename&q;:&q;g9_math_sample_course_plans__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___view&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-03-12T18:06:11.3112931Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Long-Range Plans – Science and Technology Curriculum, Grades 1–8 (2022)&q;},&q;subtitle&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Sub-title&q;,&q;value&q;:&q;&q;},&q;url_slug&q