&q;:&q;image/svg+xml&q;,&q;size&q;:2294,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/520313ac-9b06-4bb1-83f4-cba1957b1ae2/Curriculum_CWS2.svg&q;}]},&q;curriculum_pdfs&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum PDFs&q;,&q;value&q;:[&q;cgc1w___strands___oe_se_pdf&q;,&q;snc1w___course_curriculum_pdf__copy_&q;,&q;cws___g9_10_curriculum_pdf__copy__ebc7726&q;,&q;cws___g9_10_curriculum_pdf&q;,&q;cws___g9_10_curriculum_pdf__copy_&q;]},&q;intro_videos&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Intro Videos&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;glossary_disclaimer&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Glossary Disclaimer&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;The definitions provided in this glossary are specific to the curriculum context in which the terms are used.&l;/em&g;&l;/p&g;\n&l;p&g;&l;em&g;Note: &l;/em&g;The definitions of terms marked with an asterisk (*) are reproduced with the permission of the Minister of Public Works and Government Services Canada, 2012. Courtesy of the Department of Canadian Heritage.&l;/p&g;&q;},&q;downloads&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Downloads&q;,&q;value&q;:[]},&q;monarchs_printer_year&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;King&s;s Printer Year&q;,&q;value&q;:&q;2022&q;},&q;revision_content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Revision content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Educators should be aware that, with the exception of the Grade 9 course Issues in Canadian Geography, Applied (CGC1P), which has expired, and the Grade 10 course Civics and Citizenship, 2022 (CHV2O), the 2018 Canadian and World Studies curriculum for Grades 9–10 and the 2015 curriculum for Grades 11–12 remain in effect. All other courses will continue to be based on the curriculum expectations outlined in those documents. All references to CHV2O that appear in &l;em&g;The Ontario Curriculum, Grades 9 and 10: Canadian and World Studies, 2018&l;/em&g; and &l;em&g;The Ontario Curriculum, Grades 11 and 12: Canadian and World Studies, 2015 &l;/em&g;have been superseded by the revised Civics and Citizenship course, 2022.&a;nbsp;&l;/p&g;&q;},&q;revision_history&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision history&q;,&q;value&q;:[&q;sec___cws___revision_history_1&q;,&q;sec___cws___revision_history_2&q;]},&q;language_equivalent_curriculum_disclaimer&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Language equivalent curriculum disclaimer&q;,&q;value&q;:&q;&q;},&q;language_equivalent_curriculum_name&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Language equivalent curriculum name&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;em&g;Le curriculum de l’Ontario, 9&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 10&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année – Études canadiennes et mondiales &l;/em&g;(2026);&l;br&g;\n&l;em&g;Le curriculum de l’Ontario, 11&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; et 12&l;/em&g;&l;em&g;&l;sup&g;e&l;/sup&g;&l;/em&g;&l;em&g; année – Études canadiennes et mondiales &l;/em&g;(2015)&l;/p&g;&q;}}},&q;sec___classical_studies_and_international_language&q;:{&q;system&q;:{&q;id&q;:&q;158ca896-832e-4e8d-be75-173f67105b8f&q;,&q;name&q;:&q;Sec - Classical Studies and International Languages&q;,&q;codename&q;:&q;sec___classical_studies_and_international_language&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;l1___curriculum&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2025-05-15T13:47:15.6510772Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___curriculum_select__elem__sec____curriculum&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Curriculum Select (Elem, Sec) + Curriculum&q;,&q;taxonomy_g