;:&q;modular_content&q;,&q;name&q;:&q;Subpages&q;,&q;value&q;:[&q;curriculum_review___what_is_curriculum&q;,&q;curriculum_guide___section_1&q;,&q;crg___curriculum_review___phase_1___process__copy_&q;,&q;crg___curriculum_review___phase_2___revision_proce&q;,&q;curriculum_review___what_is_curriculum__copy_&q;,&q;crg___appendix_a__curriculum_review_assessment_for_f222255&q;,&q;curriculum_guide___list_of_curriculum___english&q;]},&q;right_side_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Right side items&q;,&q;value&q;:[]},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;This guide provides an overview of the Ontario Ministry of Education’s process of reviewing and revising the curriculum in both English and French  for Kindergarten to Grade 12. It is intended to provide greater transparency for parents, the public and the education sector regarding the ministry’s current process.&q;},&q;settings&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Features&q;,&q;value&q;:[{&q;name&q;:&q;Show Yes/No Rating&q;,&q;codename&q;:&q;show_yes_no_rating&q;},{&q;name&q;:&q;Show Back to Top&q;,&q;codename&q;:&q;show_back_to_top&q;},{&q;name&q;:&q;Add breadcrumbs&q;,&q;codename&q;:&q;add_breadcrumbs&q;}]},&q;revision_history_page&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Revision History Page&q;,&q;value&q;:[]},&q;cont