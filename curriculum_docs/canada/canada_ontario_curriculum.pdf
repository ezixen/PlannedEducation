;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;res___course_description_and_prerequisite___asl___&q;:{&q;system&q;:{&q;id&q;:&q;f4b6d3d1-ee30-4a84-9a0e-a72218b0ead6&q;,&q;name&q;:&q;RES - Course description and Prerequisite - ASL / LSQ&q;,&q;codename&q;:&q;res___course_description_and_prerequisite___asl___&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-04T14:22:00.5575555Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum-ASL-SL.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:6252,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/53771de1-f93d-4687-9995-4876675f5906/Curriculum-ASL-SL.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;American Sign Language as a Second Language&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;aslsl&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;This curriculum was issued in 2021.&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;course_description_and_prerequisite___asl___lsq___&q;,&q;course_description_and_prerequisite___asl___lsq____9523309&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_and_prerequisite___intro&q;:{&q;system&q;:{&q;id&q;:&q;558a0e9d-5e0c-4c53-a4ab-5e73f97b9715&q;,&q;name&q;:&q;RES - Course description and prerequisite - Intro&q;,&q;codename&q;:&q;res___course_description_and_prerequisite___intro&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2026-08-17T14:36:41.976645Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;introduction&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{&q;98c04461-42b9-472b-943e-86aaf72889aa&q;:{&q;codename&q;:&q;res___course_description_and_prerequisite___prereq&q;,&q;type&q;:&q;footnotes&q;,&q;url_slug&q;:&q;&q;}},&q;modular_content&q;:[&q;untitled_content_item_52185cd&q;],&q;value&q;:&q;&l;p&g;This document contains the course descriptions for all courses in Grades 9 to 12, along with course lists (including course codes) and prerequisite charts, in the following subjects/disciplines:&l;/p&g;\n&l;ul&g;\n  &l;li&g;American Sign Language as a Second Language&l;/li&g;\n  &l;li&g;The Arts&l;/li&g;\n  &l;li&g;Business Studies&l;/li&g;\n  &l;li&g;Canadian and World Studies&l;/li&g;\n  &l;li&g;Classical Studies and International Languages&l;/li&g;\n  &l;li&g;Computer Studies&l;/li&g;\n  &l;li&g;Cooperative Education&l;/li&g;\n  &l;li&g;English&l;/li&g;\n  &l;li&g;English as a Second Language and English Literacy Development&l;/li&g;\n  &l;li&g;First Nations, Métis, and Inuit Studies&l;/li&g;\n  &l;li&g;French as a Second Language&l;/li&g;\n  &l;li&g;Guidance and Career Education&l;/li&g;\n  &l;li&g;Health and Physical Education&l;/li&g;\n  &l;li&g;Interdisciplinary Studies&l;/li&g;\n  &l;li&g;Mathematics&l;/li&g;\n  &l;li&g;Native Languages&l;/li&g;\n  &l;li&g;Science&l;/li&g;\n  &l;li&g;Social Sciences and Humanities&l;/li&g;\n  &l;li&g;Technological Education&l;/li&g;\n&l;/ul&g;\n&l;p&g;The purpose of this document is to assist students, with the help of their parents and guidance counsellors, in selecting the courses that will put them on the right path to their postsecondary destination. The course descriptions are standard, one-paragraph descriptions that summarize what students will learn in each course. The descriptions are gathered here in a separate section for each discipline, and each section is introduced by a course list and a &l;a data-item-id=\&q;98c04461-42b9-472b-943e-86aaf72889aa\&q; href=\&q;\&q;&g;prerequisite&l;/a&g; chart. (A &l;em&g;prerequisite &l;/em&g;is a course deemed essential for the successful understanding and completion of a subsequent course.) The prerequisite charts diagram the relationships among courses.&l;/p&g;\n&l;p&g;The policy regarding prerequisites is stated as follows in &l;a href=\&q;https://www.ontario.ca/document/ontario-schools-kindergarten-grade-12-policy-and-program-requirements-2024\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;Ontario Schools, Kindergarten to Grade 12: Policy and Program Requirements, 2024&l;/em&g;&l;/a&g;&l;em&g; &l;/em&g;(section 7.2.3)&l;em&g;.&l;/em&g;&l;/p&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;untitled_content_item_52185cd\&q;&g;&l;/object&g;\n&l;p&g;Course codes consist of five characters:&l;/p&g;\n&l;ul&g;\n  &l;li&g;The first three characters identify the subject&l;/li&g;\n  &l;li&g;The fourth character identifies the grade (i.e., Grade 9 courses are represented by 1, Grade 10 by 2, Grade 11 by 3, and Grade 12 by 4)&l;/li&g;\n  &l;li&g;The fifth character identifies the type of course (i.e., W refers to “de-streamed”, P to “applied”, D to “academic”, U to “university”, M to “university/college”, C to “college”, E to “workplace”, and O to “open”).&l;/li&g;\n&l;/ul&g;\n&l;p&g;&l;strong&g;About secondary school credits&l;/strong&g;&l;/p&g;\n&l;p&g;A credit is granted in recognition of the successful completion (that is, completion with a final percentage mark of 50 per cent or higher) of a course that has been scheduled for a minimum of 110 hours. Credits are granted by a principal on behalf of the Minister of Education for courses that have been developed or authorized by the ministry. A half-credit may be granted for each 55-hour part of a 110-hour ministry-developed course &l;em&g;in accordance with the policy outlined in the curriculum policy documents&l;/em&g;. Most courses are offered as single-credit courses. Some courses, such as technological education, interdisciplinary studies, and cooperative education courses, may be offered as multiple-credit courses.&l;/p&g;\n&l;p&g;Information about course codes, descriptions, and prerequisites is current as of August 2026, and each section indicates the year(s) the current curriculum was issued.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;res___course_description_and_prerequisite___intro__eedb19c&q;:{&q;system&q;:{&q;id&q;:&q;eedb19c7-14bf-4a66-995f-e99202c64df1&q;,&q;name&q;:&q;RES - Course description and prerequisite - Appendix A&q;,&q;codename&q;:&q;res___course_description_and_prerequisite___intro__eedb19c&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-04-05T15:05:29.261917Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Appendix A. Course Codes for Focus Courses in the Arts, Grades 9 to 12 (2010)&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;appendix-a&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;untitled_content_item_4570469&q;,&q;res___course_codes_arts___dance___table1__copy_&q;,&q;res___course_codes_arts___drama___table1__copy_&q;,&q;res___course_codes_arts___dance___table1__copy__e3e0499&q;,&q;res___course_codes_arts___music___table1__copy_&q;],&q;value&q;:&q;&l;p&g;The focus courses for the arts secondary curriculum are coded with three letters to indicate the subject. The course titles are also provided. A year or grade number and a course type character must also be added to complete the course codes. (e.g., Grade 9 Ballet would be ATB1O)&l;/p&g;\n&l;h4&g;Dance, 9-12&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;untitled_content_item_4570469\&q;&g;&l;/object&g;\n&l;h4&g;Drama, 9-12&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;res___course_codes_arts___dance___table1__copy_\&q;&g;&l;/object&g;\n&l;h4&g;Drama, 11-12&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;res___course_codes_arts___drama___table1__copy_\&q;&g;&l;/object&g;\n&l;h4&g;Music, 9-12&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;res___course_codes_arts___dance___table1__copy__e3e0499\&q;&g;&l;/object&g;\n&l;h4&g;Visual arts, 9-12&l;/h4&g;\n&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;res___course_codes_arts___music___table1__copy_\&q;&g;&l;/object&g;\n&l;p&g;&l;strong&g;Note:&l;/strong&g;&l;/p&g;\n&l;ul&g;\n  &l;li&g;Workplace courses are offered in a comprehensive format that provides for the inclusion and combination of elements from a range of focus courses. As a result, there are no Grade 12 workplace (4E) courses offered in specific focus areas.&l;/li&g;\n  &l;li&g;As stated in Ontario Secondary Schools, Grades 9 to 12: Program and Diploma Requirements, 1999 (OSS), section 6.8.6, a maximum of two credits may be awarded to students taking music programs outside the school. For a student who has successfully completed the requirements as prescribed in Policy/Program Memorandum No. 133 issued January 5, 2004, the school uses the following titles and courses codes: AMX3M, Music – External (Conservatory); AMX4M, Music – External (Conservatory).&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;res___course_description_and_prerequisite___native&q;:{&q;system&q;:{&q;id&q;:&q;4fb7cf94-e02b-4f67-b19a-c96f03d9d6c3&q;,&q;name&q;:&q;RES - Course description and Prerequisite - Native Lang - Appendix E - Course Codes&q;,&q;codename&q;:&q;res___course_description_and_prerequisite___native&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-06-05T16:16:12.3258523Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Appendix E: Course codes for Native Languages&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;appendix-e&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[&q;res___ind_lang___inuktitut_course_codes&q;],&q;value&q;:&q;&l;object type=\&q;application/kenticocloud\&q; data-type=\&q;item\&q; data-rel=\&q;link\&q; data-codename=\&q;res___ind_lang___inuktitut_course_codes\&q;&g;&l;/object&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;res___course_description_prerequisite___business_s&q;:{&q;system&q;:{&q;id&q;:&q;51e5dac5-bf3f-4071-af78-0064f29cbf7e&q;,&q;name&q;:&q;RES - Course description Prerequisite - Business Studies&q;,&q;codename&q;:&q;res___course_description_prerequisite___business_s&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-08-20T18:57:18.698083Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum_BusinessStudies.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1667,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/35b7a5ac-1d96-43ec-8210-3a12466d4bd3/Curriculum_BusinessStudies.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Business Studies&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;business-studies&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;In June 2024, the ministry issued a new Grade 9 and 10 business studies curriculum. This curriculum includes two new courses to be implemented in Fall 2024: Building the Entrepreneurial Mindset (BEM1O), Grade 9, Open (BEM1O) and Launching and Leading a Business (BEP2O), Grade 10, Open (BEP2O). Students pursuing the Grade 10 course will not need a prerequisite.&l;/li&g;\n  &l;li&g;These are optional Grade 9 and 10 full-credit courses. They count towards the credits that students need to earn to graduate from high school, and will fulfil the compulsory&a;nbsp;STEM-related course group requirement for the Ontario Secondary School Diploma.&l;/li&g;\n  &l;li&g;The new Grade 9 course, Building the Entrepreneurial Mindset (BEM1O),&l;strong&g; &l;/strong&g;replaces the course Information and Communication Technology in Business, Grade 9 or 10 (BTT1O/BTT2O). As of September 2024, Information and Communication Technology in Business, Grade 9 or 10, should not be offered, and the associated course codes have expired.&l;/li&g;\n  &l;li&g;The new Grade 10 course, Launching and Leading a Business (BEP2O), replaces the course Introduction to Business, Grade 9 or 10 (BBI1O/BBI2O). As of September 2024, Introduction to Business, Grade 9 or 10, should not be offered, and the associated course codes have expired.&a;nbsp;&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___busine&q;,&q;res___course_description_and_prerequisite___the_ar&q;,&q;res___course_description_and_prerequisite___busine_f3384aa&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_prerequisite___business_s_0b90d1e&q;:{&q;system&q;:{&q;id&q;:&q;0b90d1ef-15d0-41bc-85e2-396ae5f9d1d8&q;,&q;name&q;:&q;RES - Course description Prerequisite - CWS&q;,&q;codename&q;:&q;res___course_description_prerequisite___business_s_0b90d1e&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-08-23T17:17:03.2747023Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum_CWS2.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:2294,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/520313ac-9b06-4bb1-83f4-cba1957b1ae2/Curriculum_CWS2.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Canadian and World Studies&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;cws&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;As part of the ministry’s commitment to de-streaming the Grade 9 program, the ministry has issued a new de-streamed Exploring Canadian Geography, Grade 9 course (CGC1W) that is replacing Issues in Canadian Geography, Grade 9, Academic (CGC1D). Beginning in the 2024–25 school year, Issues in Canadian Geography, Grade 9, Academic (CGC1D) should not be offered, and the associated course code expired at the end of the 2023–2024 school year. Please note, Issues in Canadian Geography, Grade 9, Applied (CGC1P) expired on September 1, 2022.&a;nbsp;&l;/li&g;\n  &l;li&g;With the exception of Grade 9 geography and Grade 10 civics (politics), the 2018 Canadian and World Studies curriculum for Grades 9–10 and the 2015 curriculum for Grades 11–12 remain in effect. All other Canadian and World Studies courses will continue to be based on the curriculum expectations outlined in those documents. All references to Grade 9 geography and Grade 10 civics (politics) that appear in&a;nbsp;&l;em&g;The Ontario Curriculum, Grades 9 and 10: Canadian and World Studies, 2018&l;/em&g;&a;nbsp;and&a;nbsp;&l;em&g;The Ontario Curriculum, Grades 11 and 12: Canadian and World Studies, 2015&l;/em&g;&a;nbsp;have been superseded by the new CGC1W (2024) and the revised CHV2O (2022).&l;/li&g;\n  &l;li&g;Since 2018, the Grade 9 and 10 curriculum has reflected Ontario’s commitment to respond to the Truth and Reconciliation Commission&s;s Calls to Action. The curriculum was revised in collaboration with Indigenous teachers, Elders, Knowledge Keepers, Senators, Indigenous community representatives, and residential school survivors. The revisions focus on strengthening students&s; knowledge and understanding of Indigenous histories, cultures, perspectives, contributions, and ways of knowing, as well as of the history of the residential school system, treaties, and the Indian Act.&l;/li&g;\n  &l;li&g;The Grade 11 and 12 curriculum was last revised in 2015.&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___busine_ca9c219&q;,&q;cws___program___prerequisite_charts&q;,&q;res___course_description_and_prerequisite___busine_c5b2686&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_prerequisite___business_s_25b691d&q;:{&q;system&q;:{&q;id&q;:&q;25b691d1-79ea-4334-9798-b2df6cb9526a&q;,&q;name&q;:&q;RES - Course description Prerequisite - HPE&q;,&q;codename&q;:&q;res___course_description_prerequisite___business_s_25b691d&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-04T14:08:19.5654405Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;curriculum-hpe (1).svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1909,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/4332d281-cef5-470b-85fd-d55a83e030af/curriculum-hpe%20%281%29.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Health and Physical Education&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;health-and-physical-education&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;This curriculum was issued in 2015.&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___busine_bca24a1&q;,&q;res___course_description_and_prerequisite___busine_b2ca12d&q;,&q;res___course_description_and_prerequisite___busine_e7645c0&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_prerequisite___business_s_a60090f&q;:{&q;system&q;:{&q;id&q;:&q;a60090fa-410e-498c-b842-858bcaa485fa&q;,&q;name&q;:&q;RES - Course description Prerequisite - Cooperative Ed&q;,&q;codename&q;:&q;res___course_description_prerequisite___business_s_a60090f&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2022-04-11T16:39:39.239184Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum_COOP.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1851,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/fa880ef9-6049-453a-b0bf-a207c1a2a2ee/Curriculum_COOP.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Cooperative Education&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;cooperative-education&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;This curriculum was issued in 2018.&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___busine_fe2dc6d&q;,&q;res___course_description_and_prerequisite___busine_1fed657&q;,&q;res___course_description_and_prerequisite___busine_35b575d&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_prerequisite___business_s_d4f4495&q;:{&q;system&q;:{&q;id&q;:&q;d4f44954-349e-44b1-8125-cd2b61dce22b&q;,&q;name&q;:&q;RES - Course description Prerequisite - Computer Studies&q;,&q;codename&q;:&q;res___course_description_prerequisite___business_s_d4f4495&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-08-29T19:41:12.9422156Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum_ComputerStudies.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:1680,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/a2464c80-a48b-4337-b4ef-9f5995266b60/Curriculum_ComputerStudies.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Computer Studies&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;computer-studies&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;The Grade 10 Computer Studies course &l;em&g;&l;strong&g;Digital&l;/strong&g;&l;/em&g; &l;em&g;&l;strong&g;Technology and Innovations in the Changing World&l;/strong&g;&l;/em&g;&l;strong&g; (ICD2O) &l;/strong&g;was issued in 2023. This course replaces Introduction to Computer Studies, Grade 10, Open (ICS2O). As of September 2023, the ICS2O course should not be offered, and the associated course code expired at the end of the 2022–23 school year.&a;nbsp;&l;/li&g;\n  &l;li&g;The 2008 Computer Studies curriculum remains in effect for Grades 11-12. All secondary Computer Studies courses for Grades 11–12 will continue to be based on that document. All references to Grade 10 that appear in &l;em&g;The Ontario Curriculum, Grades 10 to 12: Computer Studies, 2008&l;/em&g; have been superseded by &l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/curriculum/computer-studies/courses/icd2o\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Digital Technology and Innovations in the Changing World, 2023.&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;},&q;sections&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Sections&q;,&q;value&q;:[&q;res___course_description_and_prerequisite___busine_d4426aa&q;,&q;res___course_description_and_prerequisite___busine_f4d03d3&q;,&q;res___course_description_and_prerequisite___busine_3fa6515&q;]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;description&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__keywords&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;keywords&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__robots&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;robots&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:title&q;,&q;value&q;:&q;&q;},&q;ui___seo_meta_tags__og_description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;og:description&q;,&q;value&q;:&q;&q;}}},&q;res___course_description_prerequisite___cooperativ&q;:{&q;system&q;:{&q;id&q;:&q;2d522f39-7036-4f4a-8e3b-02984237c018&q;,&q;name&q;:&q;RES - Course description Prerequisite - English / Français&q;,&q;codename&q;:&q;res___course_description_prerequisite___cooperativ&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___content_collection&q;,&q;collection&q;:&q;resources&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-08-29T18:02:23.0566806Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[{&q;name&q;:&q;Curriculum-ENG.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:5059,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/8dd4ccc0-6bc9-4a04-8a87-cca2f71afd65/Curriculum-ENG.svg&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;English&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;english&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;The de-streamed Grade 9 English course (ENL1W) was issued in 2023. This course replaces English, Grade&a;nbsp;9, Academic (ENG1D). As of September 2023, the ENG1D course should not be offered, and the associated course code expired at the end of the 2022–23 school year.&a;nbsp;&a;nbsp;&a;nbsp;&l;/li&g;\n  &l;li&g;The 2007 English curriculum for Grade 10 and the 2007 English curriculum for Grades 11–12 remain in effect. All secondary English courses for Grades 10–12 will continue to be based on those documents. All references to Grade 9 that appear in &l;em&g;The Ontario Curriculum, Grades 9 and 10: English, 2007 &l;/em&g;and &l;em&g;The Ontario Curriculum, Grades 11 and 12: English, 2007&l;/em&g; have been superseded by &l;em&g;The Ontario Curriculum, Grade 9: English, 2023.&a;nbsp;&l;/em&g;&a;nbsp;&a;nbsp;&l;/li&g;\n&l;/ul&g;&q;},&q;note&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Note&q;,&q;value&q;:&q;&q;}