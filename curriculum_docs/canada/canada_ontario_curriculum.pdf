,&q;value&q;:[]},&q;mega_menu_flag&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Flag&q;,&q;value&q;:[]},&q;megamenu_pane_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Layout&q;,&q;value&q;:[]},&q;left_sub_menu_button&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Left Sub Menu Button&q;,&q;value&q;:[]},&q;curriculum_layout_linked_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum Layout Linked Item&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___link_to_parent_guide__copy__93db409&q;:{&q;system&q;:{&q;id&q;:&q;93db4092-f37c-44ec-8cfa-6a861204b422&q;,&q;name&q;:&q;Lang - FRA - Link to Parent Guide&q;,&q;codename&q;:&q;enl1w___frl1w___link_to_parent_guide__copy__93db409&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___navigation_item&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-05-25T18:21:58.3575115Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Language, Grades 1–8: a guide for parents&q;},&q;content_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Content Item&q;,&q;value&q;:[&q;lang___fra___parent_guide__ui_view_&q;]},&q;child_navigation_items&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Child Navigation Items&q;,&q;value&q;:[]},&q;include_menu_hierarchy&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Include menu hierarchy&q;,&q;value&q;:[]},&q;internal_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Internal link&q;,&q;value&q;:&q;/grade-9-math-guide&q;},&q;external_link&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External link&q;,&q;value&q;:&q;&q;},&q;asset&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Asset&q;,&q;value&q;:[]},&q;fragment&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Fragment&q;,&q;value&q;:&q;&q;},&q;is_quick_links&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Is quick links&q;,&q;value&q;:[]},&q;resource_site_link&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Resource Site link&q;,&q;value&q;:[]},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;Url Slug&q;,&q;value&q;:&q;language-grades-1-8-a-guide-for-parents&q;},&q;external_link_href&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;External Link Href&q;,&q;value&q;:&q;&q;},&q;target&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Target&q;,&q;value&q;:[]},&q;redirect_to_url&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Redirect To URL&q;,&q;value&q;:[]},&q;mega_menu_flag&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Flag&q;,&q;value&q;:[]},&q;megamenu_pane_layout&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Mega Menu Layout&q;,&q;value&q;:[]},&q;left_sub_menu_button&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Left Sub Menu Button&q;,&q;value&q;:[]},&q;curriculum_layout_linked_item&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Curriculum Layout Linked Item&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___about__copy_&q;:{&q;system&q;:{&q;id&q;:&q;a9fcc18a-2b29-4b22-9323-7a92acf1088b&q;,&q;name&q;:&q;ENL1W - FRL1W - Parent Guide - Introduction&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___about__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-14T17:33:37.6898373Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;introduction&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;Ontario is continuing its efforts to end the process of streaming students as they enter high school. Starting in September 2023, the new Grade 9 English course will be taught to all students. This means that there will no longer be applied or academic courses for Grade 9 English. This is called de-streaming. This change will provide all students with the same learning experience and help prepare students for a wide variety of career pathways. This course is compulsory for all students.&l;/p&g;\n&l;p&g;In addition, the new Grade 9 English course is part of Ontario’s plan to modernize the education curriculum to ensure all students have the foundational and transferable skills they need in a rapidly changing world.&a;nbsp;&a;nbsp;&l;/p&g;\n&l;p&g;Some key benefits include:&a;nbsp;&l;/p&g;\n&l;ul&g;\n  &l;li&g;having high expectations for all students&l;/li&g;\n  &l;li&g;providing students with a range of skills and interests as well as the opportunity to learn together&l;/li&g;\n  &l;li&g;increasing opportunities and helping to remove systemic barriers for Indigenous, Black and other racialized students, students who live in various socio-economic households, and students with differing abilities and special education needs&l;/li&g;\n  &l;li&g;keeping future options open for all students (for example, going to college, university or an apprenticeship)&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___about__copy__2503013&q;:{&q;system&q;:{&q;id&q;:&q;2503013d-be37-45d9-9f13-aabc3b291743&q;,&q;name&q;:&q;Lang - FRA - Parent Guide - About&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___about__copy__2503013&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-23T15:02:34.3688355Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;About the revised language curriculum&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;about&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/curriculum/elementary-language\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;&l;em&g;The Ontario Curriculum, Grades 1 to 8: Language, 2023&l;/em&g;&l;/a&g;&a;nbsp;outlines the knowledge and skills required for effective reading and writing, listening and speaking so students can succeed at school and beyond. The curriculum has been revised partly in response to the recommendations outlined in the Ontario Human Rights Commission’s Right to Read public inquiry report.&l;/p&g;\n&l;p&g;The 2023 curriculum now includes new areas of learning:&l;/p&g;\n&l;h4&g;&l;strong&g;A focus on foundational knowledge and skills&l;/strong&g;&l;/h4&g;\n&l;ul&g;\n  &l;li&g;Students develop foundational knowledge and skills in reading and writing, spelling, vocabulary, reading fluency and comprehension across all grades. Reading is taught using evidence-based methods to help students become capable readers and writers.&l;/li&g;\n  &l;li&g;For the youngest learners, knowledge and skills are taught in the areas of oral language and vocabulary, the relationship between sounds and letters of the alphabet, and the ability to read and write words with both speed and accuracy.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Transferable skills&l;/strong&g;&l;/h4&g;\n&l;ul&g;\n  &l;li&g;Students apply the transferable skills throughout learning in language and literacy across all grades to help them become engaged and responsible learners. These skills are defined as: critical thinking and problem solving; innovation, creativity and entrepreneurship; self-directed learning; collaboration; communication; global citizenship and sustainability; and digital literacy.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;&l;strong&g;Digital media literacy&l;/strong&g;&l;/h4&g;\n&l;ul&g;\n  &l;li&g;Students develop and apply digital media literacy knowledge and skills to support their learning, such as understanding how online media is used to communicate and influence audiences. They learn to navigate online environments, with appropriate permission, while managing their data, security and privacy. Students also learn how to use digital and media tools to evaluate information and demonstrate their learning.&l;/li&g;\n&l;/ul&g;\n&l;h4&g;Applications, connections and contributions&l;/h4&g;\n&l;ul&g;\n  &l;li&g;Students apply language and literacy skills in various contexts, and make connections to the contributions of a diversity of voices, experiences and perspectives, including those of First Nations, Métis and Inuit individuals, communities, groups and nations.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___about__copy__3b3e228&q;:{&q;system&q;:{&q;id&q;:&q;3b3e2280-8be3-4f32-b5fb-298cd0901bc7&q;,&q;name&q;:&q;ENL1W - FRL1W - Parent Guide - Student Learning&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___about__copy__3b3e228&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-19T14:30:55.6286581Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;What students will learn&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;students-learning&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{&q;5f1e4ea4-8266-449e-acee-1ce6b77f1652&q;:{&q;codename&q;:&q;lang___literary__or_stylistic__device&q;,&q;type&q;:&q;glossary_term&q;,&q;url_slug&q;:&q;&q;}},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;The Grade 9 English course will teach students foundational language and literacy concepts and skills to prepare them for success now and in the future. Throughout the course and its areas of learning, students learn to apply their understanding with increasing sophistication.&l;/p&g;\n&l;p&g;The course is organized in four distinct but interrelated areas, with language and literacy skills being taught and assessed throughout all areas of learning.&l;/p&g;\n&l;p&g;Here are some of the knowledge and skills that students are expected to learn.&l;/p&g;\n&l;h4&g;&l;strong&g;Literacy connections and applications&l;/strong&g;&a;nbsp;&l;/h4&g;\n&l;p&g;Students apply transferable skills when reading, listening, viewing, writing, and speaking in various cultural, social, and linguistic contexts. They&a;nbsp;learn to explain their rights and responsibilities when interacting online, with appropriate permission, and make decisions that contribute positively to the development of their digital identity, reputation, and online communities. They also&a;nbsp;demonstrate an understanding of the historical contexts, contributions, lived experiences, and perspectives of a diversity of individuals and communities, including First Nations, Métis, and Inuit cultures, by analyzing culturally responsive and relevant texts.&l;/p&g;\n&l;p&g;This learning is applied to learning related to the other three areas of the curriculum.&l;/p&g;\n&l;h4&g;&l;strong&g;Foundations of language&l;/strong&g;&a;nbsp;&l;/h4&g;\n&l;p&g;Students evaluate and use listening skills and strategies before, during, and after listening to understand information and analyze the purpose and audience for speaking in formal and informal contexts. They identify and use oral and non-verbal communication strategies, including expression, gestures, and body language, and use precise and descriptive word choice, syntax, and grammar to support audience comprehension. They read a variety of complex texts fluently and read aloud with expression. They use knowledge of the meanings of words to read and spell. They also use their knowledge and understanding of sentence types and forms, grammar, capitalization, and punctuation when reading and writing.&l;/p&g;\n&l;h4&g;&l;strong&g;Comprehension: Understanding and responding to texts&l;/strong&g;&a;nbsp;&l;/h4&g;\n&l;p&g;Students analyze and evaluate a variety of literary and informational texts,&a;nbsp;including cultural text forms, and explain how their characteristics help communicate meaning. They explore how visuals such as images and graphics help to create, communicate, and contribute to meaning. They analyze various elements of style and &l;a data-item-id=\&q;5f1e4ea4-8266-449e-acee-1ce6b77f1652\&q; href=\&q;\&q;&g;literary devices&l;/a&g; and explain how they are appropriate for the text form and genre. They apply comprehension strategies and critical thinking skills to confirm and deepen their understanding of information and ideas in texts, including diverse perspectives and cultural elements represented in texts, and draw conclusions. Finally, they assess the effectiveness of the critical thinking skills they used when analyzing and evaluating texts and set goals for improvement.&l;/p&g;\n&l;h4&g;&l;strong&g;Composition: Expressing ideas and creating texts&l;/strong&g;&a;nbsp;&l;/h4&g;\n&l;p&g;Students write fluently and use advanced word-processing skills to create texts. They generate and develop ideas about complex topics and synthesize information and content. They create complex texts of various forms and genres, establishing an identifiable voice and using varied language, elements of style, and tone. They revise the content and edit their work to improve accuracy and style and produce final texts, selecting a variety of suitable techniques and tools, including digital design and production tools. They publish and present their texts using various media and tools.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___how_course_develope&q;:{&q;system&q;:{&q;id&q;:&q;d187227f-cf58-46aa-b4dd-fc546b6c1a7f&q;,&q;name&q;:&q;ENL1W - FRL1W - Parent Guide - Related links&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___how_course_develope&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2024-11-18T18:58:25.3797403Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Related links&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;related-links&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/curriculum/secondary-english/courses/enl1w\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Grade 9 English course&a;nbsp;(2023)&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/transferable-skills/introduction\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Transferable skills&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___how_course_develope_403b791&q;:{&q;system&q;:{&q;id&q;:&q;403b7917-803d-409c-b0ea-50879929a67e&q;,&q;name&q;:&q;Lang - FRA - Parent Guide - How course developed&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___how_course_develope_403b791&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-06T13:34:21.7370036Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;How we developed the curriculum&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;development&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;To develop the revised elementary language curriculum, Ontario reviewed current research and best practices from leading jurisdictions.&l;/p&g;\n&l;p&g;Research highlighted the need for explicit instruction on early reading skills, modernized content on digital literacy and the inclusion of Indigenous perspectives.&l;/p&g;\n&l;p&g;The curriculum was also informed by feedback from education stakeholders and partners to ensure that it meets all the literacy learning requirements for supporting Ontario students.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___introduction__copy_&q;:{&q;system&q;:{&q;id&q;:&q;6405ce36-df61-4b63-9168-970024bb8bc2&q;,&q;name&q;:&q;Lang - FRA - Parent Guide - Introduction&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___introduction__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-06T12:32:21.8633105Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Introduction&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;introduction&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;We have updated the language curriculum for Grades 1 to 8. Teachers will start teaching the revised curriculum starting September 2023.&l;/p&g;\n&l;p&g;The revised elementary language curriculum is part of Ontario’s plan to modernize the education curriculum to ensure all students have the foundational and transferable skills they need in a rapidly changing world, with early interventions in reading critical to future success.&l;/p&g;\n&l;p&g;Ontario’s elementary language curriculum was last updated in 2006.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___related_links__copy&q;:{&q;system&q;:{&q;id&q;:&q;8e231c7f-a6a5-4207-9e1b-61d805db94c0&q;,&q;name&q;:&q;Lang - FRA - Parent Guide - Related links&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___related_links__copy&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-08-09T15:53:41.32995Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Related links&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;related-links&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;ul&g;\n  &l;li&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/curriculum/elementary-language\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Elementary Language Curriculum&a;nbsp;(2023)&l;/a&g;&l;/li&g;\n  &l;li&g;&l;a href=\&q;https://www.dcp.edu.gov.on.ca/en/transferable-skills/introduction\&q; data-new-window=\&q;true\&q; target=\&q;_blank\&q; rel=\&q;noopener noreferrer\&q;&g;Transferable skills&l;/a&g;&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___student_learning__c&q;:{&q;system&q;:{&q;id&q;:&q;64913316-6d57-4d21-96a0-697b62bca4f2&q;,&q;name&q;:&q;ENL1W - FRL1W - Parent Guide - Support Child learning&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___student_learning__c&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-20T17:45:38.1761991Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Support your child’s learning – tips to engage parents&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;tips&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{&q;5cde0df7-cf64-453d-85dd-69e3b44a8be5&q;:{&q;codename&q;:&q;parents___fn1&q;,&q;type&q;:&q;footnotes&q;,&q;url_slug&q;:&q;&q;}},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;a data-item-id=\&q;5cde0df7-cf64-453d-85dd-69e3b44a8be5\&q; href=\&q;\&q;&g;Parents&l;/a&g; and family can have a huge influence on their teen’s educational success and future career choices. By showing an interest in what your teen is learning and helping them make connections to everyday events at home, in the community and beyond, you can make an important contribution to their success.&l;/p&g;\n&l;p&g;Here are some ideas for how to support your teen’s learning and help them understand how what they are learning in Grade 9 English plays a role in everyday life and in their future:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Be curious and show an interest in what your teen is learning. Ask questions that will encourage your teen to share their thoughts and ideas and help them make connections with the world around them.&l;/li&g;\n  &l;li&g;Discuss news items and what is happening in your community. Help your teen evaluate what they see on social media and examine different perspectives.&l;/li&g;\n  &l;li&g;You are your teen’s role model, so share with your teen that you too are reading, writing, speaking and listening for your own purposes.&l;/li&g;\n  &l;li&g;Encourage your teen to enjoy a variety of media – stories, poems, graphic novels, song lyrics, magazines, comics, online content.&l;/li&g;\n  &l;li&g;Invite your teen to share their digital design and production skills to help you, your family or your community enhance a product, such as a community newsletter.&l;/li&g;\n  &l;li&g;Read some of the same books and materials as your teen, so you can talk about what you read and discuss your perceptions and insights.&l;/li&g;\n  &l;li&g;If it’s available to you, speak with your teen in another language. Languages are an important part of our identity. All forms of communication, including reading and writing in another language, build skills and knowledge. Children and teens transfer their knowledge from one language to another.&l;/li&g;\n  &l;li&g;Help your teen make connections between what they learn in school, their strengths and interests and the courses they choose to take.&l;/li&g;\n  &l;li&g;Explore career opportunities and highlight how language and literacy play a role in your own work. Help your teen look ahead and set education and career goals.&l;/li&g;\n  &l;li&g;Your teen’s teachers, guidance counsellor or other school staff can provide information about skills and experiences that will support your teen’s learning, future aspirations and course choices. If you have questions, contact a teacher or the school.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___support_child_learn&q;:{&q;system&q;:{&q;id&q;:&q;a11758d6-1aea-4c11-97f9-037108fa148a&q;,&q;name&q;:&q;ENL1W - FRL1W - Parent Guide - How course developed&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___support_child_learn&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-14T17:42:40.4089783Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;How the course was developed &q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;development&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;To develop the revised English Grade 9 course, Ontario reviewed current research and best practices from leading jurisdictions.&l;/p&g;\n&l;p&g;Research highlighted the need for explicit instruction on early reading skills, modernized content on digital literacy and the inclusion of Indigenous perspectives.&l;/p&g;\n&l;p&g;The course was also informed by feedback from education stakeholders and partners to ensure that it meets all the literacy learning requirements for supporting Ontario students.&l;/p&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parent_guide___support_child_learn_6a1d6b0&q;:{&q;system&q;:{&q;id&q;:&q;6a1d6b04-1b3b-4a5a-b9c9-0fd4f2cd1e7e&q;,&q;name&q;:&q;Lang - FRA - Parent Guide - Support Child learning&q;,&q;codename&q;:&q;enl1w___frl1w___parent_guide___support_child_learn_6a1d6b0&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___generic_content&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-15T04:35:44.0193693Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;image&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image&q;,&q;value&q;:[]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Support your child’s learning&q;},&q;url_slug&q;:{&q;type&q;:&q;url_slug&q;,&q;name&q;:&q;URL slug&q;,&q;value&q;:&q;tips&q;},&q;content&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Content&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;As your child’s first teacher, you are an important partner in your child’s education.&l;/p&g;\n&l;p&g;You can help your child make connections between what they learn at home and at school and everyday experiences at home and in the community. Talk about it and listen carefully! Children build capacity for reading and writing through talking and listening.&l;/p&g;\n&l;p&g;Here are some ways to share the joy and the importance of literacy with your child. You don’t need to use them all, and you may have many more ways to make reading, writing, speaking and listening more interesting to your child.&l;/p&g;\n&l;ul&g;\n  &l;li&g;Be curious and show an interest. Talk to your child about day-to-day situations and ask questions that will encourage them to share their thoughts and ideas (e.g., what if? how did you know?).&l;/li&g;\n  &l;li&g;If it’s available to you, speak to your child in another language. Languages are an important part of our identity. Reading and talking to your child in various languages helps them learn how languages work and are used. Children transfer their knowledge from one language to another.&l;/li&g;\n  &l;li&g;You are your child’s role model, so share with your child that you too are reading and writing for your own purposes.&l;/li&g;\n  &l;li&g;Share the joy of reading with your child every day – read and share stories aloud.&l;/li&g;\n  &l;li&g;Look for a variety of materials your child will enjoy reading – stories, poems, graphic novels, song lyrics, magazines, comics, online media.&l;/li&g;\n  &l;li&g;Encourage your child to choose books and materials themselves.&l;/li&g;\n  &l;li&g;Browse online together based on themes and topics that interest your child.&l;/li&g;\n  &l;li&g;Ask your child to talk about what they are reading. Leave notes. Encourage your child to write back.&l;/li&g;\n  &l;li&g;Suggest a scrapbook or e-book to record special times, a diary or daily reflection book.&l;/li&g;\n  &l;li&g;Stay informed about your child’s learning by staying in touch with their school and teachers. If you are unsure of your child’s progress, or how you can support your child’s literacy learning at home, ask your child’s teacher about skills and experiences required to support your child’s learning.&l;/li&g;\n&l;/ul&g;\n&l;p&g;Make it fun!&l;/p&g;\n&l;p&g;For younger children, here are some things you and your child might enjoy:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Look for words and phrases that are all around us – on cereal boxes, street signs, maps, posters and books.&l;/li&g;\n  &l;li&g;Explore public libraries – they have great resources and in-house programs.&l;/li&g;\n  &l;li&g;Play board games and card games (e.g., word bingo, memory and rhyming games).&l;/li&g;\n&l;/ul&g;\n&l;p&g;As your child gains competence and becomes a critical thinker, here are some things you and your older child might enjoy:&l;/p&g;\n&l;ul&g;\n  &l;li&g;Keep reading with your child. Read a variety of material – magazines, e-books, poems and comic books&l;/li&g;\n  &l;li&g;Tap into their interests and hobbies – children are more likely to explore what they are interested in.&l;/li&g;\n  &l;li&g;Read some of the same books and materials as your child, so you can talk about characters, stories and topics together.&l;/li&g;\n  &l;li&g;Find fun and meaningful opportunities for children to write, or for you to write together. Some examples: create greeting cards, shopping lists, party invitations, gratitude notes, posters, records of special events, and so on.&l;/li&g;\n&l;/ul&g;&q;},&q;abstract&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Abstract&q;,&q;value&q;:&q;&q;},&q;credit&q;:{&q;type&q;:&q;rich_text&q;,&q;name&q;:&q;Credit&q;,&q;images&q;:{},&q;links&q;:{},&q;modular_content&q;:[],&q;value&q;:&q;&l;p&g;&l;br&g;&l;/p&g;&q;},&q;parent&q;:{&q;type&q;:&q;modular_content&q;,&q;name&q;:&q;Parent&q;,&q;value&q;:[]},&q;ui_types&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;UI Types&q;,&q;taxonomy_group&q;:&q;ui_types&q;,&q;value&q;:[]},&q;alert_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Alert type&q;,&q;value&q;:[]},&q;dismissible&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Dismissible&q;,&q;value&q;:[]},&q;search_terms&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Search Terms&q;,&q;value&q;:&q;&q;},&q;site___transferable_skills&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Transferable Skills&q;,&q;taxonomy_group&q;:&q;site___transferable_skills&q;,&q;value&q;:[]},&q;container_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Container type&q;,&q;value&q;:[]},&q;callout_colour_override&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Callout background colour override&q;,&q;value&q;:[]}}},&q;enl1w___frl1w___parents_guides_banner__copy_&q;:{&q;system&q;:{&q;id&q;:&q;183a20e3-3379-43b7-86a7-52137716c96e&q;,&q;name&q;:&q;Lang - FRA - Parents Guides Banner&q;,&q;codename&q;:&q;enl1w___frl1w___parents_guides_banner__copy_&q;,&q;language&q;:&q;en-CA&q;,&q;type&q;:&q;ui___banner&q;,&q;collection&q;:&q;default&q;,&q;sitemap_locations&q;:[],&q;last_modified&q;:&q;2023-06-15T04:12:34.7714724Z&q;,&q;workflow&q;:&q;default&q;,&q;workflow_step&q;:&q;published&q;},&q;elements&q;:{&q;site___persona&q;:{&q;type&q;:&q;taxonomy&q;,&q;name&q;:&q;Site - Persona&q;,&q;taxonomy_group&q;:&q;site___persona&q;,&q;value&q;:[]},&q;banner_type&q;:{&q;type&q;:&q;multiple_choice&q;,&q;name&q;:&q;Banner Type&q;,&q;value&q;:[{&q;name&q;:&q;Regular&q;,&q;codename&q;:&q;regular&q;}]},&q;title&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Title&q;,&q;value&q;:&q;Language, Grades 1 to 8: a guide for parents&q;},&q;description&q;:{&q;type&q;:&q;text&q;,&q;name&q;:&q;Description&q;,&q;value&q;:&q;Learn about Ontario’s revised language curriculum for Grades 1 to 8. The curriculum was issued in the Spring of 2023 for implementation in September 2023.&q;},&q;image_for_desktop&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image for desktop&q;,&q;value&q;:[{&q;name&q;:&q;Elementary-Language-ENG.svg&q;,&q;description&q;:null,&q;type&q;:&q;image/svg+xml&q;,&q;size&q;:139856,&q;url&q;:&q;https://assets-us-01.kc-usercontent.com:443/fbd574c4-da36-0066-a0c5-849ffb2de96e/56ea831b-851d-4c71-91c1-472d6e89ae37/Elementary-Language-ENG.svg&q;}]},&q;image_for_tablet&q;:{&q;type&q;:&q;asset&q;,&q;name&q;:&q;Image for tablet&q;,&q;value&q;:[]},&q;image_for_mobile&q;:{&q;type&q;:&q;asset&q;,&q;